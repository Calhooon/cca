    check(keepvar_rc[0] == PATH_EXITS["kept"] and "kid" in keepvar_rc[1], "--clean --path refuses a .CCA-KEEP below the path, the marker's case ignored (%r)" % (keepvar_rc,))
    check(longs_rc[0] in (PATH_EXITS["shared"], PATH_EXITS["missing"]) and (longs_rc[0] == PATH_EXITS["shared"] or not os.path.isdir(os.path.join(ctd, "py-lane\u017f")))
