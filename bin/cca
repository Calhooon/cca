          "deploy prep: with the kept name planted to be cut from the backup's path at the first .bak., the copy lands outside its folder (%r)" % (kept_wrong,))
    # the relay commands run through a shell against a peer HOME with a space: the cca path is quoted once, in one place
    rhome = os.path.join(tmp, "relay home")
    os.makedirs(os.path.join(rhome, "peer dir", "bin"))
    with open(os.path.join(rhome, "peer dir", "bin", "cca"), "w") as f_:
        f_.write("#!/bin/sh\necho RAN \"$@\"\nexit 0\nDISK_CAPS_VERSION = %d\n" % DISK_CAPS_VERSION)
    os.chmod(os.path.join(rhome, "peer dir", "bin", "cca"), 0o755)
    rroster = {"hosts": {"peer-x": {"ssh": "peer-x"}, "me": {}}, "settings": {"peer_cca": "~/peer dir/bin/cca"}}

    def relay_run(argv, **k):       # ssh played by a local sh on the fixture home: the last word is the command text the peer's shell reads
        r_ = real_run_d(["sh", "-c", argv[-1]], capture_output=True, text=True, env=dict(os.environ, HOME=rhome))
        return subprocess.CompletedProcess(argv, r_.returncode, stdout=r_.stdout, stderr=r_.stderr)

    def relay_call(argv, **k):
        r_ = real_run_d(["sh", "-c", argv[-1]], capture_output=True, text=True, env=dict(os.environ, HOME=rhome))
        relayed.append((r_.returncode, r_.stdout))
        return r_.returncode

    def relays(extra=None):
        relayed.clear()
        errb_, outb_ = io.StringIO(), io.StringIO()
        with patch.dict(globals(), dict({"load_roster": lambda: rroster, "this_host": lambda r=None: "me"}, **(extra or {}))), patch.object(subprocess, "run", relay_run), \
                patch.object(subprocess, "call", relay_call), contextlib.redirect_stderr(errb_), contextlib.redirect_stdout(outb_):
            rc_d = cmd_disk(["--clean", "--host", "peer-x", "--path", "/x/targets/a"])
            rc_r = cmd_reading(["--host", "peer-x"])
        return rc_d, rc_r, list(relayed), errb_.getvalue()
    relayed = []
    relay_ok = relays()
    relay_unq = relays({"rq": unq})
    _caps_once = peer_caps
    relay_twice = relays({"peer_caps": lambda ssh_, cmd_, timeout=None: _caps_once(ssh_, rq(cmd_), timeout)})
    check(relay_ok[0] == 0 and relay_ok[1] == 0 and len(relay_ok[2]) == 2 and all("RAN" in x[1] for x in relay_ok[2]) and "disk --clean" in relay_ok[2][0][1] and "reading" in relay_ok[2][1][1]
          and relay_unq[0] != 0 and relay_unq[1] != 0 and relay_twice[0] == PATH_EXITS["peer"],
          "relay: the probe, the forwarded disk command and the reading command, run through a shell on a HOME with a space, reach the peer's cca; the path quoted twice, or not at all, is red (%r, %r, %r)" % (relay_ok, relay_unq[:2], relay_twice[:2]))
    # the forwarded --path reaches the peer byte for byte: a space, a $ and a ' in it survive the peer's shell
    odd_path = "/x/targets/a b$HOME'c"
    with open(os.path.join(rhome, "peer dir", "bin", "cca"), "w") as f_:
        f_.write("#!/bin/sh\nfor a in \"$@\"; do printf 'ARG[%%s]\\n' \"$a\"; done\nexit 0\nDISK_CAPS_VERSION = %d\n" % DISK_CAPS_VERSION)
    odd_got = []

    def odd_call(argv, **k):
        r_ = real_run_d(["sh", "-c", argv[-1]], capture_output=True, text=True, env=dict(os.environ, HOME=rhome))
        odd_got.append(r_.stdout)
        return r_.returncode
    with patch.dict(globals(), {"load_roster": lambda: rroster, "this_host": lambda r=None: "me"}), patch.object(subprocess, "run", relay_run), \
            patch.object(subprocess, "call", odd_call), contextlib.redirect_stderr(io.StringIO()), contextlib.redirect_stdout(io.StringIO()):
        odd_rc = cmd_disk(["--clean", "--host", "peer-x", "--path", odd_path])
    check(odd_rc == 0 and odd_got and ("ARG[%s]" % odd_path) in odd_got[0],
          "relay: a --path with a space, a $ and a ' reaches the peer byte for byte (the forwarded value is quoted) (%r, %r)" % (odd_rc, odd_got))
    check(nochmod_d[0] != 0 and nochmod_d[1] == old_state and nochmod_d[2] == [],
          "deploy: with the chmod guard turned off the new cca is not executable and the install fails and rolls back (the plant is red) (%r)" % (nochmod_d,))
    gone_p = os.path.join(tmp, "vanished")
