        state_ = [rd(f) for f in (d_cca, d_rules, d_acct)]
        return r_.returncode, r_.stderr, state_, sorted(x for x in os.listdir(os.path.join(ddest, "bin")) if ".new." in x)
    foreign = step_run(999)
    mine = step_run(deploy_who(4300))
