    sd = open_shim_dir()
    check(os.access(os.path.join(sd, "open"), os.X_OK) and "CCA_CHROME_PROFILE" in open(os.path.join(sd, "open")).read(), "the open shim is written and executable")
    # rule 23: builds and worktrees on the volume, the disk scan
    os.makedirs(os.path.join(rt, "one", "workers", "w", "src"))
    os.rename(os.path.join(rt, "one", "Cargo.toml"), os.path.join(rt, "one", "workers", "w", "Cargo.toml"))
    check(shared_target_dir(os.path.join(rt, "one"), "one") == os.path.join(WORKSPACE, "targets", "one-lanes"), "a crate three folders down still builds in the shared target dir")
    os.makedirs(os.path.join(rt, "none"))
    check(shared_target_dir(os.path.join(rt, "none"), "none") is None, "a repo with no Cargo.toml gets no target dir")
    vol = os.path.join(tmp, "vol"); os.makedirs(os.path.join(vol, "worktrees"))
    fh = os.path.join(tmp, "home"); os.makedirs(os.path.join(workspace(fh), "targets"))
    check(lane_worktree_path(os.path.join(rt, "one"), "w1", volume=os.path.join(tmp, "novol")) == os.path.join(rt, "one", ".claude", "worktrees", "w1"), "no volume: the worktree is under the repo")
    check(lane_worktree_path(os.path.join(rt, "one"), "w1", volume=vol) == os.path.join(vol, "worktrees", "one", "w1"), "a volume: the worktree is on it, under the repo's name")
