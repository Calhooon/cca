    check(all(x["id"] != "cap@x" for x in p["ranked"]), "a captain's account is never a lane's")
    sample_update("a@x", {"five": {"used": 20, "resets_at": t + 3600}, "week": {"used": 40, "resets_at": t + 2 * 86400}, "fable_week": {"used": 80, "resets_at": t + 2 * 86400}}, "test")
    sample_update("b@x", {"five": {"used": 50, "resets_at": t + 3600}, "week": {"used": 10, "resets_at": t + 5 * 86400}, "fable_week": {"used": 10, "resets_at": t + 5 * 86400}}, "test")
    p = pick(r, job_class="opus")
