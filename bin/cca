          "deploy: a prep the peer refused (another deploy holds the lock) runs no release; with that branch planted out a release is sent (%r, %r)" % (held_calls, held_calls_plant))
    # two deployers of one pid on two machines: the owner is host:pid, so neither the step, the undo nor the release takes the other's lock
    two_who = ("hostA:777", "hostB:777")

    def lock_for(who_):
        seed()
        os.makedirs(lockdir)
        open(os.path.join(lockdir, "owner"), "w").write(who_)
        open(os.path.join(lockdir, "since"), "w").write(str(int(time.time())))

    def run_sh(cmd_):
        return real_run_d(["sh", "-s"], input=cmd_, text=True, env=dict(os.environ, HOME=dhome), capture_output=True)
