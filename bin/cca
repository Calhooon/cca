#!/usr/bin/python3
"""cca: many Claude and Codex subscriptions, one pool. RULES.md is the design.

Everything here is a read of files Claude Code and Codex write themselves, or a
launch of one of them. No daemons. macOS system python (3.9).

State, all under ~/.cca:
  accounts.json      the roster: hosts, accounts (provider, hosts it is signed in on, role), projects, settings
  samples/<id>.json  the last reading of an account's limits, with its source and time
  leases/<id>/       who is on an account right now (one file per session, pid-checked)
  runs/<id>.json|log a lane's record and its stream
  captains/<p>.json  a project's captain: account, session, last exit
"""
import base64, datetime, getpass, glob, hashlib, json, os, platform, re, shlex, shutil, signal, subprocess, sys, tempfile, threading, time, urllib.error, urllib.request, uuid

HOME = os.path.expanduser("~")
CCA = os.environ.get("CCA_STATE") or os.path.join(HOME, ".cca")
ROSTER = os.path.join(CCA, "accounts.json")
LOGINS = os.path.join(CCA, "logins")
SAMPLES, LEASES, RUNS, CAPTAINS = (os.path.join(CCA, d) for d in ("samples", "leases", "runs", "captains"))
PROFILES = os.path.join(HOME, ".claude-profiles")
PRIMARY = os.path.join(HOME, ".claude")
KEYCHAIN_DB = os.path.join(HOME, "Library", "Keychains", "login.keychain-db")
CODEX_PROFILES = os.path.join(HOME, ".codex-profiles")
SHARED = ("CLAUDE.md", "agents", "commands", "history.jsonl", "ide", "plugins", "projects", "settings.json", "settings.local.json", "sessions")
MARKER = ".cca-account"
FABLE, OPUS, SONNET = "claude-fable-5-2", "claude-opus-5-5", "claude-sonnet-5-5"
CODEX_SOL, CODEX_ASTRA = "gpt-6.1-sol", "gpt-6-astra"
OPUS48 = "claude-opus-4-8"
NO_MAX = ("claude-fable-5-2",)       # the owner's word, 2026-11-09: "Max sucks for Fable 5.2, it should never be used"
ABL, ABL_VISION = "abliterated-model-large-v2", "abliterated-model"
ALIASES = {"fable": FABLE, "opus": OPUS, "sonnet": SONNET, "opus48": OPUS48, "sol": CODEX_SOL, "astra": CODEX_ASTRA, "codex": CODEX_SOL,
           "abl": ABL, "abl-vision": ABL_VISION}
ABL_ACCOUNT = "abliteration.ai"          # the gateway: prepaid credits, no pool account, no readings (their dashboard has the spend)
ABL_RATES = {ABL_VISION: (1.00, 0.10, 3.00), "abliterated-model-large": (3.00, 0.30, 5.00), ABL: (3.00, 0.30, 5.00)}   # $ per 1M: in, cached in, out (their page, 2026-10-05)


def abl_cost(model, usage):
    """What a gateway lane cost, from the usage Claude Code reports (its own dollar figure prices the model at the Opus tier and is wrong)."""
    rin, rcache, rout = ABL_RATES.get(model, (3.00, 0.30, 5.00))
    u = usage or {}
    return (u.get("input_tokens", 0) * rin + u.get("cache_read_input_tokens", 0) * rcache + u.get("cache_creation_input_tokens", 0) * rin
            + u.get("output_tokens", 0) * rout) / 1e6
FABLE_SHARE = 0.5                       # Fable may spend half the week, drawn from it (LIMITS.md)
CLASSIFIER_STOP = "stopped by a safety classifier"
LIMIT_TEXT = re.compile(r"hit your (session|weekly|usage|opus|sonnet|fable)? ?limit|usage limit reached|rate limit", re.I)
REPORT_SUFFIX = ("\n\nWhen you are done, end your reply with a report of at most 20 lines headed REPORT: "
                 "STATUS done|blocked|walled; the commit(s) you made (sha and subject), or none; what is unverified; what is next.")
HERE = os.path.dirname(os.path.realpath(__file__))
REPO = os.path.dirname(HERE)
WORKSPACE = os.path.expanduser(os.environ.get("CCA_WORKSPACE") or "") or os.path.dirname(REPO)      # the folder this repo sits in: its sibling repos, and the shared targets folder
PEER_CCA = os.path.join(HERE, "cca").replace(HOME, "~", 1) if HERE.startswith(HOME + os.sep) else os.path.join(HERE, "cca")      # this file as a peer's shell reads it: the same place under its own home
DEFAULT_SETTINGS = {"gate_timeout": 1800, "codex_model": "gpt-6.1-sol", "codex_effort": "max", "codex_service_tier": "ultrafast", "codex_week_floor": 1.0, "captain_min_fable": 15.0, "captain_effort": "xhigh", "code_split": 0.5, "hazard_model": "abl",
                    "margin_five": 10.0, "margin_week": 3.0, "margin_fable": 2.0, "stale_hours": 6.0, "read_age_launch": 600, "read_age_captain": 1800,
                    "peer_cca": PEER_CCA, "disk_floor_gb": 20, "lanes_floor_gb": 100,
                    "fleet_lock_hosts": ["box"], "fleet_lock_check": "~/.cca/fleet-lock.mjs"}


# ----------------------------------------------------------------------------- small helpers

def now():
    return time.time()


def expand(p):
    return os.path.expanduser(p or "")


def workspace(home=None):
    """WORKSPACE, or the folder of the same name under another home (the selftest's scratch homes)."""
    return WORKSPACE if home in (None, HOME) else os.path.join(home, os.path.basename(WORKSPACE))


def read_json(path, default=None):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return default


def write_json(path, obj):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = "%s.%d.tmp" % (path, os.getpid())
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(obj, f, indent=1, sort_keys=True)
    os.replace(tmp, path)


def pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except Exception:
        return False


def fmt_dur(sec):
    """1h05m, 3d 2h, 45m, 20s."""
    if sec is None:
        return "?"
    sec = max(0, int(sec))
    d, r = divmod(sec, 86400)
    h, r = divmod(r, 3600)
    m, s = divmod(r, 60)
    if d:
        return "%dd %dh" % (d, h)
    if h:
        return "%dh%02dm" % (h, m)
    if m:
        return "%dm" % m
    return "%ds" % s


def parse_iso(s):
    if not s:
        return None
    try:
        return datetime.datetime.fromisoformat(str(s).replace("Z", "+00:00")).timestamp()
    except Exception:
        return None


def this_host(roster=None):
    node = platform.node().split(".")[0]
    for alias, h in ((roster or load_roster()).get("hosts") or {}).items():
        if (h.get("node") or alias).lower() == node.lower():
            return alias
    return node.lower()


def claude_bin():
    for p in (os.path.join(HOME, ".local/bin/claude"), shutil.which("claude") or ""):
        if p and os.path.exists(p):
            return p
    return "claude"


def claude_version():
    """The installed Claude Code version, from the bundle the launcher links to."""
    v = os.path.basename(os.path.realpath(claude_bin()))
    return v if v[:1].isdigit() else ""


def codex_bin():
    return shutil.which("codex") or next(iter(sorted(glob.glob(os.path.join(HOME, ".nvm/versions/node/*/bin/codex")), reverse=True)), "codex")


def model_id(m):
    return ALIASES.get((m or "").lower(), m)


def is_fable(m):
    return "fable" in (m or "").lower()


def is_codex_model(m):
    return (m or "").lower().startswith("gpt")


def is_abl_model(m):
    return (m or "").lower().startswith("abliterated")


def abl_bin():
    return shutil.which("claude-abl") or os.path.join(HOME, ".local/bin/claude-abl")


# ----------------------------------------------------------------------------- the roster

def load_roster():
    r = read_json(ROSTER) or {}
    r.setdefault("hosts", {})
    r.setdefault("accounts", [])
    r.setdefault("projects", {})
    s = dict(DEFAULT_SETTINGS)
    s.update(r.get("settings") or {})
    r["settings"] = s
    return r


def save_roster(r):
    write_json(ROSTER, r)


def roster_push(roster=None):
    """The roster to every ssh peer, now (an owner's change; no loop). Best effort, a few seconds at most."""
    roster = roster or load_roster()
    if os.environ.get("CCA_STATE"):
        return
    for alias, h in roster["hosts"].items():
        if alias == this_host(roster) or not h.get("ssh"):
            continue
        try:
            subprocess.run(["scp", "-q", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", ROSTER, "%s:~/.cca/accounts.json" % h["ssh"]], capture_output=True, timeout=15)
        except Exception:
            pass
    samples_push(roster)


def samples_push(roster=None):
    """This machine's readings to every Claude-running ssh peer; the peer keeps each window that is newer than its own.
    The box cannot reach the Studio, so what the Studio knows travels with every roster push and every fleet pull."""
    roster = roster or load_roster()
    if os.environ.get("CCA_STATE"):
        return
    payload = json.dumps({"from": this_host(roster), "samples": [read_json(sample_path(a["id"])) or {} for a in roster["accounts"]]})
    for alias, h in roster["hosts"].items():
        if alias == this_host(roster) or not h.get("ssh") or h.get("no_claude"):
            continue
        try:
            subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", h["ssh"], rq(roster["settings"]["peer_cca"]) + " samples-merge"],
                           input=payload, capture_output=True, text=True, timeout=20)
        except Exception:
            pass


def cmd_samples_merge(args):
    """A peer's readings on stdin: every window newer than this machine's is taken, named for the peer."""
    data = json.load(sys.stdin)
    n = 0
    for s in data.get("samples") or []:
        if not s.get("id"):
            continue
        mine = read_json(sample_path(s["id"])) or {}
        newer = {k: w for k, w in s.items() if k in ("five", "week", "fable_five", "fable_week") and isinstance(w, dict)
                 and (w.get("at") or 0) > ((mine.get(k) or {}).get("at") or 0)}
        if newer:
            sample_update(s["id"], newer, "peer:" + (data.get("from") or "?"))
            n += 1
    print("%d account(s) updated" % n)
    return 0


def account(roster, ident):
    """An account by id, or by an unambiguous prefix/substring."""
    accts = roster["accounts"]
    for a in accts:
        if a["id"].lower() == (ident or "").lower():
            return a
    hits = [a for a in accts if (ident or "").lower() in a["id"].lower()]
    return hits[0] if len(hits) == 1 else None


def profile_dir(a):
    """The account's Claude Code folder: ~/.claude-profiles/<id> unless the roster names another, for every machine
    (a string) or per machine ({host: path}; a login drifted into another folder on one machine only)."""
    p = a.get("profile")
    if isinstance(p, dict):
        p = p.get(this_host())
    return p and expand(p) or os.path.join(PROFILES, a["id"])


def primary_email():
    return profile_email(PRIMARY)


def codex_home(a):
    return a.get("home") and expand(a["home"]) or os.path.join(CODEX_PROFILES, a["id"])


def role_of(a):
    return a.get("role") or "pool"


def on_host(a, host):
    return host in (a.get("hosts") or [])


def captain_of(a):
    r = role_of(a)
    return r[len("captain:"):] if r.startswith("captain:") else None


def project_root(roster, name):
    p = roster["projects"].get(name)
    return expand(p["root"]) if p else None


# ----------------------------------------------------------------------------- identity and logins

def claude_json_path(cfg_dir):
    """Claude Code's profile file: ~/.claude.json for the primary folder, <dir>/.claude.json for a custom one."""
    if os.path.realpath(cfg_dir) == os.path.realpath(PRIMARY):
        return os.path.join(HOME, ".claude.json")
    return os.path.join(cfg_dir, ".claude.json")


def profile_email(cfg_dir):
    raw = read_json(claude_json_path(cfg_dir)) or {}
    e = ((raw.get("oauthAccount") or {}).get("emailAddress") or "").lower()
    if e:
        return e
    try:
        return open(os.path.join(cfg_dir, MARKER)).read().strip().lower()
    except Exception:
        return ""


def keychain_service(cfg_dir):
    if os.path.realpath(cfg_dir) == os.path.realpath(PRIMARY):
        return "Claude Code-credentials"
    return "Claude Code-credentials-" + hashlib.sha256(os.path.realpath(cfg_dir).encode()).hexdigest()[:8]


def login_stamp(cfg_dir):
    """Where this directory's blob lives, as a stamp that moves when the blob does: the credentials file's inode, mtime
    and size (a peer, the selftest), else the login keychain's, one file securityd rewrites on any item change and never
    on a read. Empty when neither exists: then nothing is cached."""
    for p in (os.path.join(cfg_dir, ".credentials.json"), KEYCHAIN_DB):
        try:
            st = os.stat(p)
            return "%d:%d:%d" % (st.st_ino, st.st_mtime_ns, st.st_size)
        except Exception:
            continue
    return ""


_BLOBS = {}


def login_read(cfg_dir):
    """The credentials blob Claude Code keeps for this directory (file on a peer, Keychain here), or None. Read once per
    process per stamp: the keychain read is a `security` spawn that walks the whole keychain (2026-11-04: the menu bar
    app's panel made 85 of them every 12 s and kept securityd at a quarter of a core)."""
    key = (cfg_dir, login_stamp(cfg_dir))
    if key[1] and key in _BLOBS:
        return _BLOBS[key]
    blob = read_json(os.path.join(cfg_dir, ".credentials.json"))
    if not blob:
        try:
            out = subprocess.run(["security", "find-generic-password", "-s", keychain_service(cfg_dir), "-a", getpass.getuser(), "-w"],
                                 capture_output=True, text=True, timeout=4).stdout
            blob = json.loads(out) if out.strip() else None
        except Exception:
            blob = None
    if key[1]:
        _BLOBS[key] = blob
    return blob


def login_state(a, live=False):
    """What the blob says: "token" (an access token is there), "expired" (there, past its expiry: still a login, Claude
    Code renews it on its next start), "empty" (Claude Code emptied it), "none" (no blob, or no OAuth in it). Answered
    from the account's record under LOGINS (one file each: cca processes overlap, and a shared file
    rewritten whole loses entries) while the blob's stamp stands; the blob itself is read when the stamp moved, when the
    record names another folder, or when `live` asks: a launch asks live for the account it is about to use; the board,
    the status line and the picker read the record."""
    d = profile_dir(a)
    stamp = login_stamp(d)
    rec = os.path.join(LOGINS, a["id"] + ".json")
    r = read_json(rec) or {}
    if live or not stamp or r.get("stamp") != stamp or r.get("dir") != d:
        if live:
            _BLOBS.pop((d, stamp), None)
        o = (login_read(d) or {}).get("claudeAiOauth")
        r = {"stamp": stamp, "dir": d, "state": "none" if not isinstance(o, dict) else ("token" if o.get("accessToken") else "empty"),
             "expires_at": (o.get("expiresAt") if isinstance(o, dict) else None), "at": now()}
        if stamp:
            write_json(rec, r)
    if r["state"] == "token" and (r.get("expires_at") or 0) / 1000.0 < now() + 30:
        return "expired"
    return r["state"]


def login_ok(a, live=False):
    """A usable login: the profile is this account's and its blob carries an access token. Claude Code writes the blob
    back with its tokens emptied when a refresh is refused (2026-10-14, one account: "OAuth session expired
    and could not be refreshed"), so presence alone proves nothing."""
    if a.get("provider") == "codex":
        return os.path.exists(os.path.join(codex_home(a), "auth.json"))
    return profile_email(profile_dir(a)) == a["id"].lower() and login_state(a, live) in ("token", "expired")


def login_dead(a, live=False):
    """A login Claude Code has emptied: the blob is there, its tokens are not. Such an account takes no launch until
    `cca login` signs it in again; an account with no blob at all is not judged here (a peer keeps its logins in a file
    this machine cannot see)."""
    return a.get("provider") == "claude" and login_state(a, live) == "empty"


def make_profile(cfg_dir, email):
    """A launchable profile directory: the marker, the shared symlinks, a seeded .claude.json."""
    os.makedirs(cfg_dir, exist_ok=True)
    with open(os.path.join(cfg_dir, MARKER), "w") as f:
        f.write(email.lower() + "\n")
    for name in SHARED:
        src, dst = os.path.join(PRIMARY, name), os.path.join(cfg_dir, name)
        if os.path.exists(src) and not os.path.lexists(dst):
            os.symlink(os.path.relpath(os.path.realpath(src), os.path.realpath(cfg_dir)), dst)     # relative from where the link really sits
    p = claude_json_path(cfg_dir)
    if not (read_json(p) or {}).get("oauthAccount"):
        prim = read_json(os.path.join(HOME, ".claude.json")) or {}
        seed = read_json(p) or {}
        seed.update({"hasCompletedOnboarding": True, "autoUpdates": False, "mcpServers": prim.get("mcpServers", {})})
        write_json(p, seed)


def share_sessions(roster):
    """One session registry for every profile on this machine (2026-10-10). Claude Code lists peers by name from the
    `sessions/` folder of the config dir it runs in, so captains in different profiles could not message each other
    although their sockets share /tmp/cc-socks. Each profile's folder becomes a link to the primary's; its entries and
    keys move over; a live session keeps writing its entry through the link. Returns the number of profiles converted."""
    shared = os.path.join(PRIMARY, "sessions")
    os.makedirs(shared, mode=0o700, exist_ok=True)
    n = 0
    seen = set()
    for a in roster["accounts"]:
        if a.get("provider", "claude") != "claude" or not on_host(a, this_host(roster)):
            continue
        base = profile_dir(a)
        if base in seen or not os.path.isdir(base) or os.path.realpath(base) == os.path.realpath(PRIMARY):
            continue
        seen.add(base)
        d = os.path.join(base, "sessions")
        if os.path.islink(d):
            continue
        if os.path.isdir(d):
            for f in os.listdir(d):
                src, dst = os.path.join(d, f), os.path.join(shared, f)
                try:
                    if not os.path.exists(dst) or os.path.getmtime(src) > os.path.getmtime(dst):
                        os.replace(src, dst)
                    else:
                        os.remove(src)
                except Exception:
                    pass
            try:
                os.rmdir(d)
            except Exception:
                os.rename(d, d + ".unshared")
        try:
            os.symlink(os.path.relpath(os.path.realpath(shared), os.path.realpath(base)), d)
            n += 1
        except Exception:
            pass
    return n


# ----------------------------------------------------------------------------- samples: what is left

def sample_path(ident):
    return os.path.join(SAMPLES, ident + ".json")


def sample_update(ident, windows, source, extra=None):
    """Merge a reading into the account's sample. windows: {five|week|fable_five|fable_week: {used, resets_at}}."""
    s = read_json(sample_path(ident)) or {"id": ident}
    t = now()
    for k, w in windows.items():
        if w and w.get("used") is not None:
            s[k] = {"used": float(w["used"]), "resets_at": w.get("resets_at"), "at": w.get("at") or t}
    s["at"], s["source"] = t, source
    s.update(extra or {})
    write_json(sample_path(ident), s)
    return s


def windows_of_usage(u, at):
    """The windows of a usage page: five, week, fable_week (and fable_five when the page has it)."""
    out = {}
    if u.get("five_hour") and u["five_hour"].get("utilization") is not None:
        out["five"] = {"used": u["five_hour"]["utilization"], "resets_at": parse_iso(u["five_hour"].get("resets_at")), "at": at}
    if u.get("seven_day") and u["seven_day"].get("utilization") is not None:
        out["week"] = {"used": u["seven_day"]["utilization"], "resets_at": parse_iso(u["seven_day"].get("resets_at")), "at": at}
    for lim in u.get("limits") or []:
        if lim.get("kind") == "weekly_scoped" and "fable" in json.dumps(lim.get("scope") or {}).lower():
            out["fable_week"] = {"used": lim.get("percent"), "resets_at": parse_iso(lim.get("resets_at")), "at": at}
    ff = u.get("five_hour_fable") or {}
    if ff.get("utilization") is not None:
        out["fable_five"] = {"used": ff["utilization"], "resets_at": parse_iso(ff.get("resets_at")), "at": at}
    return out


def cache_windows(cfg_dir):
    """Claude Code's own cached usage page in the profile's .claude.json. Claude Code reads the page when an interactive
    session starts and keeps it for the session: a captain's Fable figure here is as old as its launch."""
    raw = read_json(claude_json_path(cfg_dir)) or {}
    c = raw.get("cachedUsageUtilization") or {}
    at = (c.get("fetchedAtMs") or 0) / 1000.0
    return windows_of_usage(c.get("utilization") or {}, at), at


USAGE_URL = "https://api.anthropic.com/api/oauth/usage"


def usage_read(a, timeout=15):
    """The account's usage page, read with its login's access token in place: the same GET Claude Code makes when a
    session starts, no token spent, nothing written to the login. Returns (windows, note). An expired access token is
    left alone (only Claude Code rotates a login): the note says so and a session renews it."""
    d = profile_dir(a)
    blob = login_read(d) or (login_read(PRIMARY) if primary_email() == a["id"].lower() else None)
    o = (blob or {}).get("claudeAiOauth") or {}
    if not o.get("accessToken"):
        return None, "no login"
    if (o.get("expiresAt") or 0) / 1000.0 < now() + 30:
        return None, "access token expired"
    req = urllib.request.Request(USAGE_URL, headers={"Authorization": "Bearer " + o["accessToken"], "anthropic-beta": "oauth-2025-04-20",
                                                     "Accept": "application/json", "User-Agent": "claude-code/" + (claude_version() or "0")})
    try:
        u = json.load(urllib.request.urlopen(req, timeout=timeout))
    except urllib.error.HTTPError as e:
        return None, "login refused (HTTP %s)" % e.code if e.code in (401, 403) else "HTTP %s" % e.code
    except Exception as e:
        return None, str(e)[:60]
    return windows_of_usage(u, now()), "ok"


CODEX_USAGE_URL = "https://chatgpt.com/backend-api/wham/usage"


def codex_usage_read(a, timeout=15):
    """A Codex home's usage page, read with its ChatGPT login's access token in place (the GET the Codex CLI makes
    for its own usage view; no token spent, nothing written). Returns (windows, note); an expired token is left to
    the Codex CLI, which renews it on its next run (codex_read_renewing gives it that run when the caller allows)."""
    auth = read_json(os.path.join(codex_home(a), "auth.json")) or {}
    tok = auth.get("tokens") or {}
    if not tok.get("access_token"):
        return None, "no login"
    try:
        seg = tok["access_token"].split(".")[1]
        exp = json.loads(base64.urlsafe_b64decode(seg + "=" * (-len(seg) % 4))).get("exp") or 0
    except Exception:
        exp = 0
    if exp and exp < now() + 30:
        return None, CODEX_EXPIRED
    req = urllib.request.Request(CODEX_USAGE_URL, headers={"Authorization": "Bearer " + tok["access_token"], "ChatGPT-Account-ID": tok.get("account_id") or "",
                                                           "originator": "codex_cli_rs", "User-Agent": "codex_cli_rs", "Accept": "application/json"})
    try:
        u = json.load(urllib.request.urlopen(req, timeout=timeout))
    except urllib.error.HTTPError as e:
        return None, "login refused (HTTP %s)" % e.code if e.code in (401, 403) else "HTTP %s" % e.code
    except Exception as e:
        return None, str(e)[:60]
    return windows_of_codex_usage(u, now()), "ok (%s)" % (u.get("email") or u.get("plan_type") or "")


def windows_of_codex_usage(u, at):
    """The windows of a Codex usage page: week (a 7-day window) and five (anything shorter)."""
    out = {}
    rl = u.get("rate_limit") or {}
    for slot in ("primary_window", "secondary_window"):
        w = rl.get(slot) or {}
        if w.get("used_percent") is None:
            continue
        secs = w.get("limit_window_seconds") or 0
        key = "week" if secs >= 86400 else "five"
        out[key] = {"used": float(w["used_percent"]), "resets_at": w.get("reset_at"), "at": at}
    return out


def login_renew(a):
    """A one-line headless session, so Claude Code itself renews the account's access token (and proves the login).
    Some 25k cached tokens on Sonnet; only cca refresh asks for it."""
    d = tempfile.mkdtemp(prefix="cca-refresh-")
    try:
        r = subprocess.run([claude_bin(), "-p", "Reply with one word: ok", "--model", model_id("sonnet"), "--output-format", "json", "--max-turns", "1"],
                           cwd=d, env=claude_env(a, "refresh"), stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=150)
        try:
            res = json.loads(r.stdout.strip().splitlines()[-1])
            return (not res.get("is_error"), "session ok" if not res.get("is_error") else str(res.get("result"))[:80])
        except Exception:
            return False, (r.stdout + r.stderr).strip().splitlines()[-1][:80] if (r.stdout + r.stderr).strip() else "no answer"
    except subprocess.TimeoutExpired:
        return False, "session timed out"
    finally:
        shutil.rmtree(d, ignore_errors=True)


CODEX_EXPIRED = "access token expired (a codex run renews it)"
CODEX_RENEW_GAP = 3600


def codex_renew_due(sample, note, t):
    """Whether an expired Codex token is renewed now: the read said expired and no renew ran in the last hour (a
    login the CLI cannot renew would otherwise cost an exec on every read)."""
    return note == CODEX_EXPIRED and (t - (sample.get("codex_renew_at") or 0)) > CODEX_RENEW_GAP


def codex_login_renew(roster, a):
    """A one-word codex exec in an empty folder, so the Codex CLI itself renews the home's access token (the refresh
    token rotates inside auth.json; only the CLI writes that file). Some 2k tokens at low effort. Nothing else runs
    a Codex home between lanes, and the picker sends no lane to an account whose last reading says full, so without
    this an expired token left a stale reading standing: on 2026-10-23 both Codex accounts showed 0% for two days
    while their weeks were whole."""
    d = tempfile.mkdtemp(prefix="cca-codex-renew-")
    try:
        r = subprocess.run([codex_bin(), "exec", "-m", roster["settings"]["codex_model"], "-c", 'model_reasoning_effort="low"', "--skip-git-repo-check",
                            "Reply with one word: ok"],
                           cwd=d, env=dict(os.environ, CODEX_HOME=codex_home(a), CCA_KIND="refresh", CCA_ACCOUNT=a["id"]),
                           stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=150)
        out = (r.stdout + r.stderr).strip()
        return r.returncode == 0, "token renewed by a codex exec" if r.returncode == 0 else (out.splitlines()[-1][:80] if out else "no answer")
    except subprocess.TimeoutExpired:
        return False, "codex exec timed out"
    finally:
        shutil.rmtree(d, ignore_errors=True)


def codex_read_renewing(roster, a, timeout=15, renew=True):
    """A Codex account's usage page; an expired token is renewed by codex_login_renew when due and allowed, and the
    page read again. Returns (windows, note, extra): extra carries codex_renew_at when a renew ran, for the sample."""
    s = read_json(sample_path(a["id"])) or {}
    w, note = codex_usage_read(a, timeout)
    extra = {}
    if w is None and renew and codex_renew_due(s, note, now()):
        extra["codex_renew_at"] = now()
        ok, rnote = codex_login_renew(roster, a)
        w, note = codex_usage_read(a, timeout) if ok else (None, rnote)
        if w is not None:
            note = note.replace("ok (", "ok (token renewed by a codex exec; ", 1)
    return w, note, extra


def refresh_account(a, renew=True, roster=None):
    """One account's windows from the usage page, renewing an expired token when allowed: a Claude login through a
    one-line session, a Codex home through a one-word exec."""
    if a.get("provider") == "codex":
        w, note, extra = codex_read_renewing(roster or load_roster(), a, renew=renew)
        if w is not None:
            sample_update(a["id"], w, "refresh", dict(extra, host=this_host()))
        elif extra:
            sample_update(a["id"], {}, (read_json(sample_path(a["id"])) or {}).get("source") or "refresh", extra)
        return w, note
    w, note = usage_read(a)
    if w is None and note == "access token expired" and renew:
        ok, rnote = login_renew(a)
        w, note = usage_read(a) if ok else (None, rnote)
        if w is not None:
            note = "ok (token renewed by a session)"
    if w is not None:
        sample_update(a["id"], w, "refresh", {"host": this_host()})
    return w, note


def needs_read(s, provider, max_age, t):
    """Whether the usage page is due for an account: its last read, or the newest figure it can refresh (the week and the
    Fable week; a live session's status line refreshes the same ones), is older than max_age, and no back-off runs. Due
    is never judged by a window the page does not carry: it has no 5-hour window (2026-11-04: judged by the oldest
    window, every idle account was due at every look, the board asked every 12 s and the page answered 429)."""
    keys = ("week",) if provider == "codex" else ("week", "fable_week")
    last = max([s.get("read_at") or 0] + [((s.get(k) or {}).get("at") or 0) for k in keys])
    return t - last > max_age and (s.get("read_backoff_until") or 0) <= t


def refresh_stale(roster, host, max_age, t=None, only=None, timeout=15):
    """Read on use: the usage page for the accounts on this host (the ids in `only`, else every one) whose reading is
    older than max_age. Never on a timer: a launch asks for its candidates, a captain's hook for its own account, the
    board for what it shows. A 429 backs that account off for an hour. No token is spent and nothing is written to a
    login, with one exception: a Codex home whose access token has expired gets a one-word exec (codex_login_renew, at
    most once an hour), since nothing else would renew it and the stale reading would stand."""
    t = t or now()
    todo = []
    for a in roster["accounts"]:
        if not on_host(a, host) or (only is not None and a["id"] not in only) or not login_ok(a):
            continue
        if a.get("provider", "claude") == "claude" and login_state(a) == "expired":      # only Claude Code renews it; the keychain moves when it does
            continue
        if needs_read(read_json(sample_path(a["id"])) or {}, a.get("provider", "claude"), max_age, t):
            todo.append(a)

    def one(a):
        s = read_json(sample_path(a["id"])) or {"id": a["id"]}
        s["read_at"] = t                                  # the claim: a cca that looks meanwhile sees the read as made and leaves the page alone
        write_json(sample_path(a["id"]), s)
        if a.get("provider") == "codex":
            w, note, extra = codex_read_renewing(roster, a, timeout)
        else:
            w, note, extra = usage_read(a, timeout) + ({},)
        extra.update({"read_at": t, "read_note": note})
        if note == "HTTP 429" or (note or "").startswith("login refused"):      # asked too often, or a token only Claude Code can renew: an hour off
            extra["read_backoff_until"] = t + 3600
        sample_update(a["id"], w or {}, "refresh" if w else s.get("source") or "refresh", extra)
    threads = [threading.Thread(target=one, args=(a,)) for a in todo]
    for th in threads:
        th.start()
    for th in threads:
        th.join()
    return [a["id"] for a in todo]


def codex_windows(home):
    """The last token_count event's rate_limits in the newest rollout of a Codex home."""
    files = glob.glob(os.path.join(home, "sessions", "*", "*", "*", "rollout-*.jsonl"))
    if not files:
        return {}, None
    newest = max(files, key=os.path.getmtime)
    last = None
    try:
        with open(newest, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - (1 << 20)))
            for line in f.read().decode("utf-8", "replace").split("\n"):
                if '"token_count"' not in line or '"rate_limits"' not in line:
                    continue
                try:
                    e = json.loads(line)
                except Exception:
                    continue
                rl = ((e.get("payload") or {}).get("rate_limits") or {})
                if rl:
                    last = (parse_iso(e.get("timestamp")) or os.path.getmtime(newest), rl)
    except Exception:
        return {}, None
    if not last:
        return {}, None
    at, rl = last
    out = {}
    for slot in ("primary", "secondary"):
        w = rl.get(slot) or {}
        if w.get("used_percent") is None:
            continue
        mins = w.get("window_minutes") or 0
        key = "week" if mins >= 1440 else "five"
        out[key] = {"used": w["used_percent"], "resets_at": w.get("resets_at"), "at": at}
    return out, at


def left_of(a, roster, t=None):
    """What is left on an account, from its sample (and, for Claude, the profile cache): never rolled forward,
    except that a window whose reset has passed is empty by definition (Claude Code drops it then)."""
    t = t or now()
    st = roster["settings"]
    s = read_json(sample_path(a["id"])) or {}
    if a.get("provider") == "claude" and on_host(a, this_host(roster)):
        dirs = [profile_dir(a)] + ([PRIMARY] if primary_email() == a["id"].lower() else [])
        for d in dirs:
            cw, cat = cache_windows(d)
            for k, w in cw.items():
                if w.get("used") is not None and (not s.get(k) or (w.get("at") or 0) > (s[k].get("at") or 0)):
                    s[k] = w
    elif a.get("provider") == "codex" and on_host(a, this_host(roster)) and (t - (s.get("at") or 0)) > 300:
        cw, cat = codex_windows(codex_home(a))
        for k, w in cw.items():
            if not s.get(k) or (w.get("at") or 0) > (s[k].get("at") or 0):
                s[k] = w
    out = {"id": a["id"], "provider": a.get("provider", "claude"), "hosts": a.get("hosts") or [], "host": this_host(roster), "role": role_of(a), "raw": s}
    ages = []
    for k in ("five", "week", "fable_five", "fable_week"):
        w = s.get(k)
        if not w or w.get("used") is None:
            out[k] = None
            continue
        used, reset, age = float(w["used"]), w.get("resets_at"), t - (w.get("at") or 0)
        assumed = bool(reset and reset < t)      # the window has reset since this reading: full by definition, but unseen since
        if assumed:
            used = 0.0
            if k in ("week", "fable_week"):      # a week resets at a fixed time per account: the next one is whole weeks on
                reset += 7 * 86400 * (int((t - reset) // (7 * 86400)) + 1)
            else:
                reset = None                      # a 5-hour window rolls from first use; unknown until seen
        ages.append(age)
        out[k] = {"left": max(0.0, 100.0 - used), "resets_in": (reset - t) if reset else None, "age": age, "assumed": assumed}
    out["age"] = max(ages) if ages else None
    out["assumed"] = any((out[k] or {}).get("assumed") for k in ("five", "week", "fable_week"))
    out["stale"] = out["age"] is None or out["age"] > st["stale_hours"] * 3600 or out["assumed"]
    week_left = out["week"]["left"] if out["week"] else None
    if out["provider"] == "claude":
        # points: a week is 100; Fable's half is 50 of them, drawn from the same 100
        if week_left is None:
            out["fable_pts"] = out["nonfable_pts"] = None
        else:
            fable_pts = (out["fable_week"]["left"] if out["fable_week"] else 100.0) * FABLE_SHARE
            out["fable_pts"] = min(fable_pts, week_left)
            out["nonfable_pts"] = max(0.0, week_left - out["fable_pts"])
    out["leases"] = leases_of(a["id"])
    return out


# ----------------------------------------------------------------------------- leases: who is on it

def lease_write(ident, key, rec):
    rec = dict(rec, at=now())
    path = os.path.join(LEASES, ident, key + ".json")
    fresh = not os.path.exists(path)
    write_json(path, rec)
    if fresh and rec.get("session_id"):
        session_note(rec["session_id"], ident, rec.get("kind"), rec.get("project"), rec.get("model"))


def session_note(session_id, ident, kind=None, project=None, model=None):
    """One line per session (and per account it moved to): the analytics file tokens under it."""
    try:
        with open(os.path.join(CCA, "sessions.jsonl"), "a", encoding="utf-8") as f:
            f.write(json.dumps({"sid": session_id, "account": ident, "kind": kind, "project": project, "model": model, "host": this_host(), "at": now()}) + "\n")
    except Exception:
        pass


def session_accounts():
    """session id -> account, from this tool's notes and the old tool's records (read only): its registry, and its analytics
    cache's per-transcript account boundaries (the account a session ran on last; a session that switched is filed whole there)."""
    out = {}
    old = read_json(os.path.join(HOME, ".claude-accounts", "analytics-cache.json")) or {}
    for path, fs in (old.get("files") or {}).items():
        bnd = fs.get("bnd") or []
        if bnd and bnd[-1][1]:
            out[os.path.basename(path)[:-6]] = bnd[-1][1].lower()
    for recs in (old.get("sessions") or {}).values():
        for r in recs or []:
            if r.get("session_id") and r.get("email"):
                out[r["session_id"]] = r["email"].lower()
    for p in glob.glob(os.path.join(HOME, ".claude-usage", "*", "sessions", "*.json")):
        r = read_json(p) or {}
        if r.get("session_id") and r.get("email"):
            out[r["session_id"]] = r["email"].lower()
    try:
        for line in open(os.path.join(CCA, "sessions.jsonl"), encoding="utf-8"):
            try:
                r = json.loads(line)
                out[r["sid"]] = r["account"]
            except Exception:
                pass
    except Exception:
        pass
    return out


def lease_drop(ident, key):
    try:
        os.remove(os.path.join(LEASES, ident, key + ".json"))
    except Exception:
        pass


def leases_of(ident):
    out = []
    for p in glob.glob(os.path.join(LEASES, ident, "*.json")):
        r = read_json(p) or {}
        if r.get("host") not in (None, this_host()) or pid_alive(r.get("pid")):
            out.append(r)
        else:
            try:
                os.remove(p)
            except Exception:
                pass
    return out


# ----------------------------------------------------------------------------- the picker (a pure function over the files)

def pick(roster, job_class=None, model=None, provider=None, hours=1.0, host=None, exclude=(), want=None, t=None, min_left=None, read_age=None):
    """The account, provider and model for a launch. Returns {account, provider, model, why, ranked} or {error}."""
    t = t or now()
    st = roster["settings"]
    host = host or this_host(roster)
    model = model_id(model)
    if want:
        a = account(roster, want)
        if not a:
            return {"error": "no account %r" % want}
        prov = a.get("provider", "claude")
        return {"account": a["id"], "provider": prov, "model": model if (model and is_codex_model(model) == (prov == "codex")) else (st["codex_model"] if prov == "codex" else OPUS),
                "why": "named", "ranked": []}
    explicit = bool(model)
    if provider == "abl" or is_abl_model(model):
        return {"account": ABL_ACCOUNT, "provider": "abl", "model": model if is_abl_model(model) else ABL,
                "why": "the abliteration.ai gateway (prepaid credits, no pool account, text only)", "ranked": []}
    if not provider:
        if model:
            provider = "codex" if is_codex_model(model) else "claude"
        elif job_class == "code":
            provider = "codex" if code_lane_goes_to_codex(st) else "claude"
        else:
            provider = "claude"
    if provider == "claude" and not model:
        model = OPUS            # rule 26: Opus on the week that expires soonest, unless a Fable half expires within a day (the offer below); no class defaults to Fable
    if provider == "codex" and not is_codex_model(model):
        model = st["codex_model"]
    if provider == "claude" and not explicit and not is_fable(model) and host == this_host(roster):
        offer = expiring_fable(roster, host, exclude, t)      # rule 26: a Fable half that expires within a day goes to any lane without a named model, soonest first
        if offer:
            return offer
    logins = {} if host == this_host(roster) else ((read_json(FLEET_STAMP) or {}).get("logins") or {}).get(host) or {}     # a peer's, from its status rows
    dead = {a["id"] for a in roster["accounts"] if a.get("provider", "claude") == provider and on_host(a, host) and role_of(a) == "pool"
            and a["id"] not in exclude and not (login_ok(a) if host == this_host(roster) else logins.get(a["id"], True))}
    rows = [left_of(a, roster, t) for a in roster["accounts"]
            if a.get("provider", "claude") == provider and on_host(a, host) and role_of(a) == "pool" and a["id"] not in exclude and a["id"] not in dead]
    if host == this_host(roster) and provider in ("claude", "codex") and any(r["assumed"] or r["age"] is None or r["age"] > st["read_age_launch"] for r in rows):
        if refresh_stale(roster, host, read_age or st["read_age_launch"], t, only=[r["id"] for r in rows]):      # read on use: the candidates, no token spent
            rows = [left_of(a, roster, t) for a in roster["accounts"]
                    if a.get("provider", "claude") == provider and on_host(a, host) and role_of(a) == "pool" and a["id"] not in exclude and a["id"] not in dead]
    if host == this_host(roster) and any(r["assumed"] or (r["age"] or 1e9) > 1800 for r in rows):
        fleet_pull(roster, max_age=300)      # another machine may have spent what this one believes is full
        rows = [left_of(account(roster, r["id"]), roster, t) for r in rows]
    ranked = []
    for r in rows:
        why = []
        if r["five"] and r["five"]["left"] <= st["margin_five"]:
            why.append("5h %.0f%% left" % r["five"]["left"])
        unread = False
        if provider == "codex":
            key = r["week"]["left"] if r["week"] else None
            if key is None:
                unread = True
            elif key <= st["codex_week_floor"]:
                why.append("week %.0f%% at the floor" % key)
        elif is_fable(model):
            key = r["fable_pts"]
            if key is None:
                unread = True
            elif key <= st["margin_fable"]:
                why.append("Fable %.0f pts left" % key)
            if r["fable_five"] and r["fable_five"]["left"] <= 0:
                why.append("Fable 5h at the wall")
        else:
            key = r["nonfable_pts"]
            if key is None:
                unread = True
            elif key <= st["margin_week"]:
                why.append("%.0f pts left after the Fable half" % key)
        if unread and min_left is not None:
            why.append("no reading yet; a captain needs a known figure")
        if min_left is not None and key is not None and key < min_left:
            why.append("%.0f left, under the floor of %.0f" % (key, min_left))
        resets_in = r["week"]["resets_in"] if r["week"] and r["week"].get("resets_in") is not None else None
        score = (key or 0) - 5.0 * len(r["leases"]) - (10.0 if r["assumed"] else 0)      # spread lanes; a known figure ahead of an assumed one
        if is_fable(model):                 # Fable: what is at risk, points per hour to the reset (the penalties scaled with it)
            score = score / max(1.0, resets_in / 3600) if resets_in is not None else 0.0      # unknown reset: no measured risk
        bucket = int(resets_in // (6 * 3600)) if resets_in is not None else 99          # the week that expires soonest is spent first (6-hour steps)
        if unread:
            bucket, score = 100, -1.0                                                     # no reading yet: last in the order; its first lane produces one
        ranked.append({"id": r["id"], "score": score if is_fable(model) else round(score, 1), "left": key, "ok": not why, "why": ", ".join(why) or ("no reading yet" if unread else ""),
                       "stale": r["stale"], "assumed": r["assumed"], "leases": len(r["leases"]), "resets_in": resets_in, "bucket": bucket, "unread": unread})
    ranked += [{"id": i, "score": -1.0, "left": None, "ok": False, "why": "no login on %s (cca login %s)" % (host, i), "stale": True, "assumed": False,
                "leases": 0, "resets_in": None, "bucket": 101, "unread": True} for i in sorted(dead)]
    if is_fable(model):
        ranked.sort(key=lambda x: (not x["ok"], x["unread"], -x["score"], x["bucket"]))
    else:
        ranked.sort(key=lambda x: (not x["ok"], x["bucket"], -x["score"]))
    good = [x for x in ranked if x["ok"]]
    if not good:
        if provider == "codex" and job_class == "code":
            alt = pick(roster, job_class="opus", provider="claude", hours=hours, host=host, exclude=exclude, t=t, read_age=read_age)
            if "account" in alt:
                alt["why"] = "codex at its floor; " + alt["why"]
                return alt
        soonest = soonest_reset(roster, provider, host, t)
        return {"error": "no %s account on %s has room for %s (%s)%s" % (provider, host, model or job_class or "a launch",
                "; ".join("%s: %s" % (x["id"], x["why"]) for x in ranked) or "no accounts",
                "; soonest reset in %s" % fmt_dur(soonest - t) if soonest else ""), "ranked": ranked, "resets_at": soonest}
    best = good[0]
    return {"account": best["id"], "provider": provider, "model": model,
            "why": ("%s: no reading yet; this lane produces one" % best["id"]) if best.get("unread") else
                   "%s: week resets in %s, %s left%s" % (best["id"], fmt_dur(best["resets_in"]) if best["resets_in"] is not None else "?",
                                                      "%.0f" % best["left"] if best["left"] is not None else "?",
                                                      " [assumed full since its reset; unseen since]" if best["assumed"] else " [stale reading]" if best["stale"] else ""),
            "ranked": ranked}


def code_lane_goes_to_codex(st):
    """The code split: of the code lanes fired here in the last day, keep Codex's share at the setting (0.5 = half and half)."""
    share, since = float(st.get("code_split", 0.5)), now() - 86400
    recent = [m for m in run_metas() if m.get("class") == "code" and (m.get("started") or 0) > since and m.get("provider") in ("codex", "claude")]
    if share >= 1.0 or not recent:
        return share > 0
    codex = sum(1 for m in recent if m["provider"] == "codex")
    return (codex / len(recent)) < share


def expiring_fable(roster, host, exclude, t):
    """The pool account whose week expires soonest among those whose Fable half expires within a day (rule 26, the
    owner's word of 2026-10-26 and again 2026-11-09; until then review, design and proof were offered two days out)."""
    st = roster["settings"]
    offer_window = 24 * 3600
    best = None
    for a in roster["accounts"]:
        if a.get("provider", "claude") != "claude" or not on_host(a, host) or role_of(a) != "pool" or a["id"] in exclude or not login_ok(a):
            continue
        r = left_of(a, roster, t)
        w = r.get("week")
        if not w or w.get("resets_in") is None or w["resets_in"] > offer_window or (r.get("fable_pts") or 0) < st["margin_fable"] + 3:
            continue
        if r["five"] and r["five"]["left"] <= st["margin_five"]:
            continue
        if r["fable_five"] and r["fable_five"]["left"] <= 0:
            continue
        if best is None or w["resets_in"] < best[1]:
            best = (r, w["resets_in"])
    if not best:
        return None
    r, resets_in = best
    return {"account": r["id"], "provider": "claude", "model": FABLE, "ranked": [],
            "why": "%s: its Fable half (%.0f pts) expires in %s; spent before it is lost (rule 26)" % (r["id"], r["fable_pts"], fmt_dur(resets_in))}


def soonest_reset(roster, provider, host, t):
    soon = None
    for a in roster["accounts"]:
        if a.get("provider", "claude") != provider or not on_host(a, host):
            continue
        s = read_json(sample_path(a["id"])) or {}
        for k in ("five", "week", "fable_week"):
            r = (s.get(k) or {}).get("resets_at")
            if r and r > t and (soon is None or r < soon):
                soon = r
    return soon


# ----------------------------------------------------------------------------- the statusline (the sensor)

def cmd_statusline(args):
    try:
        data = json.load(sys.stdin)
    except Exception:
        print("cca")
        return 0
    try:
        roster = load_roster()
        cfg_dir = expand(os.environ.get("CLAUDE_CONFIG_DIR") or PRIMARY)
        email = profile_email(cfg_dir) or "?"      # the primary folder's profile lives at ~/.claude.json (claude_json_path)
        rl = data.get("rate_limits") or {}
        windows = {}
        for key, w in rl.items():
            if not isinstance(w, dict) or w.get("used_percentage") is None:
                continue
            k = "five" if key == "five_hour" else "week" if key == "seven_day" else ("fable_five" if "five" in key else "fable_week") if "fable" in key else None
            if k:
                windows[k] = {"used": w["used_percentage"], "resets_at": w.get("resets_at")}
        model = (data.get("model") or {}).get("id") or ""
        sid = data.get("session_id") or ""
        if email != "?":
            sample_update(email, windows, "statusline", {"model": model, "session_id": sid, "host": this_host(roster)})
            spare = False
            try:
                spare = "bg-spare" in subprocess.run(["ps", "-o", "command=", "-p", str(os.getppid())], capture_output=True, text=True, timeout=2).stdout
            except Exception:
                pass
            if sid and not spare:
                lease_write(email, sid, {"session_id": sid, "pid": os.getppid(), "kind": os.environ.get("CCA_KIND") or "own",
                                         "project": os.environ.get("CCA_PROJECT"), "model": model, "cwd": data.get("cwd"), "host": this_host(roster)})
        a = account(roster, email) or {"id": email, "provider": "claude", "host": this_host(roster)}
        L = left_of(a, roster)
        kind, proj = os.environ.get("CCA_KIND") or "", os.environ.get("CCA_PROJECT") or ""
        if kind == "captain" and proj:                 # this session's own project; the account may carry another captain (doubled up)
            who = "captain " + proj + ("" if captain_of(a) in (None, "", proj) else " (on %s's account)" % captain_of(a))
        elif kind == "lane" and proj:
            who = "lane " + proj
        else:
            who = (captain_of(a) and "captain " + captain_of(a)) or kind
        parts = [email, who, (data.get("model") or {}).get("display_name") or model]
        for k, label in (("five", "5h"), ("week", "wk"), ("fable_week", "F")):
            w = L.get(k)
            if w:
                parts.append("%s %s%.0f%%%s" % (label, "≈" if w.get("assumed") else "", w["left"], ("↻" + fmt_dur(w["resets_in"])) if w["resets_in"] else ""))
        ctx = (data.get("context_window") or {}).get("used_percentage")
        if ctx is not None:
            parts.append("ctx %.0f%%" % ctx)
        print(" · ".join(p for p in parts if p))
    except Exception as e:
        print("cca: %s" % e)
    return 0


# ----------------------------------------------------------------------------- status and pick

def status_rows(roster, t=None):
    return [left_of(a, roster, t) for a in roster["accounts"]]


FLEET_STAMP = os.path.join(CCA, "fleet-pull.json")


def fleet_pull(roster, max_age=0):
    """The peers' newer readings into this machine's samples (ssh, a few seconds). Returns {account: [the peers' leases]}.
    With max_age, a pull younger than that is reused: a pick asks once per five minutes, the board once per status --fleet."""
    st = read_json(FLEET_STAMP) or {}
    if max_age and now() - (st.get("at") or 0) < max_age:
        return st.get("leases") or {}
    peer_leases, disks, logins = {}, {}, {}
    for alias, h in roster["hosts"].items():
        if alias == this_host(roster) or not h.get("ssh"):
            continue
        try:
            out = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=6", h["ssh"], rq(roster["settings"]["peer_cca"]) + " status --json --local"],
                                 capture_output=True, text=True, timeout=20).stdout
            for r in json.loads(out):
                if r.get("disk"):
                    disks[alias] = r["disk"]
                if r.get("login_ok") is not None:
                    logins.setdefault(alias, {})[r["id"]] = r["login_ok"]
                raw = r.get("raw") or {}
                newer = {k: w for k, w in raw.items() if k in ("five", "week", "fable_five", "fable_week") and isinstance(w, dict)
                         and (w.get("at") or 0) > ((read_json(sample_path(r["id"])) or {}).get(k) or {}).get("at", 0)}
                if newer:
                    sample_update(r["id"], newer, "peer:" + alias)
                for l in r.get("leases") or []:
                    l["host"] = alias
                peer_leases.setdefault(r["id"], []).extend(r.get("leases") or [])
        except Exception as e:
            print("(%s unreachable: %s)" % (alias, str(e)[:60]), file=sys.stderr)
    write_json(FLEET_STAMP, {"at": now(), "leases": peer_leases, "disks": disks, "logins": logins})
    samples_push(roster)
    return peer_leases


def cmd_status(args):
    roster = load_roster()
    t = now()
    rows = status_rows(roster, t)
    if "--fleet" in args:
        peer_leases = fleet_pull(roster)
        rows = status_rows(roster, t)
        for r in rows:
            r["leases"] = r["leases"] + peer_leases.get(r["id"], [])
    disks = [machine_disk(roster)] + (fleet_disks(roster) if "--fleet" in args else [])
    if "--json" in args:
        for r in rows:
            r["disk"] = disks[0]            # this machine's line, on every row: a peer's fleet pull reads it from the list it already parses
            a = account(roster, r["id"])
            r["login_ok"] = login_ok(a) if on_host(a, this_host(roster)) else None      # a peer's picker skips an account not signed in here
        print(json.dumps(rows, indent=1, default=str))
        return 0
    def cell(w, pts=None):
        if w is None:
            return "-"
        return "%s%3.0f%%%s" % ("≈" if w.get("assumed") else " ", w["left"], (" ↻" + fmt_dur(w["resets_in"])) if w.get("resets_in") else "")
    print("%-28s %-6s %-16s %-20s %-16s %-16s %-10s %-8s %s" % ("account", "prov", "signed in on", "role", "5h window", "week (expires)", "Fable", "age", "on it"))
    for r in rows:
        on = ", ".join(sorted(set((l.get("kind") or "?") + ("@" + l["project"] if l.get("project") else "") + ("/" + l["host"] if l.get("host") not in (None, this_host(roster)) else "")
                              for l in r.get("leases") or []))) or ""
        fable = ("%s%3.0f pts" % ("≈" if r["assumed"] else " ", r["fable_pts"])) if r.get("fable_pts") is not None else "-"
        print("%-28s %-6s %-16s %-20s %-16s %-16s %-10s %-8s %s" % (r["id"][:28], r["provider"], ",".join(r["hosts"])[:16], r["role"][:20],
              cell(r["five"]), cell(r["week"]), fable, (fmt_dur(r["age"]) if r["age"] is not None else "none") + ("!" if r["stale"] else ""), on))
    soon = [r for r in rows if r.get("week") and r["week"].get("resets_in") is not None and r["week"]["resets_in"] < 86400
            and (r["week"]["left"] >= 10 or (r.get("fable_pts") or 0) >= 5)]
    for head, some in (("expiring within a day (spent first by the picker)", [r for r in soon if r["role"] == "pool"]),
                       ("expiring within a day on a captain's own account (the picker leaves it: lanes reach it only by --account)", [r for r in soon if r["role"] != "pool"])):
        if some:
            print("\n%s: " % head + "; ".join(
                "%s %s%.0f%% of the week%s in %s" % (r["id"], "≈" if r["assumed"] else "", r["week"]["left"],
                                                     (" (Fable %.0f pts)" % r["fable_pts"]) if r.get("fable_pts") else "", fmt_dur(r["week"]["resets_in"])) for r in some))
    print("")
    for d in disks:
        print("disk " + fmt_disk(d))
    return 0


def fleet_disks(roster):
    """The peers' disk lines from the last fleet pull (status --fleet brings them), each with the host it came from."""
    st = read_json(FLEET_STAMP) or {}
    return [dict(d, host=h) for h, d in sorted((st.get("disks") or {}).items()) if h != this_host(roster)]


def cmd_pick(args):
    o = flags(args, ["--class", "--model", "--provider", "--host", "--account", "--hours"])
    res = pick(load_roster(), job_class=o.get("--class"), model=o.get("--model"), provider=o.get("--provider"), host=o.get("--host"),
               want=o.get("--account"), hours=float(o.get("--hours") or 1))
    if "--json" in args:
        print(json.dumps(res, indent=1))
        return 0 if "account" in res else 1
    if "error" in res:
        print("no pick: " + res["error"])
        return 1
    print("%s  %s  %s   (%s)" % (res["account"], res["provider"], res["model"], res["why"]))
    for x in res.get("ranked") or []:
        print("   %-28s %6s  resets %-8s %s" % (x["id"], ("%.0f" % x["left"]) if x["left"] is not None else "?",
                                              fmt_dur(x["resets_in"]) if x.get("resets_in") is not None else "?", "ok" if x["ok"] else x["why"]))
    return 0


def flags(args, names):
    """--name value pairs out of args; bare --switches are kept out of the way; the rest in o['_']."""
    o, rest, it = {}, [], iter(args)
    for a in it:
        if a in names:
            o[a] = next(it, None)
        elif any(a.startswith(n + "=") for n in names):
            k, v = a.split("=", 1)
            o[k] = v
        elif a.startswith("--"):
            o[a] = True                      # a switch such as --dry or --force: never a positional
        else:
            rest.append(a)
    o["_"] = rest
    return o


# ----------------------------------------------------------------------------- lanes: cca run

def shared_target_dir(cwd, project):
    """Lanes of one project share one cargo target dir, unless the repo pins its own (.cargo/config.toml with target-dir):
    ten worktrees then cost one build, not ten (2026-10-06: one project's six lane worktrees held 21 GB of target/)."""
    root = git_root(cwd) or cwd
    for d in (cwd, root):
        try:
            if "target-dir" in open(os.path.join(d, ".cargo", "config.toml")).read():
                return None
        except Exception:
            pass
    if not has_cargo(root):
        return None
    return os.path.join(WORKSPACE, "targets", "%s-lanes" % (project or os.path.basename(root)))


def has_cargo(root, depth=3):
    """A Cargo.toml at the root or up to `depth` folders down: a repo of Workers keeps its crates under workers/<name>/,
    and a build there landed in the repo (2026-10-14: 3.7 GB under one repo's workers/<name>/target)."""
    root = os.path.realpath(root)
    for d, dirs, files in os.walk(root):
        if "Cargo.toml" in files:
            return True
        if os.path.relpath(d, root).count(os.sep) + 1 >= depth:
            dirs[:] = []
        else:
            dirs[:] = [x for x in dirs if not x.startswith(".") and x not in READING_SKIP]
    return False


SCRATCH_VOLUME = "/Volumes/Lanes"


def scratch_env(env, volume=SCRATCH_VOLUME):
    """Temp files on the lane volume when a Mac has one (2026-10-10): lanes and captains write gigabytes of scratch a day,
    which has no business on the internal disk. Without the volume, nothing changes."""
    if os.path.isdir(volume):
        d = os.path.join(volume, "tmp")
        try:
            os.makedirs(d, exist_ok=True)
            env["TMPDIR"] = d
        except Exception:
            pass
    return env


def cargo_env(env, cwd, project, incremental=False):
    """Lanes share one target dir per project and build without incremental caches: cargo keys those caches by the
    worktree's path, so every lane would write its own 100+ MB dep-graphs; dependencies in the shared dir are still reused.
    A captain builds in the same dir (2026-10-14: its builds in the main checkout had filled the internal disk) and keeps
    incremental on, since its path never changes."""
    td = shared_target_dir(cwd, project)
    if td:
        env["CARGO_TARGET_DIR"] = td
        if not incremental:
            env["CARGO_INCREMENTAL"] = "0"
    return scratch_env(env)


def stdin_of(text):
    """A brief as a child's stdin: an unlinked file under $TMPDIR. Never on argv: `pkill -f <phrase>` on a shared host
    killed every lane whose brief held the phrase (16 lanes, 2026-10-21)."""
    f = tempfile.TemporaryFile("w+", encoding="utf-8")
    f.write(text)
    f.seek(0)
    return f


LANE = {}        # the running lane's child and record path, for lane_stop


def lane_stop(signum, frame):
    """TERM or INT on the wrapper: the child's process group is ended (TERM, then KILL after 5 s) and the record says
    stopped, by the signal. Before this a TERM left `claude -p` running and the record at running."""
    c = LANE.get("child")
    if c and c.returncode is None:
        for sig, secs in ((signal.SIGTERM, 5.0), (signal.SIGKILL, 2.0)):
            try:
                os.killpg(c.pid, sig)
            except Exception:
                break
            end = now() + secs
            while now() < end:
                try:
                    if os.waitpid(c.pid, os.WNOHANG)[0]:
                        break
                except ChildProcessError:
                    break
                time.sleep(0.1)
            else:
                continue
            break
    m = read_json(LANE.get("meta") or "")
    if m and m.get("status") == "running":
        m.update(status="stopped", ended=now(), stopped_by="signal " + signal.Signals(signum).name)
        write_json(LANE["meta"], m)
    sys.exit(128 + signum)


def lane_signals(meta_path):
    LANE.update(meta=meta_path, child=None)
    for s in (signal.SIGTERM, signal.SIGINT):
        signal.signal(s, lane_stop)


def claude_env(a, kind, project=None, session_id=None):
    env = dict(os.environ)
    env.pop("CLAUDECODE", None)
    for k in list(env):
        if k.startswith("CLAUDE_CODE_"):
            env.pop(k)
    env["CLAUDE_CONFIG_DIR"] = profile_dir(a)
    scratch_env(env)
    env["CCA_KIND"] = kind
    env["CCA_ACCOUNT"] = a["id"]
    if project:
        env["CCA_PROJECT"] = project
    if session_id:
        env["CCA_SESSION"] = session_id
    return env


def run_claude_lane(roster, a, model, prompt, cwd, run_id, session_id, resume, log, effort=None, name=None):
    """One attempt of a headless lane. Returns (outcome, result_text) with outcome in done|error|wall|spawn-failed."""
    cmd = [claude_bin(), "-p", "--output-format", "stream-json", "--verbose", "--dangerously-skip-permissions"]
    cmd += ["--resume", session_id] if resume else ["--session-id", session_id]
    cmd += ["--model", model]
    effort = effort_for(model, effort)
    if effort:
        cmd += ["--effort", effort]
    if name:
        cmd += ["--name", name]                  # the lane's name in the shared registry, so a captain can message it
    env = cargo_env(claude_env(a, "lane", session_id=session_id), cwd, os.environ.get("CCA_PROJECT"))
    env["CCA_RUN"] = run_id                   # what a process the lane leaves behind carries (lane_servers_end)
    try:
        with stdin_of(prompt) as f:              # the brief on stdin (claude -p reads it when no prompt is given)
            child = LANE["child"] = subprocess.Popen(cmd, stdin=f, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, cwd=cwd, env=env, text=True, start_new_session=True)
    except Exception as e:
        return "spawn-failed", str(e)
    lease_write(a["id"], run_id, {"session_id": session_id, "pid": child.pid, "kind": "lane", "run": run_id, "model": model, "cwd": cwd, "host": this_host(roster)})
    result, outcome, walled, stopped = "", "error", False, False
    with open(log, "a", encoding="utf-8") as lf:
        for line in child.stdout:
            lf.write(line)
            if CLASSIFIER_STOP in line:
                stopped = True
            try:
                e = json.loads(line)
            except Exception:
                continue
            if e.get("type") == "rate_limit_event":
                info = e.get("rate_limit_info") or {}
                uw = info.get("unifiedWindows") or {}
                windows = {}
                for key, k in (("five_hour", "five"), ("seven_day", "week")):
                    w = uw.get(key) or {}
                    if w.get("utilization") is not None:
                        windows[k] = {"used": 100.0 * float(w["utilization"]), "resets_at": w.get("resetsAt")}
                if not windows and info.get("utilization") is not None:
                    k = "five" if info.get("rateLimitType") == "five_hour" else "week"
                    windows[k] = {"used": 100.0 * float(info["utilization"]), "resets_at": info.get("resetsAt")}
                sample_update(a["id"], windows, "lane", {"host": this_host(roster)})
                if info.get("status") == "rejected":
                    walled = True
            elif e.get("type") == "result":
                result = e.get("result") or ""
                outcome = "error" if e.get("is_error") else "done"
                if e.get("is_error") and LIMIT_TEXT.search(result or ""):
                    walled = True
    child.wait()
    lease_drop(a["id"], run_id)
    if stopped:
        return "stopped", result
    if walled:
        return "wall", result
    if outcome == "done":
        return "done", result
    return "error", result or ("claude exited %s" % child.returncode)


def abl_cmd(model, session_id, resume=False, effort=None):
    """The claude-abl launch line (the brief goes on stdin: claude-abl execs claude). --model names the gateway model (the profile's copied settings may carry a shared
    default the gateway does not serve); a resume continues the gateway profile's own transcript of the session."""
    cmd = [abl_bin(), "-p", "--output-format", "stream-json", "--verbose", "--dangerously-skip-permissions",
           "--resume" if resume else "--session-id", session_id, "--model", model]
    if effort:
        cmd += ["--effort", effort]
    return cmd


def run_abl_lane(roster, model, prompt, cwd, run_id, session_id, log, effort=None, resume=False):
    """A lane through the abliteration.ai gateway: claude-abl is the stock binary with the gateway's env and its own profile."""
    if not os.path.exists(abl_bin()):
        return "spawn-failed", "claude-abl not found (expected on PATH or at ~/.local/bin/claude-abl)"
    cmd = abl_cmd(model, session_id, resume, effort)
    env = {k: v for k, v in os.environ.items() if not (k.startswith("CLAUDE_CODE_") or k == "CLAUDECODE" or k == "CLAUDE_CONFIG_DIR")}
    env.update(ABL_MODEL=model, CCA_KIND="lane", CCA_ACCOUNT=ABL_ACCOUNT, CCA_SESSION=session_id, CCA_RUN=run_id)
    env = cargo_env(env, cwd, os.environ.get("CCA_PROJECT"))
    try:
        with stdin_of(prompt) as f:
            child = LANE["child"] = subprocess.Popen(cmd, stdin=f, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, cwd=cwd, env=env, text=True, start_new_session=True)
    except Exception as e:
        return "spawn-failed", str(e)
    lease_write(ABL_ACCOUNT, run_id, {"session_id": session_id, "pid": child.pid, "kind": "lane", "run": run_id, "model": model, "cwd": cwd, "host": this_host(roster)})
    result, outcome, usage = "", "error", {}
    with open(log, "a", encoding="utf-8") as lf:
        for line in child.stdout:
            lf.write(line)
            try:
                e = json.loads(line)
            except Exception:
                continue
            if e.get("type") == "result":
                result = e.get("result") or ""
                outcome = "error" if e.get("is_error") else "done"
                usage = e.get("usage") or {}
    child.wait()
    lease_drop(ABL_ACCOUNT, run_id)
    try:
        m = read_json(os.path.join(RUNS, run_id + ".json")) or {}
        m.update(usage=usage, cost_usd=round(abl_cost(model, usage), 4))
        write_json(os.path.join(RUNS, run_id + ".json"), m)
    except Exception:
        pass
    return outcome, result or ("claude-abl exited %s" % child.returncode)


def codex_exec_cmd(roster, model, effort, tier, last, cwd):
    """The codex exec line of a lane: the model, the reasoning effort, and the SERVICE TIER (the owner's
    2026-10-14 word: "codex literally has a 'very fast' it called 'ultra fast'"), passed explicitly so a lane runs
    the same on every host whatever ~/.codex/config.toml says there. The tier is the roster setting
    codex_service_tier (default ultrafast) or the launch line's --tier."""
    s = roster["settings"]
    return [codex_bin(), "exec", "-m", model,
            "-c", 'model_reasoning_effort="%s"' % (effort or s["codex_effort"]),
            "-c", 'service_tier="%s"' % (tier or s.get("codex_service_tier", DEFAULT_SETTINGS["codex_service_tier"])),
            "--json", "-o", last, "--cd", cwd, "--skip-git-repo-check", "--dangerously-bypass-approvals-and-sandbox"]


def run_codex_lane(roster, a, model, prompt, cwd, run_id, log, effort=None, tier=None):
    home = codex_home(a)
    last = os.path.join(RUNS, run_id + ".last.txt")
    cmd = codex_exec_cmd(roster, model, effort, tier, last, cwd)
    env = cargo_env(dict(os.environ, CODEX_HOME=home, CCA_KIND="lane", CCA_ACCOUNT=a["id"], CCA_RUN=run_id), cwd, os.environ.get("CCA_PROJECT"))
    try:
        with open(log, "a", encoding="utf-8") as lf, stdin_of(prompt) as f:      # codex exec reads the brief from stdin when no PROMPT is given
            child = LANE["child"] = subprocess.Popen(cmd, stdin=f, stdout=lf, stderr=subprocess.STDOUT, cwd=cwd, env=env, text=True, start_new_session=True)
            lease_write(a["id"], run_id, {"pid": child.pid, "kind": "lane", "run": run_id, "model": model, "cwd": cwd, "host": this_host(roster)})
            child.wait()
    except Exception as e:
        return "spawn-failed", str(e)
    finally:
        lease_drop(a["id"], run_id)
    windows, at = codex_windows(home)
    if windows:
        sample_update(a["id"], windows, "lane", {"host": this_host(roster)})
    result = ""
    try:
        result = open(last, encoding="utf-8").read()
    except Exception:
        pass
    tail = ""
    try:
        tail = open(log, encoding="utf-8").read()[-4000:]
    except Exception:
        pass
    if child.returncode != 0 and LIMIT_TEXT.search(tail + result):
        return "wall", result
    return ("done" if child.returncode == 0 else "error"), result or tail[-1500:]


def git_root(path):
    try:
        return subprocess.run(["git", "-C", path, "rev-parse", "--show-toplevel"], capture_output=True, text=True, timeout=5).stdout.strip() or None
    except Exception:
        return None


def lane_worktree_path(root, name, volume=None):
    """Where a lane's worktree lives: /Volumes/Lanes/worktrees/<repo>/<name> on a Mac with the lane volume (2026-10-14: the
    internal disk stood at 99 percent with some 50 GB of lane worktrees and their builds on it), else the old place,
    <root>/.claude/worktrees/<name>. <repo> is named by git's common dir, so a captain in a worktree sends its lanes under
    its repo (2026-10-16: 116 worktrees of one project sat under worktrees/captain-fold). A folder already at either old place
    wins, so a lane that is running keeps its home."""
    volume = SCRATCH_VOLUME if volume is None else volume
    old = os.path.join(root, ".claude", "worktrees", name)
    if os.path.isdir(old) or not os.path.isdir(volume):
        return old
    was = os.path.join(volume, "worktrees", os.path.basename(os.path.realpath(root)), name)
    if os.path.isdir(was):
        return was
    return os.path.join(volume, "worktrees", os.path.basename(worktree_root(root) or os.path.realpath(root)), name)


def lane_worktree(root, name, base=None, volume=None):
    """The lane's own checkout (lane_worktree_path) on branch lane/<name>, made if missing, at `base`
    (a commit the sender pushed here) or at HEAD. When the main checkout holds a .lanes-exclude (gitignore patterns, one
    a line), the worktree is sparse: everything but those paths (2026-10-16: one project's 1.2 GB docs/audit in 200 worktrees)."""
    path = lane_worktree_path(root, name, volume)
    if os.path.isdir(path):
        return path, None
    os.makedirs(os.path.dirname(path), exist_ok=True)
    branch = "lane/" + name
    exists = subprocess.run(["git", "-C", root, "rev-parse", "--verify", "-q", branch], capture_output=True).returncode == 0
    skip = lanes_exclude(worktree_root(root) or root)
    cmd = ["git", "-C", root, "worktree", "add"] + (["--no-checkout"] if skip else []) + ([path, branch] if exists else ["-b", branch, path, base or "HEAD"])
    r = subprocess.run(cmd, capture_output=True, text=True)
    for c in ([["sparse-checkout", "set", "--no-cone", "/*"] + [x[1:] if x.startswith("!") else "!" + x for x in skip], ["checkout"]] if skip and r.returncode == 0 else []):
        r = subprocess.run(["git", "-C", path] + c, capture_output=True, text=True)
        if r.returncode != 0:
            break
    if r.returncode != 0:
        return None, r.stderr.strip()[-300:]
    return path, None


def lanes_exclude(main):
    """The patterns in the main checkout's .lanes-exclude, comments and blank lines dropped; [] without the file."""
    try:
        lines = open(os.path.join(main, ".lanes-exclude"), encoding="utf-8").read().splitlines()
    except OSError:
        return []
    return [x.strip() for x in lines if x.strip() and not x.strip().startswith("#")]


def lane_excluded(path):
    """The paths a sparse lane worktree leaves out (the negated lines of its sparse-checkout file); [] for a full one."""
    r = subprocess.run(["git", "-C", path, "sparse-checkout", "list"], capture_output=True, text=True)
    return [x[1:] for x in r.stdout.split() if x.startswith("!")] if r.returncode == 0 else []


def lane_node_modules(path, main, env, volume=None):
    """A lane worktree shares node_modules (2026-10-16: 770 MB installed per lane of one project). pnpm: the store on the lane volume
    (npm_config_store_dir in env). npm or yarn: a link to the main checkout's node_modules when the lockfiles are byte-identical;
    an install in the lane replaces the link with a folder. Returns what happened, for the run record, or None."""
    volume = SCRATCH_VOLUME if volume is None else volume
    pkg = read_json(os.path.join(path, "package.json"))
    if not isinstance(pkg, dict) or not main or os.path.realpath(main) == os.path.realpath(path):
        return None
    if str(pkg.get("packageManager", "")).startswith("pnpm") or os.path.exists(os.path.join(path, "pnpm-lock.yaml")):
        if not os.path.isdir(volume):
            return None
        env["npm_config_store_dir"] = os.path.join(volume, "pnpm-store")
        return "pnpm store " + env["npm_config_store_dir"]
    nm, have = os.path.join(main, "node_modules"), os.path.join(path, "node_modules")
    if not os.path.isdir(nm) or os.path.lexists(have):
        return "node_modules linked to " + nm if os.path.islink(have) else None
    for lock in ("package-lock.json", "yarn.lock"):
        try:
            if open(os.path.join(path, lock), "rb").read() == open(os.path.join(main, lock), "rb").read():
                os.symlink(nm, have)
                ex = subprocess.run(["git", "-C", path, "rev-parse", "--git-path", "info/exclude"], capture_output=True, text=True).stdout.strip()
                ex = os.path.join(path, ex)
                if ex and "/node_modules" not in (open(ex).read().split() if os.path.exists(ex) else []):
                    os.makedirs(os.path.dirname(ex), exist_ok=True)
                    open(ex, "a").write("\n/node_modules\n")   # "node_modules/" in .gitignore misses a link
                return "node_modules linked to " + nm + " (" + lock + " identical)"
        except OSError:
            continue
    return None


def worktree_drop_if_clean(root, name, base):
    """A report-only lane's worktree is removed when it left nothing: no commit past its base, nothing dirty or ignored. The one
    ignored thing allowed is the node_modules link lane_node_modules made (a link, in info/exclude). True only when git removed it:
    a refusal (a worktree with an initialised submodule) leaves it and the branch, and says False. The branch goes only when
    `git log base..branch` is empty (a log that fails keeps it too)."""
    path = lane_worktree_path(root, name)
    if not os.path.isdir(path):
        return False
    if not base:       # nothing to count commits from
        return False
    ahead = [subprocess.run(["git", "-C", where, "log", "--format=%H", base + ".." + ref], capture_output=True, text=True)
             for where, ref in ((root, "lane/" + name), (path, "HEAD"))]       # the branch itself and the checked-out HEAD, never HEAD alone
    lines = subprocess.run(["git", "-C", path, "status", "--porcelain", "--ignored"], capture_output=True, text=True).stdout.splitlines()
    link = os.path.join(path, "node_modules")
    dirty = [l for l in lines if l.strip() and not (l.strip() in ("!! node_modules", "!! node_modules/") and os.path.islink(link))]
    subs = [l for l in subprocess.run(["git", "-C", path, "submodule", "status"], capture_output=True, text=True).stdout.splitlines() if l and l[0] != "-"]
    if dirty or subs or any(a.returncode != 0 or a.stdout.strip() for a in ahead):
        return False
    if subprocess.run(["git", "-C", root, "worktree", "remove", path], capture_output=True).returncode != 0:
        return False
    subprocess.run(["git", "-C", root, "branch", "-D", "lane/" + name], capture_output=True)
    return True


# ----------------------------------------------------------------------------- the machines: where a lane runs (rule 20)

HOSTS_CACHE = os.path.join(CCA, "hosts.json")
REPORT_ONLY = ("review", "proof", "design")


def host_score(c):
    """Load per core, with the lanes already running there counted as load: what a new lane would land on."""
    return (float(c.get("load") or 0) + float(c.get("lanes") or 0)) / float(c.get("cores") or 1)


def local_probe():
    lanes = sum(1 for m in (read_json(p) or {} for p in glob.glob(os.path.join(RUNS, "*.json"))) if m.get("status") == "running" and m.get("id") and leases_alive(m))
    return {"load": os.getloadavg()[0], "cores": os.cpu_count() or 1, "lanes": lanes}


def host_probe(roster, alias, roots, max_age=60):
    """One ssh to a peer, cached a minute: its load, cores, running lanes, and which of these project roots it has."""
    h = roster["hosts"].get(alias) or {}
    cache = read_json(HOSTS_CACHE) or {}
    c = cache.get(alias) or {}
    if now() - (c.get("at") or 0) < max_age and all(r in (c.get("roots") or {}) for r in roots):
        return c
    code = ("import json,glob,os\n"
            "def alive(pid):\n"
            "    try: os.kill(int(pid), 0); return True\n"
            "    except Exception: return False\n"
            "lanes=0\n"
            "for p in glob.glob(os.path.expanduser('~/.cca/runs/*.json')):\n"
            "    try: m=json.load(open(p))\n"
            "    except Exception: continue\n"
            "    if m.get('status')!='running': continue\n"
            "    try: l=json.load(open(os.path.expanduser('~/.cca/leases/%%s/%%s.json' %% (m.get('account'), m['id']))))\n"
            "    except Exception: continue\n"
            "    lanes+=alive(l.get('pid'))\n"
            "print(json.dumps({'load': os.getloadavg()[0], 'cores': os.cpu_count(), 'lanes': lanes, 'roots': {r: os.path.exists(os.path.join(r, '.git')) for r in %r}}))" % list(roots))
    try:
        out = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", h["ssh"], "python3 -c " + shlex.quote(code)],
                             capture_output=True, text=True, timeout=15).stdout
        c = json.loads(out.strip().splitlines()[-1])
        c.update(at=now(), ok=True)
    except Exception as e:
        c = {"at": now(), "ok": False, "error": str(e)[:80]}
    cache[alias] = c
    write_json(HOSTS_CACHE, cache)
    return c


def choose_host(roster, root, job_class, worktree, model=None, provider=None):
    """Where a lane with no --host runs: a peer when the lane is report-only or in a worktree, the project is checked
    out there, a login with room is there, and its load per core (lanes counted) is lower than here. Else here."""
    me = this_host(roster)
    if provider == "abl" or is_abl_model(model):
        return None, "the gateway runs here"
    if job_class not in REPORT_ONLY and not worktree:
        return None, "a code lane without a worktree stays here"
    peers = [al for al, h in roster["hosts"].items() if al != me and h.get("ssh") and not h.get("no_claude")]
    if not peers:
        return None, "no peer"
    mine = host_score(local_probe())
    best = None
    for al in peers:
        if fleet_lock_refusal(roster, al):  # rule 25: never send a lane to a loop host while the loop runs
            continue
        c = host_probe(roster, al, [root])
        if not c.get("ok") or not (c.get("roots") or {}).get(root):
            continue
        score = host_score(c)
        if score >= mine:
            continue
        if "account" not in pick(roster, job_class=job_class, model=model, provider=provider, host=al):
            continue
        if best is None or score < best[1]:
            best = (al, score, c)
    if not best:
        return None, "no peer has the project, a login with room, and less load (%.1f per core here)" % mine
    al, score, c = best
    return al, "%.1f per core there with %d lanes, %.1f here" % (score, c.get("lanes") or 0, mine)


def fleet_lock_refusal(roster, host):
    """Rule 25: no lane on a loop host (settings fleet_lock_hosts) while this machine's fleet lock names a live loop there.
    The project's own checker decides (`node fleet-lock.mjs check --host=H`); its words are the refusal. A lock file with no
    checker to read it refuses (could not look). Returns the refusal, or None."""
    if not host or host not in (roster["settings"].get("fleet_lock_hosts") or []):
        return None
    script = expand(roster["settings"].get("fleet_lock_check") or "")
    lock = os.environ.get("CCA_FLEET_LOCK") or os.path.join(CCA, "fleet.lock")
    head = "cca run: REFUSED, no lane runs on %s while a fleet loop runs (rule 25)" % host
    try:
        r = subprocess.run(["node", script, "check", "--host=" + host, "--for=cca run --host " + host], capture_output=True, text=True, timeout=30)
    except Exception as e:
        return None if not os.path.exists(lock) else "%s: a fleet lock is at %s and its checker could not run (%s)" % (head, lock, str(e)[:80])
    if r.returncode == 0:
        if r.stderr.strip():
            print(r.stderr.strip(), file=sys.stderr)
        return None
    if not os.path.isfile(script) and not os.path.exists(lock):
        return None
    return "%s:\n%s" % (head, (r.stderr or r.stdout).strip() or "the checker %s exit %d" % (script, r.returncode))


def peer_remote(root, alias, h):
    """The git remote named for a peer in this repo (ssh://<alias><root>), added when missing."""
    url = "ssh://%s%s" % (h["ssh"], root)
    r = subprocess.run(["git", "-C", root, "remote", "get-url", alias], capture_output=True, text=True)
    if r.returncode != 0:
        subprocess.run(["git", "-C", root, "remote", "add", alias, url], capture_output=True)
    return alias


def gate_cmd(cwd):
    """The repo's gate, if it has one: an executable tools/gate, else a Makefile or justfile target named gate.
    None when the repo has none, and then a lane's done-bar is what it always was (rule 21)."""
    g = os.path.join(cwd, "tools", "gate")
    if os.path.isfile(g) and os.access(g, os.X_OK):
        return [g], "tools/gate"
    for f, runner in (("Makefile", "make"), ("justfile", "just"), ("Justfile", "just")):
        fp = os.path.join(cwd, f)
        try:
            if os.path.isfile(fp) and re.search(r"^gate\s*:", open(fp, errors="replace").read(), re.M):
                return [runner, "gate"], runner + " gate"
        except Exception:
            pass
    return None


def gate_after(roster, meta, cwd, run_id, result):
    """Rule 21: a code lane that says done is held to the repo's gate, run in the lane's own folder. Pass: the REPORT stands,
    with the gate's time on the head line. Fail: the lane is blocked and its REPORT starts with the verdict and the log's path."""
    cmd, label = gate_cmd(cwd)
    os.makedirs(RUNS, exist_ok=True)
    log = os.path.join(RUNS, run_id + ".gate.log")
    timeout = float((roster.get("settings") or {}).get("gate_timeout") or DEFAULT_SETTINGS["gate_timeout"])
    env = cargo_env(dict(os.environ), cwd, os.environ.get("CCA_PROJECT"))
    t0 = now()
    try:
        with open(log, "w", encoding="utf-8") as lf:
            rc = subprocess.call(cmd, cwd=cwd, stdin=subprocess.DEVNULL, stdout=lf, stderr=subprocess.STDOUT, env=env, timeout=timeout)
        verdict = "pass" if rc == 0 else "exit %d" % rc
    except subprocess.TimeoutExpired:
        rc, verdict = -1, "timeout after %ds" % timeout
    except Exception as e:
        rc, verdict = -1, "could not run: %s" % e
    secs = now() - t0
    meta["gate"] = {"cmd": label, "rc": rc, "verdict": verdict, "seconds": round(secs), "log": log}
    if rc == 0:
        return "done", result, " · gate pass (%s, %s)" % (label, fmt_dur(secs))
    tail = ""
    try:
        tail = "".join(open(log, errors="replace").readlines()[-15:])
    except Exception:
        pass
    return "blocked", "GATE FAILED: %s, %s, %s. Log: %s\n%s\n\n%s" % (label, verdict, fmt_dur(secs), log, tail.rstrip(), result or ""), " · gate FAILED (%s, %s)" % (label, verdict)


RUN_FLAGS = ["--class", "--model", "--provider", "--account", "--project", "--cwd", "--host", "--effort", "--tier", "--name", "--task-file", "--worktree", "--base"]


def worktree_stale(root, name, volume=None):
    """Why a new lane must not take worktree `name`: its folder is on disk, or lane/<name> (here or on origin) has commits
    main lacks (2026-10-21: a new lane ran in an old worktree 437 commits behind main). None when it is free, or when a
    running lane lives there (its home). --reuse on the launch line skips this."""
    path = lane_worktree_path(root, name, volume)
    if any(m.get("status") == "running" and leases_alive(m) and os.path.realpath(m.get("cwd") or "") == os.path.realpath(path) for m in run_metas()):
        return None
    if os.path.isdir(path):
        return "the folder %s is already on disk" % path

    def git(*a):
        return subprocess.run(["git", "-C", root] + list(a), capture_output=True, text=True)
    mains = [b for b in ("main", "origin/main") if git("rev-parse", "--verify", "-q", b).returncode == 0]
    for ref in ("lane/" + name, "origin/lane/" + name) if mains else ():
        n = git("rev-list", "--count", ref, "--not", *mains).stdout.strip()
        if n and n != "0":
            return "%s has %s commit(s) not on main" % (ref, n)
    return None


def lane_start_meta(meta_path, meta, locker=None):
    """Writes a lane's meta (status running) while holding the sweep lock, so a `cca disk --clean --path` in flight (which holds it
    from its running-lane look to its move) is waited for, and a clean that comes after sees the lane. None when written, else the
    refusal line: the lock was not free in SWEEP_WAIT seconds, or the lane's folder is gone (a clean moved it while this one waited)."""
    lock = (locker or sweep_lock)(wait=True)
    if not lock:
        return "a disk clean has held the sweep lock for %ds" % SWEEP_WAIT
    try:
        if meta.get("cwd") and not os.path.isdir(meta["cwd"]):
            return "its folder %s is gone (a disk clean moved it)" % meta["cwd"]
        write_json(meta_path, meta)
        return None
    finally:
        lock.close()


def cmd_run(args):
    o = flags(args, RUN_FLAGS)
    hazard = "--hazard" in args
    if hazard and not (o.get("--model") or o.get("--provider") == "abl"):
        o["--model"] = load_roster()["settings"].get("hazard_model") or "abl"      # the model John named for hazards (rule 18)
    roster = load_roster()
    me = this_host(roster)
    project0 = o.get("--project")
    root0 = project_root(roster, project0) if project0 else (git_root(os.getcwd()) or os.getcwd())
    tf = o.get("--task-file")               # `--task-file -`: the task on stdin (how a forwarded lane gets it)
    task = (sys.stdin.read() if tf == "-" else open(expand(tf), encoding="utf-8").read()) if tf else " ".join(o["_"]).strip()
    host, why = o.get("--host"), "named"
    if not host and not os.environ.get("CCA_NO_PEER"):
        host, why = choose_host(roster, root0, o.get("--class") or "code", o.get("--worktree"), o.get("--model"), o.get("--provider"))
    if host and host != me:
        h = roster["hosts"].get(host) or {}
        refusal = fleet_lock_refusal(roster, host)
        if refusal:
            print(refusal, file=sys.stderr)
            return 3
        if o.get("--account") and not on_host(account(roster, o["--account"]) or {}, host):
            print("cca run: %s is not signed in on %s" % (o["--account"], host), file=sys.stderr)
            return 2
        if h.get("no_claude") and (o.get("--provider") or "claude") == "claude":
            print("cca run: %s runs no Claude (the roster's no_claude flag)" % host, file=sys.stderr)
            return 2
        if not h.get("ssh"):
            print("cca run: no ssh alias for host %s" % host, file=sys.stderr)
            return 2
        fwd, it = [], iter(args)
        for x in it:                        # the flags go to the peer verbatim but --host and --task-file; the task never rides an argv
            if x in RUN_FLAGS:
                v = next(it, None)
                if x not in ("--host", "--task-file"):
                    fwd += [x, v]
            elif x.startswith("--") and not x.startswith(("--host=", "--task-file=")):
                fwd.append(x)
        fwd += ["--task-file", "-"]         # the peer reads the task from ssh's stdin
        if not o.get("--cwd"):
            fwd += ["--cwd", root0]         # the same path on the peer: the lane runs in the project, never in the peer's home
        if not project0:
            name0 = next((n for n, pr in roster["projects"].items() if os.path.realpath(expand(pr["root"])) == os.path.realpath(root0)), None)
            if name0:
                fwd += ["--project", name0]
        wt = o.get("--worktree")
        sent_base = None
        if os.path.isdir(os.path.join(root0, ".git")) or os.path.isfile(os.path.join(root0, ".git")):
            if not wt and why != "named":   # a lane sent by the rule runs in a worktree there, at this HEAD, never in the peer's checkout
                wt = o.get("--name") or ("lane-" + uuid.uuid4().hex[:6])
                fwd += ["--worktree", wt]
            if wt:
                sent_base = subprocess.run(["git", "-C", root0, "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip()
                remote = peer_remote(root0, host, h)
                pr = subprocess.run(["git", "-C", root0, "push", "-q", remote, "HEAD:refs/cca/" + wt], capture_output=True, text=True)
                if pr.returncode != 0:
                    print("cca run: could not push HEAD to %s (%s); running here" % (host, pr.stderr.strip()[-160:]), file=sys.stderr)
                    host, sent_base = None, None
        if host:
            if sent_base:
                fwd += ["--base", sent_base]
            print("on %s: %s" % (host, why))
            sys.stdout.flush()
            roster_push(roster)             # the peer picks from the roster and the readings as they are now
            q = " ".join("'" + x.replace("'", "'\\''") + "'" for x in fwd)
            rc = subprocess.run(["ssh"] + RELAY_SSH + [h["ssh"], rq(roster["settings"]["peer_cca"]) + " run " + q], input=task, text=True).returncode
            if wt and sent_base:
                fr = subprocess.run(["git", "-C", root0, "fetch", "-q", host, "+refs/heads/lane/%s:refs/remotes/%s/lane/%s" % (wt, host, wt)], capture_output=True, text=True)
                if fr.returncode == 0:
                    head = subprocess.run(["git", "-C", root0, "rev-parse", "--short", "%s/lane/%s" % (host, wt)], capture_output=True, text=True).stdout.strip()
                    print("branch %s/lane/%s is in this repo at %s%s" % (host, wt, head, " (nothing past the base)" if head and sent_base.startswith(head) else ""))
                elif (o.get("--class") or "code") in REPORT_ONLY:
                    print("no branch came back: the report-only lane left nothing on %s" % host)
                else:
                    print("branch lane/%s stayed on %s (fetch: %s)" % (wt, host, fr.stderr.strip()[-120:]))
            return rc
    if not task:
        print("usage: cca run --class code|review|design|proof [--project P] [--cwd D] [--model M] [--account A] [--host H] \"task\"", file=sys.stderr)
        return 2
    refusal = fleet_lock_refusal(roster, me)      # typed on the box, or sent here: the box's own lock decides
    if refusal:
        print(refusal, file=sys.stderr)
        return 3
    if o.get("--name"):
        dup = find_run(o["--name"])
        if dup and dup.get("status") == "running" and leases_alive(dup):
            print("cca run: lane %s is still running (%s on %s); `cca runs --show %s`" % (o["--name"], dup["id"], dup.get("account"), o["--name"]), file=sys.stderr)
            return 2
    project = o.get("--project")
    here = expand(o.get("--cwd") or os.getcwd())
    root = project_root(roster, project) if project else (git_root(here) or here)
    if not project:
        project = next((n for n, pr in roster["projects"].items() if os.path.realpath(expand(pr["root"])) == os.path.realpath(root)), os.path.basename(root))
    cwd = expand(o.get("--cwd") or root)
    low = disk_floor(roster, project, root)
    if low:
        print(low, file=sys.stderr)
        return 2
    worktree = None
    if o.get("--worktree"):
        stale = None if "--reuse" in args else worktree_stale(root, o["--worktree"])
        if stale:
            print("cca run: worktree %s not reused: %s (a new name, or --reuse to run there anyway)" % (o["--worktree"], stale), file=sys.stderr)
            return 2
        cwd, err = lane_worktree(root, o["--worktree"], o.get("--base"))
        if err:
            print("cca run: worktree %s: %s" % (o["--worktree"], err), file=sys.stderr)
            return 2
        worktree = o["--worktree"]
        wt_head = subprocess.run(["git", "-C", cwd, "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip()       # what the new worktree starts at
    job_class = o.get("--class") or "code"
    os.environ["CCA_PROJECT"] = project
    tried, attempts, resume = [], 0, False
    run_id, session_id = uuid.uuid4().hex[:12], str(uuid.uuid4())
    meta_path, log = os.path.join(RUNS, run_id + ".json"), os.path.join(RUNS, run_id + ".log")
    prompt = task + REPORT_SUFFIX
    started = now()
    hazard_file = os.path.join(RUNS, run_id + ".hazard.md")
    if hazard:
        prompt = ("HAZARD LANE (rule 19). Write your full output to the file %s. Your final message is at most ten lines: a verdict, that path, "
                  "and what the reader must decide; quote nothing from the material in it. The captain reads your final message only, never the file.\n\n" % hazard_file) + task
    meta = {"id": run_id, "session_id": session_id, "class": job_class, "project": project, "cwd": cwd, "worktree": worktree, "task": task[:400], "started": started,
            "name": o.get("--name"), "host": this_host(roster), "pid": os.getpid(), "moves": [], "hazard": hazard, "hazard_file": hazard_file if hazard else None}
    prompt = lane_scratch_note(project) + " " + LANE_SERVERS_NOTE + "\n\n" + prompt
    if worktree:
        main = worktree_root(root) or root
        left_out = lane_excluded(cwd)
        meta["node_modules"] = lane_node_modules(cwd, main, os.environ)
        prompt = ("You work in the git worktree %s on branch lane/%s; commit there, do not touch the main checkout.%s\n\n"
                  % (cwd, worktree, (" This worktree is sparse: %s are left out of it; read them in the main checkout %s." % (", ".join(left_out), main)) if left_out else "")) + prompt
    lane_signals(meta_path)
    while attempts < 4:
        attempts += 1
        p = pick(roster, job_class=job_class, model=o.get("--model"), provider=o.get("--provider"), want=o.get("--account") if attempts == 1 else None, exclude=tried)
        if attempts == 1 and o.get("--account") and os.environ.get("CCA_KIND") == "captain" and "account" in p:
            own = pick(roster, job_class=job_class, model=o.get("--model"), provider=o.get("--provider"), exclude=tried)   # what the picker would have spent
            if own.get("account") and own["account"] != p["account"]:
                print("note: --account %s as named; left alone the picker would have spent %s (%s), the week that expires soonest first." % (p["account"], own["account"], own.get("why", "")))
        if "account" not in p:
            meta.update(status="blocked", ended=now(), result="no account: " + p["error"])
            write_json(meta_path, meta)
            print("lane %s · blocked · %s" % (run_id, p["error"]))
            return 3
        a = account(roster, p["account"]) or {"id": p["account"], "provider": p["provider"]}
        if p["provider"] == "claude" and on_host(a, host) and not login_ok(a, live=True):   # the record said signed in; the blob itself says otherwise
            tried.append(a["id"])
            continue
        meta.update(account=a["id"], provider=p["provider"], model=p["model"], status="running", attempt=attempts)
        busy = lane_start_meta(meta_path, meta)       # under the sweep lock: a clean's running-lane look and its move cannot straddle this write
        if busy:
            meta.update(status="blocked", ended=now(), result="not started: " + busy)
            write_json(meta_path, meta)
            spent = (" after %d walled attempt%s on %s (%s spent; `cca runs --show %s`)" % (len(meta["moves"]), "" if len(meta["moves"]) == 1 else "s", ", ".join(tried), fmt_dur(now() - started), run_id)) if meta["moves"] else ""
            dropped = ""
            if worktree and wt_head and not meta["moves"] and "--reuse" not in args and worktree_drop_if_clean(root, worktree, wt_head):       # only a worktree this lane made and left untouched
                dropped = "; worktree %s removed" % worktree
            print("cca run: refused (busy): %s; lane %s not started%s%s" % (busy, run_id, spent, dropped), file=sys.stderr)
            lane_end_sweep(roster, meta, root)
            return PATH_EXITS["busy"]
        session_note(session_id, a["id"], "lane", project, p["model"])
        if p["provider"] == "abl":
            outcome, result = run_abl_lane(roster, p["model"], prompt, cwd, run_id, session_id, log, o.get("--effort"))
        elif p["provider"] == "codex":
            outcome, result = run_codex_lane(roster, a, p["model"], prompt, cwd, run_id, log, o.get("--effort"), o.get("--tier"))
        else:
            outcome, result = run_claude_lane(roster, a, p["model"], prompt, cwd, run_id, session_id, resume, log, o.get("--effort"), name="lane-" + (o.get("--name") or run_id))
        if outcome == "stopped":
            meta.update(status="stopped", ended=now(), result=(result or "")[-20000:], stopped_by="safety classifier")
            write_json(meta_path, meta)
            print("lane %s · %s · %s · stopped by a safety classifier after %s. Not retried by the tool: John names its next model (`--model opus48`) or takes it himself. "
                  "Its record: cca runs --show %s" % (run_id, a["id"], p["model"], fmt_dur(now() - started), run_id))
            lane_end_sweep(roster, meta, root)
            return 4
        if outcome == "wall":
            tried.append(a["id"])
            meta["moves"].append({"from": a["id"], "at": now(), "attempt": attempts})
            sample_update(a["id"], {}, "lane", {"wall_at": now()})
            resume = p["provider"] == "claude"       # a Claude lane resumes its conversation; a Codex lane starts the task again
            prompt = "Continue where you left off." + REPORT_SUFFIX if resume else task + REPORT_SUFFIX
            continue
        gate_note = ""
        if outcome == "done" and job_class not in REPORT_ONLY and not hazard and gate_cmd(cwd):
            outcome, result, gate_note = gate_after(roster, meta, cwd, run_id, result)
        meta.update(status=outcome, ended=now(), result=(result or "")[-20000:])
        write_json(meta_path, meta)
        cost = (read_json(meta_path) or {}).get("cost_usd")
        meta["cost_usd"] = cost
        head = "lane %s · %s · %s · %s · %s · %s%s%s%s%s" % (run_id, a["id"], p["model"], job_class, outcome, fmt_dur(now() - started),
                                                           (" · $%.3f" % cost) if cost is not None else "",
                                                         (" · moved %d×" % len(meta["moves"])) if meta["moves"] else "",
                                                         (" · worktree %s (branch lane/%s)" % (cwd, worktree)) if worktree else "",
                                                         " · HAZARD: the file is for John, not the captain" if hazard else "")
        print(head + gate_note)
        print(report_of(result, cap=12) if hazard else report_of(result))
        if o.get("--base") and worktree and job_class in REPORT_ONLY and worktree_drop_if_clean(root, worktree, o["--base"]):
            print("worktree %s removed: a report-only lane sent here left nothing in it" % worktree)
        lane_end_sweep(roster, meta, root)
        return 0 if outcome == "done" else 1
    meta.update(status="walled", ended=now())
    write_json(meta_path, meta)
    print("lane %s · walled on %s; nothing else has room" % (run_id, ", ".join(tried)))
    lane_end_sweep(roster, meta, root)
    return 3


def report_of(text, cap=200):
    """A lane's final message is its report. Printed whole up to `cap` lines; past that, the head and the REPORT block."""
    text = (text or "").strip()
    lines = text.split("\n")
    if len(lines) <= cap:
        return text
    i = text.rfind("REPORT:")
    tail = text[i:] if i >= 0 else "\n".join(lines[-24:])
    return "\n".join(lines[:cap - 30]) + "\n[... %d lines cut; cca runs --show <id> for all of it ...]\n" % (len(lines) - cap) + tail


def run_metas():
    return [m for m in (read_json(p) for p in glob.glob(os.path.join(RUNS, "*.json"))) if m]


def find_run(ref):
    """A run by its name (a lane's id in the plan, newest first) or by an id prefix."""
    ms = sorted(run_metas(), key=lambda m: -m.get("started", 0))
    return next((m for m in ms if m.get("name") == ref), None) or next((m for m in ms if m["id"].startswith(ref)), None)


def run_resume(roster, ref):
    """A lost or stopped lane picked up where it left off: same conversation, the best pool account, its worktree, its report."""
    m = find_run(ref)
    if not m:
        print("no run %s" % ref, file=sys.stderr)
        return 1
    if m.get("status") == "running" and leases_alive(m):
        print("lane %s is still running" % ref, file=sys.stderr)
        return 1
    if m.get("provider") == "codex":
        print("lane %s ran on Codex; its thread cannot be resumed by this tool: fire the task again with cca run" % ref, file=sys.stderr)
        return 2
    cwd = m.get("cwd") or os.getcwd()
    if not os.path.isdir(cwd):
        print("lane %s: its folder %s is gone" % (ref, cwd), file=sys.stderr)
        return 1
    os.environ["CCA_PROJECT"] = m.get("project") or ""
    tried, attempts, started = [], 0, now()
    run_id, log, meta_path = m["id"], os.path.join(RUNS, m["id"] + ".log"), os.path.join(RUNS, m["id"] + ".json")
    prompt = ("Resume: your previous run of this lane was interrupted. Re-read your brief and the REPORT you owe, check what you already committed in this "
              "worktree, and continue where you left off." + REPORT_SUFFIX)
    m["pid"] = os.getpid()
    lane_signals(meta_path)
    while attempts < 4:
        attempts += 1
        p = pick(roster, job_class=m.get("class"), model=m.get("model"), provider="claude", exclude=tried)
        if "account" not in p:
            print("lane %s: no account has room (%s)" % (ref, p["error"]), file=sys.stderr)
            return 3
        if p.get("provider") == "abl":                # the gateway: no pool account, no wall, its own transcript
            m.update(account=ABL_ACCOUNT, provider="abl", model=p["model"], status="running", attempt=(m.get("attempt") or 0) + 1, resumed=now())
            write_json(meta_path, m)
            session_note(m["session_id"], ABL_ACCOUNT, "lane", m.get("project"), p["model"])
            outcome, result = run_abl_lane(roster, p["model"], prompt, cwd, run_id, m["session_id"], log, resume=True)
            m.update(status=outcome, ended=now(), result=(result or "")[-20000:])
            write_json(meta_path, m)
            print("lane %s · %s · %s · resumed · %s · %s" % (m.get("name") or run_id, ABL_ACCOUNT, p["model"], outcome, fmt_dur(now() - started)))
            print(report_of(result, cap=12) if m.get("hazard") else report_of(result))
            lane_end_sweep(roster, m)
            return 0 if outcome == "done" else 1
        a = account(roster, p["account"])
        if on_host(a, this_host(roster)) and not login_ok(a, live=True):
            tried.append(a["id"])
            continue
        m.update(account=a["id"], model=p["model"], status="running", attempt=(m.get("attempt") or 0) + 1, resumed=now())
        write_json(meta_path, m)
        session_note(m["session_id"], a["id"], "lane", m.get("project"), p["model"])
        outcome, result = run_claude_lane(roster, a, p["model"], prompt, cwd, run_id, m["session_id"], True, log, name="lane-" + (m.get("name") or run_id))
        if outcome == "wall":
            tried.append(a["id"])
            prompt = "Continue where you left off." + REPORT_SUFFIX
            continue
        if outcome == "stopped":
            m.update(status="stopped", ended=now(), stopped_by="safety classifier")
            write_json(meta_path, m)
            print("lane %s · stopped by a safety classifier; John names its next model" % ref)
            lane_end_sweep(roster, m)
            return 4
        gate_note = ""
        if outcome == "done" and m.get("class") not in REPORT_ONLY and not m.get("hazard") and gate_cmd(cwd):
            outcome, result, gate_note = gate_after(roster, m, cwd, run_id, result)
        m.update(status=outcome, ended=now(), result=(result or "")[-20000:])
        write_json(meta_path, m)
        print("lane %s · %s · %s · resumed · %s · %s%s" % (m.get("name") or run_id, a["id"], p["model"], outcome, fmt_dur(now() - started), gate_note))
        print(report_of(result, cap=12) if m.get("hazard") else report_of(result))
        lane_end_sweep(roster, m)
        return 0 if outcome == "done" else 1
    print("lane %s · walled on %s" % (ref, ", ".join(tried)))
    return 3


def cmd_runs(args):
    """cca runs [--project P] [--open] [--fleet] [--json] | --show <name|id>: the lanes, newest first. A lane's record outlives
    the captain that fired it: a restarted captain re-orients from here, not from memory."""
    o = flags(args, ["--show", "--limit", "--project", "--resume", "--host"])
    roster = load_roster()
    if o.get("--host") and o["--host"] != this_host(roster):    # one host's lanes; exit 3 when it cannot be asked (never "none")
        h = roster["hosts"].get(o["--host"]) or {}
        if not h.get("ssh"):
            print("cca runs: no ssh alias for host %s" % o["--host"], file=sys.stderr)
            return 3
        try:
            p = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=6", h["ssh"], rq(roster["settings"]["peer_cca"]) + " runs --json"],
                               capture_output=True, text=True, timeout=30)
            rows = json.loads(p.stdout) if p.returncode == 0 else None
        except Exception as e:
            print("cca runs: %s could not be asked (%s)" % (o["--host"], str(e)[:80]), file=sys.stderr)
            return 3
        if not isinstance(rows, list):
            print("cca runs: %s could not be asked (exit %d)" % (o["--host"], p.returncode), file=sys.stderr)
            return 3
        rows = [m for m in rows if m.get("host") == o["--host"]]
        print(json.dumps(rows, default=str) if "--json" in args else "\n".join("%-14s %-8s %s" % ((m.get("name") or m["id"])[:14], m.get("status"), m.get("account") or "-") for m in rows))
        return 0
    if o.get("--resume"):
        return run_resume(roster, o["--resume"])
    if o.get("--show"):
        m = find_run(o["--show"])
        if not m:
            print("no run %s" % o["--show"])
            return 1
        print(json.dumps({k: v for k, v in m.items() if k != "result"}, indent=1))
        print(m.get("result") or "")
        return 0
    metas = run_metas()
    if "--fleet" in args:
        for alias, h in roster["hosts"].items():
            if alias == this_host(roster) or not h.get("ssh"):
                continue
            try:
                out = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=6", h["ssh"], rq(roster["settings"]["peer_cca"]) + " runs --json"],
                                     capture_output=True, text=True, timeout=20).stdout
                metas += [m for m in json.loads(out) if m.get("host") == alias]
            except Exception as e:
                print("(%s unreachable: %s)" % (alias, str(e)[:60]), file=sys.stderr)
    swept = 0
    for m in metas:
        if m.get("status") != "running" or m.get("host") != this_host(roster):
            continue
        m["gone"] = bool(m.get("pid")) and not pid_alive(m["pid"])     # its wrapper is gone: shown so, written only by --sweep below
        if not leases_alive(m):
            m["status"] = "lost"            # its process is gone (a captain ended, a disk filled, a kill): shown as lost
            if "--sweep" in args:           # and written so, on the owner's word; cca runs --resume picks a Claude lane up
                m.setdefault("ended", now())
                write_json(os.path.join(RUNS, m["id"] + ".json"), m)
                swept += 1
    if "--sweep" in args:
        print("%d running row(s) with no live process marked lost" % swept)
    if o.get("--project"):
        metas = [m for m in metas if m.get("project") == o["--project"]]
    if o.get("--host"):
        metas = [m for m in metas if m.get("host") == o["--host"]]
    if "--open" in args:
        metas = [m for m in metas if m.get("status") in ("running", "blocked", "walled", "lost", "error", "stopped")]
    metas.sort(key=lambda m: -m.get("started", 0))
    if "--json" in args:
        print(json.dumps(metas, default=str))
        return 0
    print("%-14s %-8s %-26s %-6s %-5s %-7s %-22s %s" % ("lane", "status", "account", "class", "host", "took", "branch", "report (first line) / task"))
    for m in metas[:int(o.get("--limit") or 40)]:
        took = fmt_dur((m.get("ended") or now()) - m.get("started", now()))
        first = next((l.strip() for l in (m.get("result") or "").split("\n") if l.strip().startswith(("STATUS", "REPORT"))), "") or (m.get("task") or "")[:60].replace("\n", " ")
        print("%-14s %-8s %-26s %-6s %-5s %-7s %-22s %s" % ((m.get("name") or m["id"])[:14], "gone" if m.get("gone") else m.get("status"), (m.get("account") or "-")[:26], (m.get("class") or "-")[:6],
              (m.get("host") or "")[:5], took, ("lane/" + m["worktree"]) if m.get("worktree") else (("$%.3f" % m["cost_usd"]) if m.get("cost_usd") is not None else "-"), first[:70]))
    return 0


def leases_alive(m):
    return any(l.get("run") == m["id"] for l in leases_of(m.get("account") or ""))


# ----------------------------------------------------------------------------- captains

def captain_state_path(project):
    return os.path.join(CAPTAINS, project + ".json")


def transcript_of(session_id):
    hits = glob.glob(os.path.join(PRIMARY, "projects", "*", session_id + ".jsonl"))
    return max(hits, key=os.path.getmtime) if hits else None


def transcript_tail_says(session_id, pattern, kinds=("assistant", "system"), nbytes=200000):
    """Whether the transcript's LAST assistant or system line is a limit notice: a short line matching the pattern.
    A captain's own prose about rate limits (a long message) does not count, nor does a tool result quoting one."""
    p = transcript_of(session_id)
    if not p:
        return False
    try:
        with open(p, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - nbytes))
            lines = f.read().decode("utf-8", "replace").split("\n")
    except Exception:
        return False
    for line in reversed(lines[-80:]):
        if not line.strip():
            continue
        try:
            e = json.loads(line)
        except Exception:
            continue
        if e.get("type") not in kinds:
            continue
        c = (e.get("message") or {}).get("content")
        text = c if isinstance(c, str) else " ".join(x.get("text", "") for x in (c or []) if isinstance(x, dict) and x.get("type") == "text")
        text = (text or e.get("content") or "").strip()
        return bool(text) and len(text) < 400 and bool(pattern.search(text))
    return False

def captain_process(pid, project):
    """True only for a claude this tool launched as this project's captain (its launch line carries --name captain-<project>)."""
    try:
        cmd = subprocess.run(["ps", "-o", "command=", "-p", str(int(pid))], capture_output=True, text=True, timeout=3).stdout
    except Exception:
        return False
    return ("--name captain-" + project) in cmd and "bg-spare" not in cmd


def captain_opening(project, root, note="", extra=""):
    inv = os.path.join(CAPTAINS, project + ".inventory.md")
    if os.path.exists(inv):
        note += "A read-only inventory of this project's state is at %s. " % inv
    return (note + "You are the captain of %s (cca). Read CLAUDE.md, the inventory if named above, then docs/CAPTAIN.md and HANDOFF.md if they exist. "
            "Then say in at most ten lines where the project stands: the last landed work, what is in flight or unmerged, what is blocked and on what. "
            "Then stop and wait. John names the work; you propose nothing and start nothing until he does. "
            "When he does: lanes are `cca run --name <LANE> --class code|review|design|proof [--worktree <LANE>] \"task\"` from this folder as background commands, "
            "about ten at a time; Claude Code wakes you when one ends; read its REPORT, never its transcript. Their records outlive you: `cca runs --project %s --open` "
            "is the wave's state, re-orient from it and HANDOFF.md after any restart. Keep HANDOFF.md current at every milestone. The pool: `cca status`. "
            "A lane names an account, a provider or a model only when the owner says so (`--account A`, `--provider codex`, `--model M`); otherwise "
            "`cca run` spends the week that expires soonest by itself (rule 7). 'Expiring' means the week reset, never the 5-hour window, "
            "which refills on its own. Review checkouts and CARGO_TARGET_DIR go under $TMPDIR or %s (both on the lane volume), "
            "never a literal /tmp or /private/tmp path, which lands on the internal disk (rule 23). " % (project, project, os.path.join(WORKSPACE, "targets")) + lane_scratch_note(project)
            + ((" " + extra.strip()) if extra else ""))


def assign_captain_account(roster, project, exclude=(), dry=False):
    """The account the project's captain runs on: its own, else the pool account with the most Fable, which becomes its own."""
    st = read_json(captain_state_path(project)) or {}
    mine = [a for a in roster["accounts"] if captain_of(a) == project and a["id"] not in exclude]           # the role-holder first
    mine += [a for a in roster["accounts"] if a["id"] == st.get("account") and a not in mine and a["id"] not in exclude]
    if mine:
        refresh_stale(roster, this_host(roster), roster["settings"]["read_age_launch"], only=[mine[0]["id"]])
        L = left_of(mine[0], roster)
        if (L["fable_pts"] is None or L["fable_pts"] > roster["settings"]["margin_fable"]) and not (L["five"] and L["five"]["left"] <= roster["settings"]["margin_five"]):
            return mine[0], "its own account"
        exclude = tuple(exclude) + (mine[0]["id"],)
    occupied = tuple(a["id"] for a in roster["accounts"] if any(l.get("kind") in ("own", "captain") for l in leases_of(a["id"])))
    floor = roster["settings"].get("captain_min_fable", 15.0)
    p = pick(roster, job_class="plan", model=FABLE, exclude=tuple(exclude) + occupied, min_left=floor)
    if "account" in p:
        p["ranked"].sort(key=lambda r: (not r["ok"], len(leases_of(r["id"])), -(r["left"] or 0), r["resets_in"] if r["resets_in"] is not None else float("inf")))
        best = p["ranked"][0]
        p["account"] = best["id"]
        p["why"] = "%s: the richest idle Fable half, %.0f pts" % (best["id"], best["left"])
    else:
        # no free account has Fable: double up on the captain's account with the most Fable left (John's rule, 2026-10-08)
        rows = [left_of(a, roster) for a in roster["accounts"] if a.get("provider", "claude") == "claude" and on_host(a, this_host(roster)) and a["id"] not in exclude]
        rows = [r for r in rows if (r.get("fable_pts") or 0) >= floor and not (r["five"] and r["five"]["left"] <= roster["settings"]["margin_five"])
                and not any(l.get("kind") == "own" for l in r["leases"])]
        if not rows:
            return None, p["error"]
        best = max(rows, key=lambda r: r["fable_pts"])
        p = {"account": best["id"], "why": "shared with %s (%.0f Fable pts left; no free account had %.0f)" % (best["role"].replace("captain:", ""), best["fable_pts"], floor)}
    a = account(roster, p["account"])
    if dry:
        return a, "would be assigned (" + p["why"] + ")"
    for b in roster["accounts"]:
        if captain_of(b) == project:
            b["role"] = "pool"
    if role_of(a) == "pool":
        a["role"] = "captain:" + project
    save_roster(roster)
    roster_push(roster)
    return a, "assigned (" + p["why"] + ")"


def effort_for(model, effort):
    """The effort a Claude launch goes out at: what was asked, except max on a model the owner ruled it out for (NO_MAX),
    which goes at xhigh and says so in one line. A captain and a lane both pass through here, so no launch line, roster
    setting or habit reaches such a model at max."""
    if effort == "max" and (model or "").split("[")[0] in NO_MAX:
        print("effort: max is never used on %s (the owner's word, 2026-11-09); this launch goes at xhigh" % (model or "").split("[")[0], file=sys.stderr)
        return "xhigh"
    return effort


def captain_cmd(model, name, effort):
    """The captain's launch line: named, so another session can message it, and at the owner's effort (xhigh by default
    since 2026-11-09; max from 2026-10-26 until the owner ruled it out for Fable 5.2; only a launch flag reaches a
    resumed session)."""
    return [claude_bin(), "--model", model, "--dangerously-skip-permissions", "--name", "captain-" + name, "--effort", effort]


def cmd_captain(args):
    o = flags(args, ["--model", "--account", "--project", "--note", "--effort"])
    rest = o["_"]
    if rest and rest[0] == "start":          # the old kit's verb; `cca captain start [project]` is `cca captain [project]`
        rest = rest[1:]
    sub = rest[0] if rest and rest[0] in ("stop", "list", "status") else None
    roster = load_roster()
    if sub == "list" or sub == "status":
        for p in glob.glob(os.path.join(CAPTAINS, "*.json")):
            s = read_json(p) or {}
            if not s.get("project"):
                continue            # a captain's own file kept here (the spec's security watch), not a captain's state
            live = any(l.get("kind") == "captain" and l.get("project") == s.get("project") and pid_alive(l.get("pid")) for l in leases_of(s.get("account") or ""))
            print("%-20s %-28s %-36s %s" % (s.get("project"), s.get("account"), s.get("session_id"), "live" if live else (s.get("last_exit") or "stopped")))
        return 0
    if sub == "stop":
        project = rest[1] if len(rest) > 1 else None
        s = read_json(captain_state_path(project or "")) or {}
        if not s:
            print("no captain %s" % project)
            return 1
        write_json(captain_state_path(project), dict(s, stop=True))
        for l in leases_of(s.get("account") or ""):
            if l.get("kind") == "captain" and l.get("project") == project and pid_alive(l.get("pid")):
                os.kill(int(l["pid"]), signal.SIGTERM)
        print("captain %s: stop asked" % project)
        return 0
    name = o.get("--project") or (rest[0] if rest else None)
    if name and "@" in name and account(roster, name) and not o.get("--account"):
        o["--account"], name = name, None          # `cca captain <email>` names the account, not a project
    root = None
    if name and os.path.isdir(expand(name)):
        root = os.path.realpath(expand(name))
        name = os.path.basename(root)
    if not name:
        root = git_root(os.getcwd()) or os.getcwd()
        name = os.path.basename(root)
    if root:
        name = next((n for n, pr in roster["projects"].items() if os.path.realpath(expand(pr["root"])) == os.path.realpath(root)), name)
    if name not in roster["projects"]:
        root = root or os.getcwd()
        roster["projects"][name] = {"root": root}
        save_roster(roster)
        print("project %s registered at %s" % (name, root))
    root = project_root(roster, name)
    model = model_id(o.get("--model")) or FABLE
    effort = effort_for(model, o.get("--effort") or roster["settings"].get("captain_effort") or "xhigh")   # xhigh unless the launch line says otherwise; never max on Fable 5.2
    if not is_fable(model):
        print("captain %s on %s: a captain is Fable by the rules; you asked for %s, so be it" % (name, root, model))
    st_path = captain_state_path(name)
    state = read_json(st_path) or {"project": name}
    state.pop("stop", None)
    if "--dry" not in args:
        live = [(b["id"], l) for b in roster["accounts"] for l in leases_of(b["id"])
                if l.get("kind") == "captain" and l.get("project") == name and pid_alive(l.get("pid"))]
        if live and "--force" not in args:
            print("captain %s is already open on %s (pid %s): use that window, end it there with Ctrl-D, or `cca captain %s --force` to take it over here"
                  % (name, live[0][0], live[0][1]["pid"], name), file=sys.stderr)
            return 1
        if live:
            state["owner_pid"] = os.getpid()                 # written BEFORE anything ends: a superseded loop sees it and never relaunches
            write_json(st_path, state)
            for acct, l in live:
                if not captain_process(l.get("pid"), name):
                    continue                                 # only a claude this tool launched for this captain, never a spare or a lane
                try:
                    os.kill(int(l["pid"]), signal.SIGTERM)
                    print("captain %s: ending the copy on %s (pid %s)" % (name, acct, l["pid"]), file=sys.stderr)
                except Exception:
                    pass
            for _ in range(40):
                time.sleep(0.5)
                if not any(pid_alive(l.get("pid")) for _, l in live if captain_process(l.get("pid"), name)):
                    break
            time.sleep(1.5)
    if o.get("--account"):
        a = account(roster, o["--account"])
        if not a:
            print("no account %s" % o["--account"], file=sys.stderr)
            return 2
        if "--dry" in args:
            print("captain %s would open on %s (named) in %s" % (name, a["id"], root))
            return 0
        for b in roster["accounts"]:
            if captain_of(b) == name:
                b["role"] = "pool"
        a["role"] = "captain:" + name
        save_roster(roster)
        roster_push(roster)
        state["account"] = a["id"]               # the named account wins over whatever the state remembered
        write_json(st_path, state)
    note = ""
    resume_id = None if "--fresh" in args else state.get("session_id")
    failures = 0
    if "--dry" in args:
        a, why = assign_captain_account(load_roster(), name, dry=True)
        print("captain %s would open on %s (%s) in %s%s" % (name, a["id"] if a else "nothing", why, root, (" resuming " + resume_id[:8]) if resume_id else " fresh"))
        return 0 if a else 3
    low = disk_floor(roster, name, root, launch=False)
    if low:
        print("captain %s: %s" % (name, low), file=sys.stderr)
    resume_note = (o.get("--note") or "") if resume_id else ""   # a resumed captain hears --note once, as its first message
    while True:
        roster = load_roster()
        a, why = assign_captain_account(roster, name)
        if not a:
            soon = soonest_reset(roster, "claude", this_host(roster), now())
            print("captain %s: no account has Fable for it (%s)%s" % (name, why, ("; soonest reset in " + fmt_dur(soon - now())) if soon else ""))
            return 3
        session_id = resume_id or str(uuid.uuid4())
        state.update(account=a["id"], session_id=session_id, started=now(), model=model, root=root, owner_pid=os.getpid())
        write_json(st_path, state)
        cmd = captain_cmd(model, name, effort)
        cmd += (["--resume", session_id] + ([resume_note] if resume_note else [])) if resume_id else ["--session-id", session_id, captain_opening(name, root, note, o.get("--note") or "")]
        resume_note = ""
        session_note(session_id, a["id"], "captain", name, model)
        print("captain %s → %s (%s)%s" % (name, a["id"], why, " · resuming " + session_id[:8] if resume_id else " · fresh"), file=sys.stderr)
        env = cargo_env(claude_env(a, "captain", project=name, session_id=session_id), root, name, incremental=True)
        try:
            for p in glob.glob(os.path.join(CAPTAINS, name + ".move")):
                os.remove(p)
            rc = subprocess.call(cmd, cwd=root, env=env)
        except KeyboardInterrupt:
            rc = 130
        lease_drop(a["id"], session_id)
        state = read_json(st_path) or state
        if state.get("owner_pid") not in (None, os.getpid()):
            print("captain %s: taken over by another window (pid %s); this one ends" % (name, state["owner_pid"]), file=sys.stderr)
            return 0
        move = read_json(os.path.join(CAPTAINS, name + ".move"))
        others = [l for b in load_roster()["accounts"] for l in leases_of(b["id"])
                  if l.get("kind") == "captain" and l.get("project") == name and pid_alive(l.get("pid")) and captain_process(l.get("pid"), name)]
        if not move and not others:
            roster = load_roster()          # the account goes back to the pool while the captain is down
            for b in roster["accounts"]:
                if captain_of(b) == name:
                    b["role"] = "pool"
            save_roster(roster)
            roster_push(roster)
        if state.get("stop"):
            state.update(last_exit="stopped by cca captain stop", stop=False)
            write_json(st_path, state)
            return 0
        if move:
            # the hook saw a wall at a tool boundary and ended the process: the same conversation, the next account with Fable
            note = ""
            resume_id = session_id
            roster = load_roster()
            for b in roster["accounts"]:
                if b["id"] == a["id"]:
                    b["role"] = "pool"
            save_roster(roster)
            roster_push(roster)
            print("captain %s: %s at the wall (%s); moving" % (name, a["id"], move.get("reason")), file=sys.stderr)
            continue
        if transcript_tail_says(session_id, CLASSIFIER_STOP):
            # a safety stop ends that conversation: a fresh captain from its handoff, the stopped step marked as John's
            when = time.strftime("%Y-%m-%d %H:%M UTC", time.gmtime())
            note = ("Your previous session (%s, %s) was stopped by a safety classifier. Do not retry the step it was on; note it in HANDOFF.md "
                    "as John's to re-frame, and continue with the rest of the plan. " % (session_id[:8], when))
            state.update(last_exit="safety stop " + when, stopped_sessions=(state.get("stopped_sessions") or []) + [session_id])
            write_json(st_path, state)
            resume_id = None
            print("captain %s: safety stop in %s; a fresh captain from the handoff" % (name, session_id[:8]), file=sys.stderr)
            time.sleep(2)
            continue
        if rc == 0:
            state.update(last_exit="ended by John")
            write_json(st_path, state)
            return 0
        failures += 1
        state.update(last_exit="exit %s at %s" % (rc, time.strftime("%H:%M:%S")))
        write_json(st_path, state)
        if failures >= 5:
            print("captain %s: five exits in a row (last rc %s); stopping. `cca captain %s` to try again." % (name, rc, name), file=sys.stderr)
            return rc
        print("captain %s: exit %s; resuming in 5s (Ctrl-C to stop)" % (name, rc), file=sys.stderr)
        try:
            time.sleep(5)
        except KeyboardInterrupt:
            return rc
        resume_id = session_id
        note = ""


# ----------------------------------------------------------------------------- the hook (a captain at its wall)

def cmd_hook(args):
    """PostToolUse and Stop. Inert unless this process sits under a captain; then, at a wall, it ends the captain's Claude
    at this tool boundary and the captain loop resumes the conversation on the next account. A hook never prints into a
    captain: any failure goes to ~/.cca/hook.log with its traceback, and the hook returns as if it had nothing to say."""
    if os.environ.get("CCA_KIND") != "captain":
        return 0
    try:
        return hook_body(args)
    except Exception:
        import traceback
        try:
            os.makedirs(CCA, exist_ok=True)
            with open(os.path.join(CCA, "hook.log"), "a", encoding="utf-8") as f:
                f.write("%s project=%s account=%s cwd=%s\n%s\n" % (datetime.datetime.now().isoformat(timespec="seconds"), os.environ.get("CCA_PROJECT"),
                                                                   os.environ.get("CCA_ACCOUNT"), os.getcwd(), traceback.format_exc()))
        except Exception:
            pass
        return 0


def hook_body(args):
    try:
        data = json.load(sys.stdin)
    except Exception:
        return 0
    if any(k in data for k in ("agent_id", "agent_type", "subagent_id", "parent_tool_use_id")):
        return 0
    sid = data.get("session_id") or ""
    project, ident = os.environ.get("CCA_PROJECT"), os.environ.get("CCA_ACCOUNT")
    if not (sid and project and ident):
        return 0
    roster = load_roster()
    a = account(roster, ident)
    if not a:
        return 0
    s = read_json(sample_path(ident)) or {}
    if is_fable(s.get("model") or FABLE):       # a Fable captain's own figure, read every thirty minutes (a short GET at this tool boundary)
        refresh_stale(roster, this_host(roster), roster["settings"]["read_age_captain"], only=[ident], timeout=5)
        s = read_json(sample_path(ident)) or s
    L = left_of(a, roster)
    reason = None
    if L["five"] and L["five"]["left"] <= 0:
        reason = "5-hour window"
    elif L["week"] and L["week"]["left"] <= 0:
        reason = "week"
    elif is_fable(s.get("model") or FABLE) and L.get("fable_pts") is not None and L["fable_pts"] <= 0:
        reason = "Fable half"
    elif L["fable_five"] and L["fable_five"]["left"] <= 0:
        reason = "Fable 5-hour window"
    elif data.get("hook_event_name") == "Stop" and transcript_tail_says(sid, LIMIT_TEXT, nbytes=8000):
        reason = "limit message in the transcript"
    if not reason:
        return 0
    tid, tpath = data.get("tool_use_id"), data.get("transcript_path")
    if data.get("hook_event_name") == "PostToolUse" and tid and tpath:
        for _ in range(30):     # let this tool's line reach the transcript before the process ends
            try:
                with open(tpath, "rb") as f:
                    f.seek(0, 2)
                    f.seek(max(0, f.tell() - 131072))
                    if tid.encode() in f.read():
                        break
            except Exception:
                break
            time.sleep(0.2)
    pid = os.getppid()
    for _ in range(8):      # the nearest Claude ancestor is this hook's own session
        try:
            out = subprocess.run(["ps", "-o", "ppid=,comm=", "-p", str(pid)], capture_output=True, text=True, timeout=2).stdout.split(None, 1)
        except Exception:
            return 0
        if not out:
            return 0
        comm = os.path.basename(out[1].strip()) if len(out) > 1 else ""
        if comm == "claude" or re.match(r"^\d+\.\d+\.\d+", comm):
            break
        pid = int(out[0])
        if pid <= 1:
            return 0
    else:
        return 0
    write_json(os.path.join(CAPTAINS, project + ".move"), {"reason": reason, "at": now(), "session_id": sid, "from": ident})
    try:
        os.kill(pid, signal.SIGTERM)
    except Exception:
        pass
    return 0


# ----------------------------------------------------------------------------- John's own sessions

def cmd_claude(args):
    """cca claude [--class C] [--model M] [--account A] [claude args...]: an interactive session on the pool account the picker chooses."""
    o = flags(args, ["--class", "--model", "--account", "--name"])
    roster = load_roster()
    p = pick(roster, job_class=o.get("--class"), model=o.get("--model"), provider="claude", want=o.get("--account"))
    if "account" not in p:
        print("cca: " + p["error"], file=sys.stderr)
        return 3
    a = account(roster, p["account"])
    cmd = [claude_bin(), "--dangerously-skip-permissions"]
    if o.get("--model") or o.get("--class"):
        cmd += ["--model", p["model"]]
    if o.get("--name"):
        cmd += ["--name", o["--name"]]
    cmd += o["_"]
    print("→ %s (%s)" % (a["id"], p["why"]), file=sys.stderr)
    os.execve(cmd[0], cmd, claude_env(a, "own"))


# ----------------------------------------------------------------------------- the roster's commands

def cmd_add(args):
    o = flags(args, ["--provider", "--host"])
    roster = load_roster()
    for ident in o["_"]:
        prov = o.get("--provider") or ("codex" if "@" not in ident else "claude")
        host = o.get("--host") or this_host(roster)
        a = account(roster, ident) if (account(roster, ident) or {}).get("id") == ident else None
        if a:
            if host not in (a.get("hosts") or []):
                a.setdefault("hosts", []).append(host)
                print("%s: also on %s" % (ident, host))
            else:
                print("%s already in the roster on %s" % (ident, host))
            continue
        a = {"id": ident, "provider": prov, "hosts": [host], "role": "pool"}
        if host == this_host(roster):
            if prov == "claude":
                make_profile(os.path.join(PROFILES, ident), ident)
            else:
                home = os.path.join(CODEX_PROFILES, ident)
                os.makedirs(home, exist_ok=True)
                src = os.path.join(HOME, ".codex", "config.toml")
                if os.path.exists(src) and not os.path.exists(os.path.join(home, "config.toml")):
                    shutil.copy(src, home)
        roster["accounts"].append(a)
        print("added %s (%s on %s); next: cca login %s" % (ident, prov, host, ident))
    save_roster(roster)
    roster_push(roster)
    return 0


CHROME_LOCAL_STATE = os.path.join(HOME, "Library", "Application Support", "Google", "Chrome", "Local State")
OPEN_SHIM = """#!/bin/zsh
# cca login puts this directory first on PATH with CCA_CHROME_PROFILE set; Claude Code opens its sign-in URL with
# `open <url>`, and this routes it into that Chrome profile through Chrome's binary (open --args does not switch
# profiles once Chrome runs). Anything else goes to /usr/bin/open.
_chrome="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
_url=""
for a in "$@"; do case "$a" in http://*|https://*) _url="$a";; esac; done
if [[ -n "$CCA_CHROME_PROFILE" && -n "$_url" && -x "$_chrome" ]]; then
  ("$_chrome" --profile-directory="$CCA_CHROME_PROFILE" "$_url" >/dev/null 2>&1 &)
  exit 0
fi
exec /usr/bin/open "$@"
"""


def chrome_profiles(local_state=None):
    """[(profile dir, display name, Google account)] from Chrome's Local State, or [] without Chrome."""
    st = read_json(local_state or CHROME_LOCAL_STATE) or {}
    info = (st.get("profile") or {}).get("info_cache") or {}
    return sorted([(k, v.get("name") or k, v.get("user_name") or "") for k, v in info.items()], key=lambda r: (len(r[0]), r[0]))


def chrome_profile_for(email, local_state=None):
    """The Chrome profile for an account: the one signed into Google as that email, else the one named after it."""
    rows = chrome_profiles(local_state)
    for pdir, name, acct in rows:
        if acct.lower() == email.lower():
            return pdir, name
    for pdir, name, acct in rows:
        if name.lower() == email.lower():
            return pdir, name
    return None


def open_shim_dir():
    """A directory holding the `open` shim, written fresh each time."""
    d = os.path.join(CCA, "open-shim")
    os.makedirs(d, exist_ok=True)
    p = os.path.join(d, "open")
    open(p, "w").write(OPEN_SHIM)
    os.chmod(p, 0o755)
    return d


def login_record(roster, a, host):
    """The roster learns that the account is signed in on the host. True when that is news."""
    if host in (a.get("hosts") or []):
        return False
    a.setdefault("hosts", []).append(host)
    save_roster(roster)
    return True


def cmd_login(args):
    o = flags(args, ["--host", "--browser"])
    roster = load_roster()
    ident = o["_"][0] if o["_"] else None
    a = account(roster, ident or "")
    if not a:
        print("usage: cca login <account>  (cca add first)", file=sys.stderr)
        return 2
    host = o.get("--host") or this_host(roster)
    if host != this_host(roster):
        h = roster["hosts"].get(host) or {}
        rc = subprocess.call(["ssh", "-t", h.get("ssh") or host, rq(roster["settings"]["peer_cca"]) + " login " + a["id"]])
        if rc == 0 and login_record(roster, a, host):
            roster_push(roster)              # the peer's own roster learned the host too, but it cannot push here, and the
        return rc                            # next push from this machine would have dropped it again (2026-10-26, 6 accounts)
    login_record(roster, a, host)
    if a.get("provider") == "codex":
        os.execve(codex_bin(), [codex_bin(), "login"], dict(os.environ, CODEX_HOME=codex_home(a)))
    make_profile(profile_dir(a), a["id"])
    env = claude_env(a, "login")
    prof = (o["--browser"], o["--browser"]) if o.get("--browser") else chrome_profile_for(a["id"])
    if prof:
        env["PATH"] = open_shim_dir() + os.pathsep + env.get("PATH", "")
        env["CCA_CHROME_PROFILE"] = prof[0]
        print("sign in as %s in the Chrome window that opens (profile %s, %s)" % (a["id"], prof[0], prof[1]))
    else:
        print("sign in as %s in the browser that opens (no Chrome profile carries that email; `cca login %s --browser 'Profile N'` names one)" % (a["id"], a["id"]))
    os.execve(claude_bin(), [claude_bin(), "auth", "login", "--email", a["id"]], env)


def cmd_role(args):
    roster = load_roster()
    if len(args) < 2:
        print("usage: cca role <account> pool|captain:<project>", file=sys.stderr)
        return 2
    a = account(roster, args[0])
    if not a:
        print("no account %s" % args[0], file=sys.stderr)
        return 1
    a["role"] = args[1]
    save_roster(roster)
    roster_push(roster)
    print("%s: %s" % (a["id"], a["role"]))
    return 0


def cmd_project(args):
    roster = load_roster()
    if args[:1] == ["add"] and len(args) >= 3:
        roster["projects"][args[1]] = {"root": os.path.realpath(expand(args[2]))}
        save_roster(roster)
        roster_push(roster)
    for name, p in roster["projects"].items():
        cap = [a["id"] for a in roster["accounts"] if captain_of(a) == name]
        print("%-20s %-40s captain on %s" % (name, p["root"], ", ".join(cap) or "(none yet)"))
    return 0


# ----------------------------------------------------------------------------- install, deploy, doctor, selftest

def cmd_install(args):
    """Point Claude Code's shared settings at this tool (statusLine, the captain hook) and PATH at bin/."""
    sp = os.path.join(PRIMARY, "settings.json")
    s = read_json(sp) or {}
    if os.path.exists(sp):
        shutil.copy(sp, sp + ".before-cca-install")
    me = os.path.join(HERE, "cca")
    s["statusLine"] = {"type": "command", "command": me + " statusline", "padding": 0}
    s["hooks"] = {ev: [{"matcher": "", "hooks": [{"type": "command", "command": me + " hook", "timeout": 10}]}] if ev == "PostToolUse"
                  else [{"hooks": [{"type": "command", "command": me + " hook", "timeout": 10}]}] for ev in ("PostToolUse", "Stop")}
    write_json(sp, s)
    for d in (SAMPLES, LEASES, RUNS, CAPTAINS):
        os.makedirs(d, exist_ok=True)
    zshrc = os.path.join(HOME, ".zshrc")
    line = 'export PATH="%s:$PATH"  # cca' % (HERE.replace(HOME, "$HOME", 1) if HERE.startswith(HOME + os.sep) else HERE)
    try:
        txt = open(zshrc).read() if os.path.exists(zshrc) else ""
        if line not in txt:
            open(zshrc, "a").write("\n" + line + "\n")
    except Exception:
        pass
    n = share_sessions(load_roster())
    print("installed: statusLine and hook → %s; PATH line in ~/.zshrc; state under %s%s" % (me, CCA, ("; %d profile(s) now share the session registry" % n) if n else ""))
    return 0


def rq(path):
    """A remote path as one shell word. A leading ~ is the remote shell's HOME (not this machine's), the rest is quoted: a space,
    a quote or a $ in it stays text."""
    if path == "~":
        return '"$HOME"'
    if path.startswith("~/"):
        return '"$HOME"' + shlex.quote(path[1:])
    return shlex.quote(path)


def scp_path(path):
    """The same path for scp: one relative to the remote home stays relative, so no tilde or quote rides through scp."""
    return path[2:] if path.startswith("~/") else path


DEPLOY_LOCK_WAIT = 40        # seconds a deploy waits for another deploy's lock on the peer before it refuses
DEPLOY_LOCK_GRACE = 1        # minutes a lock folder with no since file may be young: its holder is between mkdir and the write of since
DEPLOY_LOCK_LEASE = 900      # seconds after which a lock is a dead deploy's (longer than the sum of every step's timeout)
DEPLOY_UNDO_WAIT = 40        # seconds the undo waits for a step still running on the peer before it refuses to touch the finals
DEPLOY_LOCK = "~/.cca/deploy.lock"


def deploy_lock_word():
    return "LK=%s" % rq(DEPLOY_LOCK)


def deploy_who(pid=None):
    """The lock's owner: the deployer's hostname and pid, host:pid (two deployers on two machines can share a pid). A string passes as it is."""
    if isinstance(pid, str):
        return pid
    return "%s:%d" % (re.sub(r"[^A-Za-z0-9_-]", "-", platform.node().split(".")[0]) or "host", os.getpid() if pid is None else pid)


def deploy_tag(pid):
    """The owner as it rides in file names (temps, backups, markers): host-pid, no colon for scp or a path to trip on."""
    return deploy_who(pid).replace(":", "-")


def deploy_prep_cmd(dest, finals, alias, pid):
    """The script of the step before any copy (sent to `sh -s` on stdin, so no login shell reads a quote): the folders made; the
    deploy lock taken (one deploy at a time per peer: a second waits DEPLOY_LOCK_WAIT seconds, then refuses saying who holds it and
    for how long; a lock older than DEPLOY_LOCK_LEASE is a dead deploy's and is taken over); then what an ssh that dropped on an earlier deploy
    left: .NAME.new.PID temps are removed, an unfinished NAME.bak.PID.part is removed, and a completed NAME.bak.PID is never removed (it can be
    the only copy of the old file): the newest is put back when its final is missing, every other one is renamed to NAME.kept.PID (a counter
    on the end when that name is taken, nothing is overwritten), which no deploy sweeps; each one found is said."""
    who, tag = deploy_who(pid), deploy_tag(pid)
    # the takeover (the shell function `takeover`) is one rename to a name of this taker's own (mv fails for every taker but one), then
    # the renamed folder is read and compared with the owner and since this taker read before the rename: the same pair is the stale lock
    # (removed); any other is a lock a deploy made between the look and the rename, and it goes back (mkdir $LK, then its files moved in, so a
    # folder remade meanwhile is never nested into; when the mkdir fails this taker's copy is removed); a prep whose owner or since write fails exits 1, so one winner holds in every interleaving
    # an empty owner or an empty since never matches by itself: such a folder (a holder between its mkdir and its writes, or a dead empty one) is taken over only
    # past DEPLOY_LOCK_GRACE minutes, and removed only when the renamed folder is itself past the grace (a brand-new lock that took the name between the look and the
    # rename is young, so it goes back); a garbage since counts as empty (checked as digits before any arithmetic); the renamed folder is never removed when its owner
    # is non-empty and not the one this taker read, nor when it is empty and younger than the grace (a live lock moved away is kept as $X and said, never deleted)
    takeover = ('takeover() { X="$LK.stale.' + tag + '.$$"; if mv "$LK" "$X" 2>/dev/null; then o2=$(cat "$X/owner" 2>/dev/null); s2=$(cat "$X/since" 2>/dev/null); '
                'case "$s2" in ""|*[!0-9]*) s2=;; esac; old=; [ -n "$(find "$X" -maxdepth 0 -mmin +' + str(DEPLOY_LOCK_GRACE) + ' 2>/dev/null)" ] && old=1; '
                'drop() { if [ -n "$o2" ] && [ "$o2" != "$o" ]; then echo "takeover: the folder this taker moved holds another deployer\'s lock; kept at $X, not removed" >&2; elif [ -z "$o2" ] && [ -z "$old" ]; then echo "takeover: the folder this taker moved is a lock younger than the grace with no owner yet (its holder may be between mkdir and its writes); kept at $X, not removed" >&2; '
                'else echo "$1" >&2; rm -rf "$X"; fi; }; '
                'if [ "$o2" = "$o" ] && [ "$s2" = "$s" ] && { [ -n "$o" ] && [ -n "$s" ] || [ -n "$old" ]; }; then rm -rf "$X"; return 0; '
                'elif [ -e "$LK" ]; then drop "takeover: the lock was remade meanwhile; the folder this taker moved ($X) is removed"; '
                'else if mkdir "$LK" 2>/dev/null; then for f in "$X"/*; do [ -e "$f" ] && mv "$f" "$LK"/; done; rm -rf "$X"; '
                'else drop "takeover: the lock was retaken before it could be put back; the folder this taker moved ($X) is removed"; fi; fi; fi; return 1; }')
    lines = [deploy_lock_word(), "mkdir -p %s %s || exit 1" % (rq(dest + "/bin"), rq("~/.cca")), takeover, "w=0",
             'while :; do mkdir "$LK" 2>/dev/null && break; o=$(cat "$LK/owner" 2>/dev/null); s=$(cat "$LK/since" 2>/dev/null); case "$s" in ""|*[!0-9]*) s=;; esac; now=$(date +%s); w=$((w+1)); '
             'if { [ -n "$s" ] && [ $((now-s)) -gt ' + str(DEPLOY_LOCK_LEASE) + ' ]; } || { [ -z "$s" ] && [ $w -gt 5 ] && [ -n "$(find "$LK" -maxdepth 0 -mmin +' + str(DEPLOY_LOCK_GRACE) + ' 2>/dev/null)" ]; }; then '
             'takeover && continue; fi; '
             'if [ $w -gt ' + str(DEPLOY_LOCK_WAIT) + ' ]; then echo %s"${o:-?}"%s"$((now-${s:-$now}))"%s >&2; exit 75; fi; sleep 1; done'
             % (shlex.quote(alias + ": refused: another deploy (pid "), shlex.quote(" on its machine, lock taken "), shlex.quote("s ago) holds the deploy lock; waited %ds, nothing changed" % DEPLOY_LOCK_WAIT)),
             '{ echo %s > "$LK/owner" && date +%%s > "$LK/since"; } || { echo %s >&2; exit 1; }' % (shlex.quote(who), shlex.quote(alias + ": refused: the deploy lock was taken from this deploy before it wrote its owner; nothing changed"))]
    for f in finals:
        d, n = os.path.split(f)
        lines.append('best=""; for b in %s.bak.*; do [ -e "$b" ] || continue; case "$b" in *.part) continue;; esac; '
                     'if [ -z "$best" ] || [ "$b" -nt "$best" ]; then best=$b; fi; done' % rq(f))
        lines.append('for b in %s.bak.*; do [ -e "$b" ] || continue; case "$b" in *.part) rm -f "$b"; continue;; esac; '
                     'if [ ! -e %s ] && [ "$b" = "$best" ]; then mv -f "$b" %s && echo "found $b; the final was missing, put back"; '
                     'else k0=%s.kept."${b##*.bak.}"; k="$k0"; c=1; while [ -e "$k" ]; do k="$k0.$c"; c=$((c+1)); done; '
                     'mv "$b" "$k" && echo "found $b (the old file of an earlier drop); kept as $k, never swept"; fi; done' % (rq(f), rq(f), rq(f), rq(f)))
        lines.append("rm -f %s*" % rq("%s/.%s.new." % (d, n)))
    return "\n".join(lines) + "\n"


def deploy_release_cmd(parts, pid):
    """Sent after a deploy to one peer, whatever happened: the temps removed, and the lock released only when this deploy owns it."""
    return "\n".join([deploy_lock_word(), "rm -f " + " ".join(rq(t) for t, _ in parts),
                      '[ "$(cat "$LK/owner" 2>/dev/null)" = %s ] && rm -rf "$LK"; exit 0' % shlex.quote(deploy_who(pid))]) + "\n"


def deploy_remote_cmd(dest, parts, alias, pid):
    """The one step run on a peer after its copies landed (parts: [(temp, final)], remote paths with ~ for the remote home), a script
    for `sh -s`. It checks the deploy lock is still this deploy's, writes running.PID in the lock folder, and at its end done.PID
    (deployed | failed | stuck): the undo reads those, not a line that may have been lost.
    Phase 1 backs up each live final (cp -p to NAME.bak.PID.part, then renamed: a NAME.bak.PID is always a complete copy) and notes a
    final it will create (new.N); a failure here changes no final and removes the temps and backups.
    Phase 2 renames the temps over the finals and runs `cca install`; a failure there undoes only what this step did: a final it
    renamed is restored from its completed backup, or removed when this step created it (it had none); a restore that fails keeps
    the backup and says so, never "rolled back". Exit 1 after any failure; on success done.PID says deployed first, then the backups go."""
    n = len(parts)
    who, tag = deploy_who(pid), deploy_tag(pid)
    T = [rq(t) for t, _ in parts]
    F = [rq(f) for _, f in parts]
    B = [rq(f + ".bak." + tag) for _, f in parts]
    a = shlex.quote(alias)
    allt, allb = " ".join(T), " ".join(B)
    L = [deploy_lock_word(), 'place() { mv -f "$1" "$2"; }', 'restore() { mv -f "$1" "$2"; }',
         'fin() { echo "$1" > "$LK/done.%s"; rm -f "$LK/running.%s"; }' % (tag, tag),
         '[ "$(cat "$LK/owner" 2>/dev/null)" = %s ] || { rm -f %s; echo %s >&2; exit 1; }' % (shlex.quote(who), allt, shlex.quote(alias + ": the deploy lock is not this deploy's any more; nothing changed")),
         'echo $$ > "$LK/running.%s"' % tag,
         "chmod +x %s || { rm -f %s; echo %s >&2; fin failed; exit 1; }" % (T[0], allt, shlex.quote(alias + ": failed before any change"))]
    L += ["had%d=0; m%d=0" % (i, i) for i in range(n)]
    for i in range(n):
        L.append("if [ -e %s ]; then cp -p %s %s.part && mv -f %s.part %s && had%d=1 || { rm -f %s %s %s; echo %s >&2; fin failed; exit 1; }; else : > \"$LK/new.%d\"; fi"
                 % (F[i], F[i], B[i], B[i], B[i], i, allb, " ".join(b + ".part" for b in B), allt, shlex.quote(alias + ": backup failed; nothing changed"), i))
    L.append("ok=1")
    for i in range(n):
        L.append(("[ $ok = 1 ] && { place %s %s && m%d=1 || ok=0; }" if i else "place %s %s && m%d=1 || ok=0") % (T[i], F[i], i))
    L.append("[ $ok = 1 ] && { %s/bin/cca install >/dev/null </dev/null || ok=0; }" % rq(dest))
    undo = ["bad=''"]
    for i in range(n):
        undo.append("if [ $m%d = 1 ]; then if [ $had%d = 1 ]; then restore %s %s || bad=\"$bad \"%s; else rm -f %s; fi; else rm -f %s %s; fi" % (i, i, B[i], F[i], B[i], F[i], B[i], T[i]))
    undo.append("if [ -n \"$bad\" ]; then echo %s\"$bad\" >&2; fin stuck; else echo %s >&2; fin failed; fi; exit 1"
                % (shlex.quote(alias + ": rollback FAILED; the old file stays in its backup (mv it over the final by hand):"), shlex.quote(alias + ": rolled back")))
    L.append("if [ $ok = 0 ]; then %s; fi" % "; ".join(undo))
    L.append("fin deployed; rm -f %s; echo %s" % (allb, shlex.quote(alias + ": deployed")))
    return "\n".join(L) + "\n"


def deploy_undo_cmd(parts, alias, pid):
    """Sent after the remote step timed out (parts: [(temp, final)]), a script for `sh -s`. It never runs beside a live step: while
    running.PID names a living process it waits (DEPLOY_UNDO_WAIT s), then refuses and touches nothing (exit 2). Then it reads done.PID
    the step wrote: deployed (the line back was lost, the step is fine: exit 0, backups removed), failed (the step undid itself: exit 1,
    nothing to do), stuck (its own restore failed: exit 2). With no marker the step died part-way: each completed backup NAME.bak.PID
    goes back over its final, a final the step created (new.N) is removed, temps and unfinished backups go; each file it put back or removed
    is named, and it says "undone" only when it did something (exit 1); a restore that fails says so (exit 2)."""
    who, tag = deploy_who(pid), deploy_tag(pid)
    L = [deploy_lock_word(), "w=0",
         '[ "$(cat "$LK/owner" 2>/dev/null)" = %s ] || { echo %s >&2; exit 2; }' % (shlex.quote(who), shlex.quote(alias + ": the deploy lock is not this deploy's any more; nothing undone")),
         'while [ -e "$LK/running.%s" ]; do r=$(cat "$LK/running.%s" 2>/dev/null); kill -0 "$r" 2>/dev/null || break; w=$((w+1)); '
         'if [ $w -gt %d ]; then echo %s"$r"%s >&2; exit 2; fi; sleep 1; done' % (tag, tag, DEPLOY_UNDO_WAIT, shlex.quote(alias + ": the remote step (pid "),
                                                                                    shlex.quote(") is still running; nothing undone (check the peer before the next deploy)")),
         'd=$(cat "$LK/done.%s" 2>/dev/null)' % tag,
         'if [ "$d" = deployed ]; then rm -f %s; echo %s; exit 0; fi' % (" ".join(rq(f + ".bak." + tag) for _, f in parts), shlex.quote(alias + ": the step had finished: deployed (only the line back was lost); nothing undone")),
         'if [ "$d" = failed ]; then echo %s >&2; exit 1; fi' % shlex.quote(alias + ": the step had finished and undone itself; nothing more to undo"),
         'if [ "$d" = stuck ]; then echo %s >&2; exit 2; fi' % shlex.quote(alias + ": the step's own restore failed; the old file stays in its NAME.bak backup (mv it over the final by hand)"),
         "bad=''; did=''"]
    for i, (t, f) in enumerate(parts):
        b = rq(f + ".bak." + tag)
        L.append('if [ -e %s ]; then mv -f %s %s && did="$did "%s || bad="$bad "%s; elif [ -e "$LK/new.%d" ] && [ -e %s ]; then rm -f %s && did="$did "%s; fi; rm -f %s %s.part'
                 % (b, b, rq(f), shlex.quote("restored " + f + ";"), b, i, rq(f), rq(f), shlex.quote("removed " + f + " (the step created it);"), rq(t), b))
    L.append('if [ -n "$bad" ]; then echo %s"$bad" >&2; exit 2; fi' % shlex.quote(alias + ": undo FAILED; the old file stays in its backup (mv it over the final by hand):"))
    L.append('if [ -n "$did" ]; then echo %s"$did" >&2; else echo %s >&2; fi; exit 1' % (shlex.quote(alias + ": undone:"), shlex.quote(alias + ": nothing to undo (the step changed no final)")))
    return "\n".join(L) + "\n"


DEPLOY_SSH = ["-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "-o", "ServerAliveInterval=5", "-o", "ServerAliveCountMax=3"]
DEPLOY_TIMEOUT = {"prep": 60, "scp": 120, "step": 180, "undo": 60}       # seconds a deploy step may take before it is ended


def deploy_call(argv, what, script=None):
    """One ssh or scp of a deploy, ended after DEPLOY_TIMEOUT[what]. A script goes to the peer's `sh -s` on stdin (the login shell
    reads only those two words). Returns (exit code, timed out)."""
    try:
        return subprocess.run(argv, input=script, text=True, timeout=DEPLOY_TIMEOUT[what]).returncode, False
    except subprocess.TimeoutExpired:
        return 124, True


def cmd_deploy(args):
    """Copy bin/cca, RULES.md and the roster to every ssh peer (the owner's command; nothing loops). A peer gets all three
    files or none: non-zero when any peer failed. One deploy at a time per peer (a lock on the peer)."""
    roster = load_roster()
    failed = []
    for alias, h in roster["hosts"].items():
        if alias == this_host(roster) or not h.get("ssh"):
            continue
        dest = os.path.dirname(os.path.dirname(roster["settings"]["peer_cca"]))       # as written (~ is the peer's home), never expanded here
        pid = deploy_who()       # host:pid; the temp names carry host-pid
        tag = deploy_tag(pid)
        finals = ["%s/bin/cca" % dest, "%s/RULES.md" % dest, "~/.cca/accounts.json"]
        parts = [("%s/bin/.cca.new.%s" % (dest, tag), os.path.join(HERE, "cca"), finals[0]),       # each file goes to a temp name, then one remote step renames them all
                 ("%s/.RULES.md.new.%s" % (dest, tag), os.path.join(REPO, "RULES.md"), finals[1]),
                 ("~/.cca/.accounts.json.new.%s" % tag, ROSTER, finals[2])]
        pairs = [(t, f) for t, _, f in parts]
        ssh = ["ssh"] + DEPLOY_SSH + [h["ssh"], "sh -s"]
        rc, hung = deploy_call(ssh, "prep", deploy_prep_cmd(dest, finals, alias, pid))
        sent, keep_lock = 0, rc in (1, 75)       # a refused prep (the folders failed, or another deploy holds the lock) took nothing: no release
        if not rc:
            for tmpname, src, final in parts:
                rc, hung = deploy_call(["scp", "-q"] + DEPLOY_SSH + [src, "%s:%s" % (h["ssh"], scp_path(tmpname))], "scp")
                if rc:
                    break
                sent += 1
        if rc or sent < len(parts):       # a copy failed: nothing is renamed, and no temp file stays behind
            rc = rc or 1
        else:
            rc, hung = deploy_call(ssh, "step", deploy_remote_cmd(dest, pairs, alias, pid))
            if hung:       # the step may be running yet, or have renamed some finals before the line went quiet: the undo reads its markers
                print("%s: the remote step timed out after %ds; checking what it did" % (alias, DEPLOY_TIMEOUT["step"]))
                u, uhung = deploy_call(ssh, "undo", deploy_undo_cmd(pairs, alias, pid))
                if uhung or u == 255:
                    print("%s: the undo could not be run; the peer may hold new files with the old ones in NAME.bak.%s next to them (check before the next deploy)" % (alias, tag))
                    keep_lock = True
                elif u == 2:       # a step still alive, or a restore that failed: the lock stays until its lease ends, no second deploy lands on it
                    keep_lock = True
                elif u == 0:       # the step's own marker says deployed: only the line back was lost
                    rc, hung = 0, False
        if hung and rc == 124:
            rc = "timed out"
        if rc:
            failed.append(alias)
            print("%s: deploy failed (%s)" % (alias, rc))
        if not keep_lock:
            deploy_call(ssh, "undo", deploy_release_cmd(pairs, pid))       # temps off the peer and the lock released
    if failed:
        print("deploy failed on: %s" % ", ".join(failed), file=sys.stderr)
    return 1 if failed else 0


def cmd_refresh(args):
    """cca refresh [--host H | --all] [--account A] [--no-renew]: every Claude account's usage page, now, on the owner's word.
    No token is spent; an expired access token is renewed unless --no-renew (a Claude login by a one-line session,
    a Codex home by a one-word exec)."""
    o = flags(args, ["--host", "--account"])
    roster = load_roster()
    me = this_host(roster)
    hosts = [h for h, x in roster["hosts"].items() if not x.get("no_claude")] if "--all" in args else [o.get("--host") or me]
    rc = 0
    for host in hosts:
        if host != me:
            h = roster["hosts"].get(host) or {}
            if not h.get("ssh"):
                print("%s: no ssh alias" % host)
                rc = 1
                continue
            fwd, skip = [], False
            for x in args:
                if skip:
                    skip = False
                    continue
                if x == "--host":
                    skip = True
                    continue
                if x == "--all" or x.startswith("--host="):
                    continue
                fwd.append(x)
            q = " ".join("'" + x.replace("'", "'\\''") + "'" for x in fwd)
            print("== %s" % host)
            r = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=6", h["ssh"], rq(roster["settings"]["peer_cca"]) + " refresh " + q],
                               capture_output=True, text=True, timeout=600)
            sys.stdout.write(r.stdout or r.stderr)
            rc = rc or r.returncode
            continue
        accts = [a for a in roster["accounts"] if a.get("provider", "claude") in ("claude", "codex") and on_host(a, host)
                 and (not o.get("--account") or a["id"] == (account(roster, o["--account"]) or {}).get("id"))]
        print("== %s: %d logins" % (host, len(accts)))
        results = {}

        def one(a):
            results[a["id"]] = refresh_account(a, renew="--no-renew" not in args, roster=roster)
        threads = [threading.Thread(target=one, args=(a,)) for a in accts]
        for th in threads:
            th.start()
        for th in threads:
            th.join()
        t = now()
        print("%-28s %-34s %-16s %-16s %s" % ("account", "login", "5h window", "week (expires)", "Fable"))
        for a in accts:
            w, note = results.get(a["id"], (None, "?"))
            if w is None:
                print("%-28s %-34s" % (a["id"], "!! " + note))
                rc = 1
                continue
            L = left_of(a, roster, t)
            cell = lambda k: ("%3.0f%% %s" % (L[k]["left"], "↻" + fmt_dur(L[k]["resets_in"]) if L[k]["resets_in"] else "")) if L.get(k) else "-"
            fable = "-" if a.get("provider") == "codex" else "%.0f pts %s" % (L["fable_pts"], ("↻" + fmt_dur(L["fable_week"]["resets_in"])) if L.get("fable_week") and L["fable_week"].get("resets_in") else "")
            print("%-28s %-34s %-16s %-16s %s" % (a["id"], note, cell("five"), cell("week"), fable))
    if any(h != me for h in hosts):
        fleet_pull(roster)
    else:
        samples_push(roster)
    return rc


def cmd_doctor(args):
    roster = load_roster()
    host = this_host(roster)
    bad = 0
    def say(ok, msg):
        nonlocal bad
        bad += 0 if ok else 1
        print(("  ok  " if ok else "  !!  ") + msg)
    print("cca doctor on %s" % host)
    say(os.path.exists(claude_bin()), "claude at %s" % claude_bin())
    say(os.path.exists(codex_bin() or ""), "codex at %s" % codex_bin())
    s = read_json(os.path.join(PRIMARY, "settings.json")) or {}
    say((s.get("statusLine") or {}).get("command", "").startswith(HERE), "settings.json statusLine → this tool")
    say(any("cca hook" in (h.get("command") or "") for ev in (s.get("hooks") or {}).values() for g in ev for h in g.get("hooks", [])), "settings.json hook → this tool")
    say(s.get("model") in (None, "opus", OPUS), "shared default model is %s (never type /model; pass --model)" % s.get("model"))
    for a in roster["accounts"]:
        if not on_host(a, host):
            continue
        L = left_of(a, roster)
        ok = login_ok(a)
        say(ok, "%-28s %-6s %-20s login %s · reading %s" % (a["id"], a.get("provider"), role_of(a), "ok" if ok else "MISSING (cca login %s)" % a["id"],
                                                             ("%s old" % fmt_dur(L["age"])) if L["age"] is not None else "none"))
    old = subprocess.run(["pgrep", "-fl", "claude-accounts/bin/cca"], capture_output=True, text=True).stdout.strip()
    say(not old, "no process of the old tool running" + ((": " + old[:120]) if old else ""))
    for alias, h in roster["hosts"].items():
        if alias == host or not h.get("ssh"):
            continue
        r = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", h["ssh"], "test -x %s && echo yes" % rq(roster["settings"]["peer_cca"])], capture_output=True, text=True)
        say("yes" in r.stdout, "peer %s reachable with cca deployed" % alias)
    print("%d finding(s)" % bad)
    return 1 if bad else 0


# ----------------------------------------------------------------------------- the fleet reading

PRIMITIVE_FNS = re.compile(r"\bfn (sha256d|double_sha256|hash256|hash160|merkle_root|compute_merkle_root|read_varint|write_varint|read_compact_size|write_compact_size|base58_encode|base58check_encode)\b")
STACK_CRATES = ("bsv-rs", "bsv-wallet-toolbox-rs", "bsv-middleware-core", "bsv-middleware-cloudflare", "bsv-middleware-rs", "bsv-tracker", "rust-chaintracks", "bsv-overlay-engine")
READING_SKIP = {"archive", "_archived", "upstream", "ref", "targets", "lean-cache", "worktrees", "node_modules", "target", ".git", ".lake", ".build", ".claude", "vendor", "dist", "build", ".wrangler", "__pycache__"}
LINT_FILES = {"clippy.toml": "clippy", "deny.toml": "deny", "rustfmt.toml": "rustfmt", ".rustfmt.toml": "rustfmt", "biome.json": "biome", "knip.json": "knip", "ruff.toml": "ruff",
              ".pre-commit-config.yaml": "pre-commit", "eslint.config.js": "eslint", "eslint.config.mjs": "eslint", ".eslintrc": "eslint", ".eslintrc.js": "eslint", ".eslintrc.cjs": "eslint", ".eslintrc.json": "eslint"}


def reading_roots(roster):
    """Every checkout the reading walks: the roster's project roots, plus each top-level git repo in the workspace that is not
    an archive, an upstream, a reference copy or a worktree folder."""
    roots = {}
    for name, pr in (roster.get("projects") or {}).items():
        r = expand(pr.get("root") or "")
        if r and os.path.isdir(r):
            roots[os.path.realpath(r)] = name
    base = WORKSPACE
    for n in (sorted(os.listdir(base)) if os.path.isdir(base) else []):
        p = os.path.join(base, n)
        if n.startswith(("wt-", ".")) or n in READING_SKIP or n.endswith(".graphify-out") or "worktrees" in n:
            continue
        if os.path.isdir(os.path.join(p, ".git")):
            roots.setdefault(os.path.realpath(p), n)
        elif os.path.isdir(p):                         # a plain folder of repos: each repo one level down, named by its path
            for m in sorted(os.listdir(p)):
                q = os.path.join(p, m)
                if not m.startswith(".") and m not in READING_SKIP and os.path.isdir(os.path.join(q, ".git")):
                    roots.setdefault(os.path.realpath(q), n + "/" + m)
    return roots


def cargo_sections(path):
    """[(section, name, spec)] for every `name = spec` line of a Cargo.toml, with the section it sits in, plus the package name."""
    out, section, pkg = [], "", None
    try:
        lines = open(path, errors="replace").read().split("\n")
    except Exception:
        return [], None
    for line in lines:
        t = line.strip()
        if t.startswith("["):
            section = t.strip("[]").strip()
            continue
        m = re.match(r'^([A-Za-z0-9_.-]+)\s*=\s*(.+?)\s*$', t)
        if not m:
            continue
        if section == "package" and m.group(1) == "name":
            pkg = m.group(2).strip('"')
        elif section.endswith("dependencies"):
            out.append((section, m.group(1), m.group(2)))
    return out, pkg


def reading_scan(roots, jscpd=True):
    """The fleet reading's facts, read-only: crate names seen in more than one repo, vendored crates, path dependencies that
    leave their repo or point at nothing, each repo's pin of every stack crate, hand-rolled primitives outside bsv-rs, the
    lint files each repo carries, and jscpd's copy-paste figures when the tool is installed."""
    crates, vendored, path_deps, pins, prims, lint = {}, [], [], {}, {}, {}
    for root, name in sorted(roots.items(), key=lambda x: x[1]):
        have = {LINT_FILES[f] for f in LINT_FILES if os.path.exists(os.path.join(root, f))}
        try:
            if os.path.exists(os.path.join(root, "pyproject.toml")) and "[tool.ruff]" in open(os.path.join(root, "pyproject.toml"), errors="replace").read():
                have.add("ruff")
            if os.path.exists(os.path.join(root, "tsconfig.json")) and re.search(r'"strict"\s*:\s*true', open(os.path.join(root, "tsconfig.json"), errors="replace").read()):
                have.add("tsc strict")
        except Exception:
            pass
        if gate_cmd(root):
            have.add("gate")
        if glob.glob(os.path.join(root, ".github", "workflows", "*.y*ml")):
            have.add("workflows")
        lint[name] = sorted(have)
        others = {r for r in roots if r != root}
        catch_all = os.path.realpath(WORKSPACE) == root   # the workspace as a project itself: a hit is named by its own folder, two levels down
        for d, dirs, files in os.walk(root):
            if catch_all:
                rel = os.path.relpath(d, root)
                name = os.path.basename(root) + "/" + "/".join(rel.split(os.sep)[:2]) if rel != "." else os.path.basename(root)
            dirs[:] = [x for x in dirs if os.path.realpath(os.path.join(d, x)) not in others   # a root inside a root is read once, as itself
                       and not x.startswith("wt-") and "worktrees" not in x and not x.endswith(".graphify-out")]
            if "vendor" in dirs:
                for c in sorted(glob.glob(os.path.join(d, "vendor", "*", "Cargo.toml"))):
                    vendored.append((name, os.path.relpath(c, root), cargo_sections(c)[1] or "?"))
            dirs[:] = [x for x in dirs if x not in READING_SKIP and not x.startswith(".")]
            for f in files:
                p = os.path.join(d, f)
                if f == "Cargo.toml":
                    deps, pkg = cargo_sections(p)
                    if pkg:
                        crates.setdefault(pkg, set()).add(name)
                    for section, dn, spec in deps:
                        pm = re.search(r'path\s*=\s*"([^"]+)"', spec)
                        if pm:
                            tgt = os.path.realpath(os.path.join(d, pm.group(1)))
                            if not os.path.isdir(tgt):
                                path_deps.append((name, os.path.relpath(p, root), dn, pm.group(1), "missing"))
                            elif not tgt.startswith(root + os.sep):
                                path_deps.append((name, os.path.relpath(p, root), dn, pm.group(1), "outside"))
                        base = re.search(r'package\s*=\s*"([^"]+)"', spec)
                        real = base.group(1) if base else dn
                        if real in STACK_CRATES:
                            vm = re.search(r'version\s*=\s*"([^"]+)"', spec) or re.match(r'"([^"]+)"', spec)
                            pins.setdefault(real, {}).setdefault(name, set()).add(vm.group(1) if vm else ("path" if pm else ("workspace" if "workspace" in spec else "?")))
                elif f.endswith(".rs") and name != "bsv-rs":
                    try:
                        txt = open(p, errors="replace").read()
                    except Exception:
                        continue
                    for mm in PRIMITIVE_FNS.finditer(txt):
                        prims.setdefault(name, []).append("%s:%d %s" % (os.path.relpath(p, root), txt.count("\n", 0, mm.start()) + 1, mm.group(1)))
    scan = {"roots": {v: k for k, v in roots.items()}, "crates": len(crates), "duplicate_crates": {c: sorted(r) for c, r in crates.items() if len(r) > 1},
            "vendored": vendored, "path_deps": path_deps, "pins": {c: {r: sorted(v) for r, v in rs.items()} for c, rs in pins.items()},
            "primitives": prims, "lint": lint, "jscpd": None}
    if jscpd and shutil.which("jscpd"):
        out = tempfile.mkdtemp(prefix="cca-jscpd-")
        try:
            subprocess.run(["jscpd", "--silent", "--reporters", "json", "--output", out, "--min-tokens", "70", "--format", "rust,typescript,javascript,go,python",
                            "--ignore", "**/target/**,**/node_modules/**,**/vendor/**,**/.lake/**,**/.build/**,**/dist/**,**/.claude/**"] + sorted(roots),
                           capture_output=True, timeout=1800)
            rep_ = read_json(os.path.join(out, "jscpd-report.json")) or {}
            st = (rep_.get("statistics") or {}).get("total") or {}
            dups = rep_.get("duplicates") or []
            pairs = sorted(dups, key=lambda x: -(x.get("lines") or 0))[:25]
            scan["jscpd"] = {"clones": st.get("clones"), "duplicated_lines": st.get("duplicatedLines"), "percentage": st.get("percentage"),
                             "top": [(x.get("lines"), (x.get("firstFile") or {}).get("name"), (x.get("secondFile") or {}).get("name")) for x in pairs]}
        except Exception as e:
            scan["jscpd"] = {"error": str(e)}
    return scan


def reading_page(scan, host):
    """The reading as a page: counts first, then the paths. The shape of the drift reading: nothing to click, nothing to run."""
    L = ["# Fleet reading, %s, on %s" % (datetime.datetime.now().strftime("%Y-%m-%d %H:%M"), host), "",
         "Read-only, from the checkouts cca knows (%d) and every top-level git repo in the workspace but archives, upstreams, references and worktree copies. "
         "Function counts are name matches, a lower bound." % len(scan["roots"]), "",
         "| what | count |", "|---|---|",
         "| crate names seen in more than one repo | %d |" % len(scan["duplicate_crates"]),
         "| vendored crates inside a repo | %d |" % len(scan["vendored"]),
         "| path dependencies leaving a repo or pointing at nothing | %d |" % len(scan["path_deps"]),
         "| repos with hand-rolled primitives outside bsv-rs | %d (%d functions) |" % (len(scan["primitives"]), sum(len(v) for v in scan["primitives"].values())),
         "| repos with no lint file at all | %d of %d |" % (sum(1 for v in scan["lint"].values() if not v), len(scan["lint"]))]
    j = scan.get("jscpd")
    if j and "error" not in j:
        L.append("| jscpd clones (70 tokens or more) | %s, %s lines, %s%% |" % (j.get("clones"), j.get("duplicated_lines"), j.get("percentage")))
    elif j:
        L.append("| jscpd | failed: %s |" % j["error"])
    else:
        L.append("| jscpd | not installed; copy-paste not measured |")
    if scan.get("disk"):
        L += ["| %s | %d, %s |" % (w, c, fmt_gb(k)) for w, c, k in disk_summary(scan["disk"])]
    L += ["", "## Crate names in more than one repo", ""]
    L += ["- `%s`: %s" % (c, ", ".join(r)) for c, r in sorted(scan["duplicate_crates"].items())] or ["none"]
    L += ["", "## Vendored crates", ""]
    L += ["- %s: `%s` (%s)" % v for v in scan["vendored"]] or ["none"]
    L += ["", "## Path dependencies leaving a repo or pointing at nothing", ""]
    L += ["- %s: `%s` %s = `%s` (%s)" % v for v in scan["path_deps"]] or ["none"]
    L += ["", "## Pins of the stack crates", "", "| crate | repo | pin |", "|---|---|---|"]
    for c, rs in sorted(scan["pins"].items()):
        for r, v in sorted(rs.items()):
            L.append("| %s | %s | %s |" % (c, r, ", ".join(v)))
    L += ["", "## Hand-rolled primitives outside bsv-rs", ""]
    for r, hits in sorted(scan["primitives"].items(), key=lambda x: -len(x[1])):
        L.append("- **%s**: %d" % (r, len(hits)))
        L += ["  - `%s`" % h for h in hits[:40]]
        if len(hits) > 40:
            L.append("  - and %d more" % (len(hits) - 40))
    L += ["", "## Lint files per repo", "", "| repo | has |", "|---|---|"]
    L += ["| %s | %s |" % (r, ", ".join(v) or "nothing") for r, v in sorted(scan["lint"].items())]
    if j and j.get("top"):
        L += ["", "## Largest copy-paste pairs (jscpd)", ""]
        L += ["- %s lines: `%s` and `%s`" % t for t in j["top"]]
    return "\n".join(L) + "\n"


# ----------------------------------------------------------------------------- disk: cca disk (rule 23)

def du_many(paths, argv_bytes=64 * 1024):
    """{path: KiB} by du, a few thousand paths per call; a path du cannot read counts 0. One call for everything hit
    "argument list too long" when the volume's tmp held 100k entries (2026-10-26) and every size came back 0."""
    paths = [p for p in paths if os.path.exists(p)]
    out = {p: 0 for p in paths}
    batch, used = [], 0
    for p in paths + [None]:
        if p is None or (batch and used + len(p) + 1 > argv_bytes):
            try:
                r = subprocess.run(["du", "-skx"] + batch, capture_output=True, text=True, timeout=1800)
                for line in r.stdout.split("\n"):
                    parts = line.split("\t", 1)
                    if len(parts) == 2 and parts[0].strip().isdigit():
                        out[parts[1]] = int(parts[0])
            except Exception:
                pass
            batch, used = [], 0
        if p is not None:
            batch.append(p)
            used += len(p) + 1
    return out


def fmt_gb(k):
    return "%.1f GB" % (k / 1048576.0)


def disk_free(volumes=None):
    """[(mount, free GB, size GB)] for the internal disk and the lane volume."""
    out = []
    for p in (volumes or ("/", SCRATCH_VOLUME)):
        if os.path.isdir(p):
            try:
                st = os.statvfs(p)
                out.append((p, st.f_bavail * st.f_frsize / 2.0 ** 30, st.f_blocks * st.f_frsize / 2.0 ** 30))
            except Exception:
                pass
    return out


def disk_scan(roots, tmp_dirs=None, min_k=100 * 1024, age=86400, volume=None, home=None, repos=None, also=None):
    """What fills a disk that the lanes made: cargo target folders inside a checkout (a build that missed the shared
    target dir), lane worktrees with the state of the lane that owns each (running, done, lost, or no record), scratch
    folders under /private/tmp and the volume's tmp older than `age` and over `min_k` that no running lane sits in, and
    entries under the workspace's targets folder and the volume's other *target* folders named for nothing that still exists, less any a
    link resolves into or that holds a git checkout (scan["live"], with the reason). Sizes from du. Read-only.
    `repos` (realpaths of git common dirs) keeps only those repos' worktrees, and then of scratch ("tmp"), Chrome's clones
    ("chrome") and orphan targets ("orphans") only what `also` names: a lane's end reads its own repo, not the volume."""
    volume = SCRATCH_VOLUME if volume is None else volume
    also = set(also if also is not None else (() if repos is not None else ("tmp", "chrome", "orphans")))
    tmp_dirs = (tmp_dirs if tmp_dirs is not None else ["/private/tmp", os.path.join(volume, "tmp")]) if "tmp" in also else []
    scan = {"free": disk_free(), "targets": [], "worktrees": [], "tmp": [], "orphans": [], "chrome": []}
    by_cwd = {}
    for f in glob.glob(os.path.join(RUNS, "*.json")):
        m = read_json(f) or {}
        if m.get("cwd"):
            prev = by_cwd.get(os.path.realpath(m["cwd"]))
            if not prev or (m.get("started") or 0) >= prev[1]:
                by_cwd[os.path.realpath(m["cwd"])] = (m.get("status") or "?", m.get("started") or 0)
    running = [c for c, v in by_cwd.items() if v[0] == "running"]
    targets, worktrees = [], []
    leaves = {r: n for r, n in roots.items() if not any(o != r and o.startswith(r.rstrip(os.sep) + os.sep) for o in roots)}   # a catch-all root (~, the workspace) is walked through its repos, not itself
    for root, name in sorted(leaves.items()):
        for d, dirs, files in os.walk(root):
            if "target" in dirs:
                p = os.path.join(d, "target")
                if not os.path.islink(p) and os.path.exists(os.path.join(p, "CACHEDIR.TAG")):
                    targets.append((name, p))
                dirs.remove("target")
            if os.path.relpath(d, root).count(os.sep) + 1 >= 4:
                dirs[:] = []
            else:
                dirs[:] = [x for x in dirs if not x.startswith(".") and x not in READING_SKIP]
    for p in worktree_dirs(roots, volume):
        if repos is not None and (gitfile_common(p) or git_common(p)) not in repos:   # the .git file first: no git run per folder
            continue
        root = worktree_root(p)
        if root and (repos is None or os.path.join(root, ".git") in repos):
            worktrees.append((roots.get(root) or os.path.basename(root), p, by_cwd.get(os.path.realpath(p), ("no record", 0))[0], root))
    tmp = []
    t = time.time()
    for td in tmp_dirs:
        if not os.path.isdir(td):
            continue
        for n in sorted(os.listdir(td)):
            p = os.path.join(td, n)
            try:
                if not os.path.isdir(p) or os.path.islink(p) or t - os.lstat(p).st_mtime < age:
                    continue
            except Exception:
                continue
            if any(c == p or c.startswith(p + os.sep) for c in running):
                continue
            tmp.append(p)
    home = HOME if home is None else home
    wsdir = workspace(home)
    tdirs = []
    for d in [os.path.join(wsdir, "targets")] + sorted(glob.glob(os.path.join(volume, "*target*"))):
        if os.path.isdir(d) and os.path.realpath(d) not in tdirs:
            tdirs.append(os.path.realpath(d))
    links = target_links(wsdir, tdirs, [p for _, p, _, _ in worktrees])
    lane_targets, live = {}, []
    wt_parents = [x for td in tdirs for x in sorted(glob.glob(os.path.join(td, "*"))) if os.path.isdir(x) and not os.path.islink(x)]
    for _, p, _, root in worktrees:                  # a target named for the lane (2026-10-25: 600 GB of them behind finished lanes) goes with its worktree
        base, repo = os.path.basename(p), os.path.basename(root)
        own = {x: l for x, l in links.items() if not l.startswith(p + os.sep)}
        cands = [os.path.join(td, n) for td in tdirs for n in (base, base + "-lanes", repo + "-" + base)]
        cands += [os.path.join(par, n) for n in sorted(wt_names(p)) for par in wt_parents]     # and its own build folder inside a shared target (checkout_targets)
        for q in cands:
            if os.path.isdir(q) and not os.path.islink(q) and q not in lane_targets.get(p, []):
                why = target_live(q, own, tdirs)
                if why:
                    live.append((q, why))
                else:
                    lane_targets.setdefault(p, []).append(q)
    scan["lane_targets"] = lane_targets
    if "orphans" not in also:
        sizes = du_many([p for _, p in targets] + [p for _, p, _, _ in worktrees] + tmp + sum(lane_targets.values(), []))
        scan.update(live=live, trash=[])
        return disk_scan_sized(scan, targets, worktrees, tmp, [], sizes, min_k, age, t, "chrome" in also)
    known = set()
    for r, n in roots.items():
        known.add(os.path.basename(r))
        known.add(n.split("/")[-1])
    for base in (wsdir, os.path.join(volume, "worktrees")):
        if os.path.isdir(base):
            for n in os.listdir(base):
                known.add(n)
                q = os.path.join(base, n)
                if base.endswith("worktrees") and os.path.isdir(q) and not os.path.isdir(os.path.join(q, ".git")):
                    known.update(os.listdir(q))
    for _, p, _, _ in worktrees:
        known.add(os.path.basename(p))
    orphans = []
    tied = set(sum(lane_targets.values(), [])) | {q for q, _ in live}      # named for a worktree that exists: its, not an orphan
    for td in tdirs:
        for n in sorted(os.listdir(td)):
            p = os.path.join(td, n)
            base = n[:-6] if n.endswith("-lanes") else n
            if base in known or p in tied or os.path.islink(p) or not os.path.isdir(p):
                continue
            why = target_live(p, links, tdirs)
            if why:
                live.append((p, why))
            else:
                orphans.append(p)
    wo, wl = checkout_targets(tdirs, roots, worktrees, running, links)
    orphans += wo
    live += wl
    scan["live"] = live
    days = [os.path.join(trash_dir(volume), n) for n in sorted(os.listdir(trash_dir(volume)))] if os.path.isdir(trash_dir(volume)) else []
    sizes = du_many([p for _, p in targets] + [p for _, p, _, _ in worktrees] + tmp + orphans + days + sum(lane_targets.values(), []))
    scan["trash"] = [(p, sizes.get(p, 0)) for p in days]
    return disk_scan_sized(scan, targets, worktrees, tmp, orphans, sizes, min_k, age, t, "chrome" in also)


def disk_scan_sized(scan, targets, worktrees, tmp, orphans, sizes, min_k, age, t, chrome):
    """A path gone since the size pass (another lane removed it; 2026-10-20, a folder under /private/tmp) is skipped, not fatal."""
    def days(p):
        try:
            return (t - os.lstat(p).st_mtime) / 86400.0
        except OSError:
            return None
    scan["targets"] = sorted([(n, p, sizes.get(p, 0)) for n, p in targets], key=lambda x: -x[2])
    scan["worktrees"] = sorted([(n, p, st, sizes.get(p, 0), r) for n, p, st, r in worktrees], key=lambda x: -x[3])
    scan["lane_targets"] = {p: [(q, sizes.get(q, 0)) for q in qs] for p, qs in scan.get("lane_targets", {}).items()}
    scan["tmp"] = sorted([(p, sizes.get(p, 0), d) for p, d in ((p, days(p)) for p in tmp) if d is not None and sizes.get(p, 0) >= min_k], key=lambda x: -x[1])
    scan["orphans"] = sorted([(p, sizes.get(p, 0), d) for p, d in ((p, days(p)) for p in orphans) if d is not None], key=lambda x: -x[1])
    clones = [p for p, d in ((p, days(p)) for p in (glob.glob(CHROME_CLONES) if chrome else [])) if d is not None and d * 86400 >= age and os.path.isdir(p)]
    csz = du_many(clones)
    scan["chrome"] = sorted([(p, csz.get(p, 0), d) for p, d in ((p, days(p)) for p in clones) if d is not None], key=lambda x: -x[1])
    return scan


WT_TARGET = re.compile(r"^wt-[0-9a-f]{12}$")


def wt_names(p):
    """The wt-<12 hex> names a checkout at or above p builds into: sha256 of its path, as written and resolved, and of the
    folder holding its .git (what one project's parity test hashes: the checkout root, resolved)."""
    q = p
    while q and q != os.path.dirname(q) and not os.path.exists(os.path.join(q, ".git")):
        q = os.path.dirname(q)
    return {"wt-" + hashlib.sha256(x.encode()).hexdigest()[:12] for x in {p, os.path.realpath(p), q, os.path.realpath(q)} if x}


def checkout_targets(tdirs, roots, worktrees, running, links):
    """(orphans, live) among the per-checkout build folders <targets root>/<folder>/wt-<12 hex>. One project's test builds each
    checkout into its own wt-<sha256 of the checkout root>[:12] inside the shared target dir, so a removed worktree leaves
    its folder behind, under a parent named for a project that exists, where the orphan pass never looked (2026-11-15:
    142 of them, 74 GB, in one project's lanes folder). Live: the name is one an existing checkout builds into (every root, every
    worktree git lists for it, every scanned worktree, every running lane's cwd), a link resolves into it, or it holds a
    .git. When git cannot list a root's worktrees, none is called an orphan. disk_clean still asks a day's idleness and no open file."""
    found = []
    for td in tdirs:
        for parent in sorted(glob.glob(os.path.join(td, "*"))):
            if os.path.islink(parent) or not os.path.isdir(parent):
                continue
            try:
                names = sorted(n for n in os.listdir(parent) if WT_TARGET.match(n))
            except OSError:
                continue
            found += [q for q in (os.path.join(parent, n) for n in names) if os.path.isdir(q) and not os.path.islink(q)]
    if not found:
        return [], []
    paths = set(roots) | {p for _, p, _, _ in worktrees} | set(running)
    for r in sorted(roots):
        try:
            g = subprocess.run(["git", "-C", r, "worktree", "list", "--porcelain"], capture_output=True, text=True, timeout=30)
        except Exception:
            return [], []
        if g.returncode != 0 and os.path.exists(os.path.join(r, ".git")):
            return [], []
        paths.update(l[len("worktree "):] for l in g.stdout.splitlines() if l.startswith("worktree "))
    names = set()
    for p in paths:
        names |= wt_names(p)
    orphans, live = [], []
    for q in found:
        if os.path.basename(q) in names:
            continue
        why = target_live(q, links, tdirs)
        if why:
            live.append((q, why))
        else:
            orphans.append(q)
    return orphans, live


def wt_holder(rp, metas=None):
    """For a per-checkout build folder (checkout_targets): the running lane's cwd or the live captain's root whose checkout it is
    named for, else None. The project's other lanes and its captain build into the shared folder around it, never into it."""
    n = os.path.basename(rp)
    for m in run_metas() if metas is None else metas:
        if m.get("cwd") and lane_running(m) and n in wt_names(m["cwd"]):
            return m["cwd"]
    for p in glob.glob(os.path.join(CAPTAINS, "*.json")):
        c = read_json(p)
        if c and c.get("root") and c.get("owner_pid") and pid_alive(c["owner_pid"]) and n in wt_names(c["root"]):
            return c["root"]
    return None


def target_links(wsdir, tdirs, worktrees):
    """{where a target link points (realpath): the link} for the links inside the targets folders (two levels), <workspace>/*/target,
    <workspace>/*/*/target and each lane worktree's target (2026-10-16: 87 links into two older targets folders, and
    one repo's target link into another's, sat behind folders a scan called dead)."""
    cands = glob.glob(os.path.join(wsdir, "*", "target")) + glob.glob(os.path.join(wsdir, "*", "*", "target")) + [os.path.join(w, "target") for w in worktrees]
    for td in tdirs:
        cands += glob.glob(os.path.join(td, "*")) + glob.glob(os.path.join(td, "*", "*"))
    return {os.path.realpath(c): c for c in cands if os.path.islink(c)}


def target_live(p, links, tdirs, depth=4):
    """Why a target folder named for nothing is still someone's, else None: a link resolves into it (or it lies inside
    a link's folder), or it holds a .git (a checkout; 2026-10-16: two with unpushed commits sat in targets-studio)."""
    rp = os.path.realpath(p)
    for x in sorted(links):
        if x == rp or x.startswith(rp + os.sep) or (x not in tdirs and rp.startswith(x + os.sep)):
            return "%s links into it" % links[x]
    for d, dirs, files in os.walk(p):
        if ".git" in dirs or ".git" in files:
            return "holds a git checkout (%s)" % d
        if os.path.relpath(d, p).count(os.sep) + 1 >= depth:
            dirs[:] = []
        else:
            dirs[:] = [x for x in dirs if x not in ("deps", "build", "incremental", ".fingerprint")]
    return None


def touched_since(p, age=86400):
    """True when any file or folder under p changed in the last `age` seconds; unknown counts as touched."""
    try:
        r = subprocess.run(["find", p, "-mmin", "-%d" % max(1, age // 60), "-print", "-quit"], capture_output=True, text=True, timeout=1800)
        return r.returncode != 0 or bool(r.stdout.strip())
    except Exception:
        return True


def worktree_dirs(roots, volume):
    """Every folder holding a git worktree under the volume's worktrees/ (one or two levels down: lanes a captain sends
    from its own worktree land under that worktree's name, 2026-10-16) and under each root's .claude/worktrees."""
    cands = glob.glob(os.path.join(volume, "worktrees", "*")) + glob.glob(os.path.join(volume, "worktrees", "*", "*"))
    for r in roots:
        cands += glob.glob(os.path.join(r, ".claude", "worktrees", "*"))
    out, seen = [], set()
    for p in sorted(cands):
        if os.path.isfile(os.path.join(p, ".git")) and not os.path.islink(p) and os.path.realpath(p) not in seen:
            seen.add(os.path.realpath(p))
            out.append(p)
    return out


def worktree_root(p):
    """The main checkout a worktree belongs to, by git's common dir (realpath), never by the folder it sits in
    (2026-10-16: 116 worktrees of one project sat under worktrees/captain-fold, invisible to a scan by repo name)."""
    c = git_common(p)
    return os.path.dirname(c) if c and os.path.basename(c) == ".git" else None


def git_common(p):
    """The realpath of git's common dir for the checkout or worktree at p; None when git says no."""
    try:
        r = subprocess.run(["git", "-C", p, "rev-parse", "--git-common-dir"], capture_output=True, text=True, timeout=30)
    except Exception:
        return None
    return os.path.realpath(os.path.join(p, r.stdout.strip())) if r.returncode == 0 and r.stdout.strip() else None


def gitfile_common(p):
    """A worktree's common dir read as git reads it, from its .git file and its gitdir's commondir, without running git;
    None when either cannot be read."""
    try:
        g = open(os.path.join(p, ".git"), encoding="utf-8").read().strip()
        g = os.path.join(p, g.split("gitdir:", 1)[1].strip())
        return os.path.realpath(os.path.join(g, open(os.path.join(g, "commondir"), encoding="utf-8").read().strip()))
    except Exception:
        return None


def trash_dir(volume=None):
    volume = SCRATCH_VOLUME if volume is None else volume
    return os.path.join(volume, "trash") if os.path.isdir(volume) else os.path.join(CCA, "trash")


def quarantine(p, trash, day=None):
    """Move p to <trash>/<day>/<its path with slashes as '__'>: a clean deletes nothing outright (2026-10-16). A rename when
    p is on the trash's volume, else shutil.move (a copy, then the delete). Returns where it went."""
    d = os.path.join(trash, day or datetime.date.today().isoformat())
    os.makedirs(d, exist_ok=True)
    dest = os.path.join(d, os.path.abspath(p).strip(os.sep).replace(os.sep, "__"))
    if os.path.lexists(dest):
        dest += ".%d" % time.time()
    if os.stat(p).st_dev == os.stat(d).st_dev:
        os.rename(p, dest)
    else:
        shutil.move(p, dest)
    return dest


def trash_old(trash, keep=1, today=None):
    """The trash's day-folders older than `keep` days: the one real delete, two days after the move (it was a week until
    2026-10-20, when 859 GB of a week's trash filled the studio's Lanes volume)."""
    today = today or datetime.date.today()
    out = []
    for n in sorted(os.listdir(trash)) if os.path.isdir(trash) else []:
        try:
            if (today - datetime.datetime.strptime(n, "%Y-%m-%d").date()).days > keep:
                out.append(os.path.join(trash, n))
        except ValueError:
            pass
    return out


CHROME_CLONES = "/private/var/folders/*/*/X/com.google.Chrome.code_sign_clone/code_sign_clone.*"


def open_paths(reads=2):
    """Every path any process of this user holds open, the union of `reads` lsof calls (one read can come back short:
    2026-10-16 a single read missed a Chrome clone Chrome had mapped); None when any read fails (then nothing is cleaned)."""
    out = set()
    for _ in range(reads):
        try:
            r = subprocess.run(["lsof", "-w", "-u", getpass.getuser(), "-Fn"], capture_output=True, timeout=300)
            out |= {line[1:] for line in r.stdout.decode("utf-8", "replace").split("\n") if line.startswith("n/")}
        except Exception:
            return None
    return out


def chrome_held():
    """The paths Chrome's own processes hold, read from them directly; None when the read fails. Clones share their main
    binary by hard link, so an inode check (lsof +D) calls every clone held; a path check is the right one."""
    try:
        r = subprocess.run(["lsof", "-w", "-c", "Google", "-c", "Chrome", "-Fn"], capture_output=True, timeout=120)
        if r.returncode not in (0, 1):
            return None
        return {line[1:] for line in r.stdout.decode("utf-8", "replace").split("\n") if line.startswith("n/")}
    except Exception:
        return None


def chrome_starts():
    """The start times of the running Chrome browser processes (helpers left out); None when ps fails."""
    try:
        r = subprocess.run(["ps", "-axo", "pid=,lstart=,command="], capture_output=True, text=True, timeout=30)
    except Exception:
        return None
    if r.returncode != 0:
        return None
    out = []
    for line in r.stdout.split("\n"):
        m = re.match(r"\s*\d+\s+(\w{3} \w{3}\s+\d+ \d\d:\d\d:\d\d \d{4})\s+(.*)$", line)
        if m and m.group(2).startswith("/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"):
            try:
                out.append(time.mktime(time.strptime(re.sub(r"\s+", " ", m.group(1)), "%a %b %d %H:%M:%S %Y")))
            except Exception:
                return None
    return out


def chrome_clone_live(p, starts, window=120):
    """A clone belongs to a running Chrome when it was born within `window` seconds after that Chrome started:
    Chrome makes its clone in its first seconds (2026-10-16: three instances, each clone 6 to 10 s after its start)."""
    try:
        born = os.stat(p).st_birthtime
    except Exception:
        return True
    return any(s0 - 5 <= born <= s0 + window for s0 in starts)


def held_now(p):
    """A direct check of one folder right before it goes: lsof +D lists any process holding a file under it.
    Unknown counts as held."""
    try:
        r = subprocess.run(["lsof", "-w", "+D", p], capture_output=True, timeout=300)
        return bool(r.stdout.strip()) or r.returncode not in (0, 1)
    except Exception:
        return True


def in_use(p, paths):
    pre = os.path.realpath(p).rstrip(os.sep) + os.sep
    raw = p.rstrip(os.sep) + os.sep
    return any(x.startswith(pre) or x.startswith(raw) or x == p for x in paths)


def disk_summary(scan):
    """[(what, count, KiB)] for the reading's table and the disk page."""
    fin = [w for w in scan["worktrees"] if w[2] not in ("running",)]
    return [("cargo target folders inside a checkout", len(scan["targets"]), sum(x[2] for x in scan["targets"])),
            ("lane worktrees not running (any state but running), with the targets named for them", len(fin), sum(x[3] for x in fin) + sum(qk for w in fin for _, qk in scan.get("lane_targets", {}).get(w[1], []))),
            ("scratch folders older than a day, no lane in them", len(scan["tmp"]), sum(x[1] for x in scan["tmp"])),
            ("target folders named for nothing that exists, no link, no checkout", len(scan["orphans"]), sum(x[1] for x in scan["orphans"])),
            ("Chrome's code-sign clones older than a day", len(scan.get("chrome", [])), sum(x[1] for x in scan.get("chrome", [])))]


def disk_page(scan, host, top=20):
    L = ["# Disk, %s, on %s" % (datetime.datetime.now().strftime("%Y-%m-%d %H:%M"), host), ""]
    L += ["| volume | free | size |", "|---|---|---|"] + ["| %s | %.1f GB | %.0f GB |" % f for f in scan["free"]] + [""]
    L += ["| what | count | size |", "|---|---|---|"] + ["| %s | %d | %s |" % (w, c, fmt_gb(k)) for w, c, k in disk_summary(scan)] + [""]
    L += ["Sizes are apparent: a file cloned or hard-linked into several folders (pnpm, cargo, APFS copies) counts in each.", ""]
    if scan["targets"]:
        L += ["## Cargo target folders inside a checkout", "", "A build that missed the shared target dir; the next build on cca's environment lands on the volume, so these are dead weight once the window that made them restarts.", ""]
        L += ["- %s  %s" % (fmt_gb(k), p) for _, p, k in scan["targets"][:top]] + [""]
    if scan["worktrees"]:
        L += ["## Lane worktrees", "", "By repo (git's common dir), count and size per lane state. `cca disk --clean` moves to the trash any worktree but a running lane's that is clean, untracked files included, with its head in main and on a remote, and the target folder named for it (`+ target`) in the same pass.", ""]
        by = {}
        for n, _, st, k, _ in scan["worktrees"]:
            c = by.setdefault(n, {}).setdefault(st, [0, 0])
            c[0] += 1
            c[1] += k
        L += ["| repo | worktrees | size | by state |", "|---|---|---|---|"]
        for n, sts in sorted(by.items(), key=lambda x: -sum(c[1] for c in x[1].values())):
            L.append("| %s | %d | %s | %s |" % (n, sum(c[0] for c in sts.values()), fmt_gb(sum(c[1] for c in sts.values())),
                                                ", ".join("%s %d (%s)" % (st, c[0], fmt_gb(c[1])) for st, c in sorted(sts.items(), key=lambda x: -x[1][1]))))
        lt = scan.get("lane_targets", {})
        L += [""] + ["- %s  %s  %s%s" % (fmt_gb(k), st, p, "".join("  + target %s %s" % (fmt_gb(qk), q) for q, qk in lt.get(p, []))) for _, p, st, k, _ in scan["worktrees"][:top]] + [""]
    if scan.get("trash"):
        L += ["## Trash: %s" % fmt_gb(sum(k for _, k in scan["trash"])), "", "What `cca disk --clean` took; a day-folder goes for good after 2 days.", ""]
        L += ["- %s  %s" % (fmt_gb(k), p) for p, k in scan["trash"]] + [""]
    if scan["tmp"]:
        L += ["## Scratch folders older than a day", "", "`cca disk --clean` moves these to the trash.", ""]
        L += ["- %s  %.0fd  %s" % (fmt_gb(k), d, p) for p, k, d in scan["tmp"][:top]] + [""]
    if scan["orphans"]:
        L += ["## Targets named for nothing that exists", "", "No link resolves into these and none holds a checkout. `cca disk --clean` moves to the trash any that nothing holds open and nothing in it changed in a day.", ""]
        L += ["- %s  %.0fd  %s" % (fmt_gb(k), d, p) for p, k, d in scan["orphans"]] + [""]     # all of them: a captain picks one for --clean --path
    if scan.get("live"):
        L += ["## Targets named for nothing but still live", "", "Never cleaned.", ""]
        L += ["- %s: %s" % (p, why) for p, why in scan["live"][:top]] + ([] if len(scan["live"]) <= top else ["- and %d more" % (len(scan["live"]) - top)]) + [""]
    if scan.get("disk"):
        L += ["", "## Disk", ""] + disk_page(scan["disk"], host).split("\n")[2:]
    return "\n".join(L)


def repo_main(root, fetch=True):
    """(the ref a settled head must be inside, its short name): origin/main or origin/master after one `git fetch -q origin`
    (30 s, a failure falls back to the refs already there), else the local main or master when the repo has no origin;
    None for neither. Against the remote because main checkouts go stale (2026-10-20, the box: one project 2,527 commits behind
    origin/main, and the sweep left 476 merged worktrees, 682 GB)."""
    def ok(*a):
        try:
            return subprocess.run(["git", "-C", root] + list(a), capture_output=True, stdin=subprocess.DEVNULL, timeout=30,
                                  env=dict(os.environ, GIT_TERMINAL_PROMPT="0")).returncode == 0
        except Exception:
            return False
    if ok("remote", "get-url", "origin"):
        if fetch:
            ok("fetch", "-q", "origin")
        for b in ("main", "master"):
            if ok("rev-parse", "--verify", "-q", "refs/remotes/origin/" + b):
                return "refs/remotes/origin/" + b, b
    for b in ("main", "master"):
        if ok("rev-parse", "--verify", "-q", "refs/heads/" + b):
            return "refs/heads/" + b, b
    return None


def lane_settled(root, p, mains=None):
    """The one test for taking a worktree, whatever its lane's record says (2026-10-16: stopped, lost and unrecorded
    worktrees on merged branches stayed forever): a clean tree, untracked files included, and a head that the repo's
    main (repo_main: origin's, else the local one) contains and some remote-tracking branch contains, so the work outlives
    the folder twice over. `mains` caches repo_main per root, so a sweep fetches each repo once. Returns (branch, main), else None."""
    def git(*a, cwd=root):
        return subprocess.run(["git", "-C", cwd] + list(a), capture_output=True, text=True, timeout=120)
    st = git("status", "--porcelain", "--untracked-files=all", cwd=p)
    head = git("rev-parse", "HEAD", cwd=p).stdout.strip()
    if st.returncode != 0 or st.stdout.strip() or not head:
        return None
    mains = {} if mains is None else mains
    if root not in mains:
        mains[root] = repo_main(root)
    main = mains[root]
    if not main or git("merge-base", "--is-ancestor", head, main[0]).returncode != 0 or not git("branch", "-r", "--contains", head).stdout.strip():
        return None
    return git("rev-parse", "--abbrev-ref", "HEAD", cwd=p).stdout.strip(), main[1]


def trash_pressure(trash, volume, floor, skip=(), dry=False):
    """When the lane volume has under `floor` GB free, its trash day-folders emptied oldest first until it is over the floor
    or none is left (2026-10-20: the studio's Lanes at 35 GB free with 857 GB in the trash). `skip` are folders already
    going; under `dry` the free space is estimated from du. Returns [(path, KiB)] emptied, or would be."""
    f = free_gb(volume) if os.path.isdir(volume) else None
    if f is None or f >= floor:
        return []
    out = []
    for n in sorted(os.listdir(trash)) if os.path.isdir(trash) else []:
        p = os.path.join(trash, n)
        if f >= floor:
            break
        if p in skip or not re.match(r"\d{4}-\d\d-\d\d$", n) or not os.path.isdir(p):
            continue
        k = du_many([p]).get(p, 0)
        out.append((p, k))
        if dry:
            f += k / 1048576.0
        else:
            shutil.rmtree(p, ignore_errors=True)
            f = free_gb(volume)
            if f is None:
                break
    return out


def disk_clean(scan, roots, dry=False, volume=None, floor_gb=None, guard=None):
    """Moves to the trash (quarantine) the scratch folders the scan listed, its orphan targets with nothing in them
    changed in a day, Chrome's dead code-sign clones, and every
    worktree but a running lane's that passes lane_settled (then git worktree prune and the branch deleted) and the target
    folders named for that lane with it (scan["lane_targets"]; a day's idleness is not asked of them, the settled worktree is the judgment); empties
    trash day-folders 2 days old and older, and then, when the lane volume is under lanes_floor_gb (or `floor_gb`), the rest
    oldest first until it is over (trash_pressure), before anything new goes in. Returns [(what, path, KiB)]; `dry` lists and touches nothing. Nothing any process
    holds open is touched (two lsof reads unioned, then a direct lsof +D on each scratch folder; if lsof fails, nothing
    moves). A Chrome clone goes only when it was born in no running Chrome's first two minutes and Chrome's processes
    hold no path in it: the clones share one binary by hard link, so lsof's name for it is any of them, and the birth
    time is what ties a clone to its Chrome. A quarantined worktree comes back with a move and `git worktree repair`.
    lsof runs only when something could go. A root carrying .cca-keep is left alone and reported; its content is never read.
    `guard(path)` -> (lock, why): when given, each move is made holding the sweep lock and after a fresh look at the running lanes
    (the scan, the sizes and lsof ran without it); no lock means the folder stays and the line says why (running, busy)."""
    kept = set()

    def keep(p):
        if p in kept:
            return True
        if os.path.exists(os.path.join(p, ".cca-keep")):
            kept.add(p)
            print("kept (.cca-keep): %s" % p)
            return True
        return False

    scan = dict(scan)
    for kind in ("worktrees", "tmp", "orphans", "chrome"):
        index = 1 if kind == "worktrees" else 0
        scan[kind] = [x for x in scan.get(kind, []) if not keep(x[index])]
    trash = trash_dir(volume)
    old = trash_old(trash)
    sz = du_many(old)
    done = [("emptied", p, sz.get(p, 0)) for p in old]
    for p in [] if dry else old:
        shutil.rmtree(p, ignore_errors=True)
    floor = float(load_roster()["settings"].get("lanes_floor_gb") or 0) if floor_gb is None else floor_gb
    vol = SCRATCH_VOLUME if volume is None else volume
    pressed = trash_pressure(trash, vol, floor, skip=old, dry=dry) if os.path.dirname(trash) == vol.rstrip(os.sep) else []
    if pressed:
        print("disk: %s free on %s under lanes_floor_gb %.0f: %s %d trash day-folders, oldest first (%s, %s)" % (
            "%.1f GB" % (free_gb(vol) or 0), vol, floor, "would empty" if dry else "emptied", len(pressed), fmt_gb(sum(k for _, k in pressed)),
            ", ".join(os.path.basename(p) for p, _ in pressed)))
    done += [("pressure", p, k) for p, k in pressed]
    mains = {}
    settled = {p: lane_settled(root, p, mains) for n, p, st, k, root in scan["worktrees"] if st != "running"}
    if not (scan.get("chrome") or scan["tmp"] or scan.get("orphans") or any(settled.values())):
        return done
    held = open_paths()
    if held is None:
        return done + [("lsof FAILED, nothing moved", "", 0)]

    def take(what, p, k):
        if keep(p):
            return False
        if not dry:
            lk, why = guard(p) if guard else (None, None)
            if guard and not lk:
                done.append(("%s SKIPPED (%s)" % (what, why), p, 0))
                return False
            try:
                if guard and not os.path.lexists(p):       # another sweep took it between the scan and the lock
                    return False
                quarantine(p, trash)
            except Exception as e:
                done.append(("%s FAILED %s" % (what, e), p, 0))
                return False
            finally:
                if lk:
                    lk.close()
        done.append((what, p, k))
        return True
    ch = chrome_held() if scan.get("chrome") else set()
    starts = chrome_starts() if scan.get("chrome") else []
    for p, k, _ in scan.get("chrome", []):
        if not (ch is None or starts is None or chrome_clone_live(p, starts) or in_use(p, held) or in_use(p, ch)):   # unsure, it stays
            take("chrome", p, k)
    for p, k, _ in scan["tmp"]:
        if not (in_use(p, held) or held_now(p)):
            take("scratch", p, k)
    for p, k, _ in scan.get("orphans", []):
        if not (in_use(p, held) or touched_since(p) or held_now(p)):
            take("target", p, k)
    for n, p, st, k, root in scan["worktrees"]:
        ok = settled.get(p)
        if not ok or keep(p) or in_use(p, held):
            continue
        if not dry:
            subprocess.run(["git", "-C", root, "worktree", "unlock", p], capture_output=True)   # a locked entry is never pruned
        if not take("worktree", p, k):
            continue
        if not dry:
            subprocess.run(["git", "-C", root, "worktree", "prune"], capture_output=True)
            if ok[0] not in ("", "HEAD", ok[1]):
                subprocess.run(["git", "-C", root, "branch", "-D", ok[0]], capture_output=True)
        for q, qk in scan.get("lane_targets", {}).get(p, []):    # the target named for the lane goes in the same pass
            if not (in_use(q, held) or held_now(q)):
                take("target", q, qk)
    return done


def lane_holds(p, metas=None, volume=None, home=None):
    """The running lane that works in p, inside p, or builds into p (a worktree is its cwd; a target folder is named for it), else None."""
    rp = os.path.realpath(p)
    for m in run_metas() if metas is None else metas:
        if m.get("cwd") and lane_running(m):
            c = os.path.realpath(m["cwd"])
            if c == rp or c.startswith(rp + os.sep) or rp.startswith(c + os.sep):
                return c
    if WT_TARGET.match(os.path.basename(rp)):         # one checkout's own build folder inside a shared target: held only by the lane or captain it is named for
        return wt_holder(rp, metas)
    return lane_overlap(rp, target_roots(volume, home), metas)


def move_guard(volume=None, home=None, metas=None):
    """The guard disk_clean takes: the sweep lock for one move (a lane start holds it only to write its meta, so the wait is short),
    then a fresh look at the lanes. Once a wait ran out, later moves are skipped at once instead of waiting SWEEP_WAIT again."""
    state = {"busy": False, "said": False}

    def guard(p):
        if state["busy"]:
            return None, "busy"
        lk = sweep_lock()
        if not lk:
            if not state["said"]:
                state["said"] = True
                print("cca disk: a lane is starting or a sweep is moving; waiting for it", file=sys.stderr)
            lk = sweep_lock(wait=True)
        if not lk:
            state["busy"] = True
            return None, "busy"
        if lane_holds(p, metas, volume, home):
            lk.close()
            return None, "running"
        return lk, None
    return guard


PATH_EXITS = {"outside": 3, "running": 4, "held": 5, "kept": 6, "missing": 7, "peer": 8, "shared": 9, "move": 10, "device": 11, "busy": 12}
SWEEP_WAIT = 120                       # seconds a wait for the sweep lock may take before the request is refused (exit 12)
DISK_CAPS_VERSION = 3                  # raised when a refusal on the peer's side changes; a relay refuses a peer whose number is lower (no number is 1)
DISK_CAPS = "cca-disk-caps: path %d" % DISK_CAPS_VERSION      # what `cca disk --caps` prints; a peer on an older cca runs the scan instead and the line is absent
KEEP_WALK_DIRS = 200000                # folders looked into for a .cca-keep below a path; past it the path is refused, not taken


def keep_below(rp):
    """A .cca-keep anywhere below rp (a bounded walk for the file name, symlinks not followed): its folder, or rp when the walk
    hit KEEP_WALK_DIRS before it could tell (a folder too big to prove it holds none is not taken)."""
    seen, unreadable = 0, []
    for d, dirs, files in os.walk(rp, onerror=unreadable.append):
        if unreadable:        # a folder that cannot be listed cannot be proven to hold none
            return rp
        if any(x.casefold() == ".cca-keep" for x in files + dirs):       # the upward look is case-blind on these volumes; so is this
            return d
        seen += 1
        if seen > KEEP_WALK_DIRS:
            return rp
    return rp if unreadable else None


RELAY_SSH = ["-o", "BatchMode=yes", "-o", "ServerAliveInterval=5", "-o", "ServerAliveCountMax=3"]       # every ssh that relays a command to a peer: a half-dead link ends
DISK_RELAY_TIMEOUT = 900     # seconds a relayed `cca disk` may take before the caller gives up (the peer's sweep lock wait ends at 120)
PEER_PROBE_TIMEOUT = 30      # seconds the --caps question to a peer may take before the request is refused


def peer_caps(ssh, peer_cmd, timeout=None):
    """Ask a peer whether its cca knows --path: None when its deployed file carries the capability marker, else why not (a
    timeout, an unreachable peer, no marker). Reads the marker from the file over ssh: an older cca answers `--caps` with its
    whole disk scan, so it is never run for the question. peer_cmd is the peer's cca path as written in the roster: this is the one
    place it is quoted for the remote shell (rq), so the caller passes it raw."""
    try:
        pr = subprocess.run(ssh + ["grep -m1 -E '^DISK_CAPS_VERSION = [0-9]+' " + rq(peer_cmd)], capture_output=True, text=True, timeout=timeout or PEER_PROBE_TIMEOUT)
    except subprocess.TimeoutExpired:
        return "timeout: it did not answer in %ds" % (timeout or PEER_PROBE_TIMEOUT)
    except OSError as e:
        return "unreachable: ssh did not run (%s)" % e
    if pr.returncode == 255:
        return "unreachable: ssh could not connect"
    m = re.search(r"^DISK_CAPS_VERSION = ([0-9]+)", pr.stdout or "", re.M)     # the marker at the start of a line (a login banner above it is no matter); ASCII digits only: a superscript digit is not a number
    if not m:
        return "no caps line: its cca does not know --path (deploy it there first)"
    have = int(m.group(1))
    if have < DISK_CAPS_VERSION:
        return "caps version %d: its cca is older than this one's refusals (version %d; deploy it there first)" % (have, DISK_CAPS_VERSION)
    return None


def target_roots(volume=None, home=None):
    """The folders `cca disk --clean --path` may take from, symlinks followed: the lane volume's targets and the workspace's."""
    volume, home = SCRATCH_VOLUME if volume is None else volume, HOME if home is None else home
    out = []
    for d in (os.path.join(volume, "targets"), os.path.join(workspace(home), "targets")):
        if os.path.isdir(d) and os.path.realpath(d) not in out:
            out.append(os.path.realpath(d))
    return out


def lane_running(m):
    """A lane is running while it holds a lease, or while its wrapper (the pid in the meta, on this host) lives: the lease is
    dropped when the model exits, but the gate and a wall retry still run under the same wrapper."""
    if m.get("status") != "running":
        return False
    return leases_alive(m) or (bool(m.get("pid")) and m.get("host") in (None, this_host()) and pid_alive(m["pid"]))


def running_targets(roots, metas=None):
    """Realpaths of the target folders the lanes `cca runs` shows running build into: the project's shared dir and the
    folders under the targets roots named for the lane's worktree."""
    out = set()
    for m in run_metas() if metas is None else metas:
        if not m.get("cwd") or not lane_running(m):
            continue
        cwd = m["cwd"].rstrip(os.sep)
        base, root = os.path.basename(cwd), (git_root(cwd) if os.path.isdir(cwd) else None)
        names = {base, base + "-lanes", "%s-lanes" % (m.get("project") or base)} | ({os.path.basename(root) + "-" + base} if root else set())
        out |= {os.path.realpath(os.path.join(r, n)) for r in roots for n in names}
        td = shared_target_dir(cwd, m.get("project")) if os.path.isdir(cwd) else None
        if td:
            out.add(os.path.realpath(td))
    for p in glob.glob(os.path.join(CAPTAINS, "*.json")):        # a captain builds into its project's <project>-lanes folder (cargo_env) while its window lives
        c = read_json(p)
        if c and c.get("project") and c.get("owner_pid") and pid_alive(c["owner_pid"]):
            out |= {os.path.realpath(os.path.join(r, "%s-lanes" % c["project"])) for r in roots}
            td = shared_target_dir(c.get("root") or "", c["project"]) if c.get("root") and os.path.isdir(c["root"]) else None
            if td:
                out.add(os.path.realpath(td))
    return out


def ident(p):
    """(st_dev, st_ino) of p, or None: two spellings of one folder (a case variant on a case-insensitive volume) share it."""
    try:
        st = os.stat(p)
        return (st.st_dev, st.st_ino)
    except OSError:
        return None


def chain(p, stop):
    """The identities of p and each folder above it up to stop (a path string, kept as its lowercase spelling too)."""
    out, d = set(), p
    while True:
        out.add(ident(d) or d.casefold())
        if d == stop or d == os.path.dirname(d):
            return out
        d = os.path.dirname(d)


def lident(p):
    """(st_dev, st_ino) of p itself, a symlink not followed: an alias beside a folder has its own."""
    try:
        st = os.lstat(p)
        return (st.st_dev, st.st_ino)
    except OSError:
        return None


def root_of(rp, roots):
    """rp rewritten under the root it lies in, matched by inode when the spelling differs (a root in another case), as
    (root, rp under it); None when rp is no folder below any root."""
    rid = {ident(r): r for r in roots if ident(r)}
    d = os.path.dirname(rp)
    while True:
        if d in roots:
            return d, rp
        if ident(d) in rid:
            r = rid[ident(d)]
            return r, os.path.join(r, os.path.relpath(rp, d))
        if d == os.path.dirname(d):
            return None
        d = os.path.dirname(d)


def on_disk(rp, root):
    """rp with each name below root as the folder is named on disk (the listing entry with the same st_dev and st_ino), not as
    the caller spelled it; casefold is the fallback where nothing in the listing matches."""
    d, out = root, []
    for part in os.path.relpath(rp, root).split(os.sep):
        want, d2 = lident(os.path.join(d, part)), None
        try:
            names = os.listdir(d)
        except OSError:
            names = []
        same = [n for n in names if want and lident(os.path.join(d, n)) == want]      # lstat: an alias beside the folder is not the folder
        d2 = next(iter(same), None) or next((n for n in sorted(names, key=lambda n: os.path.islink(os.path.join(d, n))) if n.casefold() == part.casefold()), part)
        out.append(d2)
        d = os.path.join(d, d2)
    return d


def lane_overlap(rp, roots, metas=None):
    """The running lane's target that is rp, holds rp, or lies under rp, matched by inode (a case variant of the path is the
    same folder), else by lowercase spelling for a target not yet made."""
    top = lambda q: next((r for r in roots if q.startswith(r + os.sep)), os.path.dirname(q))
    mine = chain(rp, top(rp))
    for q in sorted(running_targets(roots, metas)):
        theirs = chain(q, top(q))
        if (ident(q) or q.casefold()) in mine or (ident(rp) or rp.casefold()) in theirs:
            return q
    return None


def path_log(rp, k, caller, what):
    os.makedirs(RUNS, exist_ok=True)
    with open(os.path.join(RUNS, "disk-clean.log"), "a", encoding="utf-8") as f:
        f.write("%s\t%s\t%d KiB\tfrom %s\t%s\n" % (datetime.datetime.now().isoformat(timespec="seconds"), rp, k, caller or this_host(), what))


def path_refused(name, line, rp, k, caller):
    """A move that could not be made: the log keeps the line, the caller gets the named exit."""
    try:
        path_log(rp, k, caller, "REFUSED %s" % name)
    except OSError:
        pass
    return PATH_EXITS[name], line


def path_clean(p, dry=False, caller=None, volume=None, home=None, metas=None, shared=False, lock_fn=None):
    """cca disk --clean --path P: one folder under a targets root to the trash, or a refusal (exit, one line) when it is
    outside the roots or names a `..`, the target of a running lane, held open by any process (two lsof reads unioned,
    then lsof +D), marked .cca-keep (on it, a folder above it up to the root, or any folder below it), or a shared
    <project>-lanes folder directly under a root or anything inside one (unless shared), or the lanes folder of a live captain. Logged in runs/disk-clean.log.
    The looks and the size run without the sweep lock; `lock_fn()` (the lock, or None for busy, exit 12) is taken for the last running-lane look and the move only."""
    roots = target_roots(volume, home)
    rp = os.path.realpath(expand(p))
    under = None if ".." in p.split(os.sep) else root_of(rp, roots)
    if not under:
        return PATH_EXITS["outside"], "cca disk: refused (outside): %s is not under %s" % (rp, " or ".join(roots) or "a targets folder")
    if not os.path.isdir(rp):
        return PATH_EXITS["missing"], "cca disk: refused (missing): %s is not a folder" % rp
    root, rp = under
    rp = on_disk(rp, root)       # every name below is the one on disk; the log line and the trash name carry it too
    d = rp
    while True:
        if os.path.exists(os.path.join(d, ".cca-keep")):
            return PATH_EXITS["kept"], "cca disk: refused (kept): %s carries .cca-keep" % d
        if d == root:
            break
        d = os.path.dirname(d)
    below = keep_below(rp)
    if below:
        return PATH_EXITS["kept"], "cca disk: refused (kept): %s carries .cca-keep (or is too big or unreadable to prove it holds none)" % below
    lane = lane_overlap(rp, roots, metas)
    if lane:
        return PATH_EXITS["running"], "cca disk: refused (running): %s is the target of a running lane (%s)" % (rp, lane)
    inside = [x for x in os.path.relpath(rp, root).split(os.sep) if x != "."]
    if not shared and any(x.casefold().endswith("-lanes") for x in inside[:1]):      # the folder directly under the root, or anything inside it; a case variant names the same folder on these volumes
        return PATH_EXITS["shared"], "cca disk: refused (shared): %s is a project's shared lanes folder; name one folder in it, or add --shared" % rp
    held = open_paths()
    if held is None or in_use(rp, held) or held_now(rp):
        return PATH_EXITS["held"], "cca disk: refused (held): %s" % ("lsof failed, nothing moved" if held is None else "a process holds a file under %s open" % rp)
    k = du_many([rp]).get(rp, 0)
    lk = lock_fn() if lock_fn and not dry else None
    if lock_fn and not dry and not lk:
        return PATH_EXITS["busy"], "cca disk: refused (busy): a sweep has held the lock for %ds; nothing moved" % SWEEP_WAIT
    try:
        if not os.path.isdir(rp):       # a racer that held the lock before us took it: the second answers missing, not a move error
            return PATH_EXITS["missing"], "cca disk: refused (missing): %s is not a folder" % rp
        lane = lane_overlap(rp, roots, metas)       # again, right before the move: a lane can start between the first look and here
        if lane:
            return PATH_EXITS["running"], "cca disk: refused (running): %s is the target of a running lane (%s)" % (rp, lane)
        if dry:
            return 0, "would move %s  %s" % (fmt_gb(k), rp)
        trash = trash_dir(volume)
        up = trash
        while up and not os.path.exists(up) and up != os.path.dirname(up):
            up = os.path.dirname(up)
        try:
            cross = os.stat(rp).st_dev != os.stat(up).st_dev
        except OSError as e:
            return path_refused("move", "cca disk: refused (move): %s could not be read for the move (%s); nothing moved" % (rp, e), rp, k, caller)
        if cross:
            return path_refused("device", "cca disk: refused (device): %s is on another volume than the trash (%s); a copy-then-delete is not taken, nothing moved" % (rp, trash), rp, k, caller)
        try:
            dest = quarantine(rp, trash)
        except OSError as e:
            return path_refused("move", "cca disk: refused (move): %s could not be moved to the trash (%s: %s); check %s before trying again" % (rp, type(e).__name__, e, rp), rp, k, caller)
        path_log(rp, k, caller, "-> %s" % dest)
        return 0, "moved %s  %s to %s" % (fmt_gb(k), rp, dest)
    finally:
        if lk:
            lk.close()


VALUED_FLAGS = ("--host", "--path", "--from")       # the only flags that take a value; --dry=1 and the like are refused beside --clean
DISK_FLAGS = ("--clean", "--dry", "--json", "--shared", "--caps", "--host", "--path", "--from")


def wait_sweep_lock():
    """The sweep lock for a move, waiting up to SWEEP_WAIT (a lane start or another move holds it only briefly); None when it ran out."""
    lk = sweep_lock()
    if not lk:
        print("cca disk: a lane's end is sweeping; waiting for it", file=sys.stderr)
        lk = sweep_lock(wait=True)
    return lk


def cmd_disk(args):
    """cca disk [--clean|--dry] [--path P] [--host H] [--json]: what the lanes left on the disk, with sizes (rule 23). --clean
    moves the safe classes to the trash and prints what went; --dry prints what would; --path takes that one folder under a
    targets root instead, or refuses with a named exit (path_clean). No clock: it runs when someone types it."""
    o = flags(args, ["--host", "--path", "--from"])
    roster = load_roster()
    if "--caps" in args:
        print(DISK_CAPS)
        return 0

    def refuse(rc, line):       # one shape for every refusal: the line on stderr, and with --json the same object path_clean prints on stdout
        print(line, file=sys.stderr)
        if "--json" in args:
            print(json.dumps({"host": this_host(roster), "path": o.get("--path") if isinstance(o.get("--path"), str) else None, "exit": rc, "line": line}))
        return rc
    stray = [a for a in args if a.startswith("--") and (a.split("=", 1)[0] not in DISK_FLAGS or ("=" in a and a.split("=", 1)[0] not in VALUED_FLAGS))] + o["_"]
    if "--clean" in args and stray:       # a typo of --path (--Path, --pth) must not turn into the full sweep
        return refuse(2, "cca disk: refused: %s not understood beside --clean (nothing done)" % ", ".join(stray))
    if ("--path" in o or any(a.startswith("--path=") for a in args)) and (not isinstance(o.get("--path"), str) or not o["--path"].strip()):
        return refuse(2, "cca disk: --path takes a folder (an empty or missing value is refused, nothing sent)")
    if "--clean" in args and "--json" in args and "--path" not in o:
        return refuse(2, "cca disk: --json only scans; it does not clean (use --path with --clean --json, or drop --json)")
    if o.get("--host") and o["--host"] != this_host(roster):
        h = (roster.get("hosts") or {}).get(o["--host"])
        if not h or not h.get("ssh"):
            return refuse(2, "cca disk: no host %s" % o["--host"])
        if "--path" in o and not o["--path"].startswith("/"):       # the peer's cwd is not this one's, and ~ is not this home
            return refuse(2, "cca disk: --path to another host must be absolute (%s is relative to this host); nothing sent" % o["--path"])
        fw = [x for x in ("--clean", "--dry", "--json", "--shared") if x in args] + (["--path", o["--path"], "--from", this_host(roster)] if "--path" in o else [])
        ssh = ["ssh", "-o", "ConnectTimeout=8"] + RELAY_SSH + [h["ssh"]]
        if "--path" in o:       # an older peer reads --path as a bare switch and sweeps the lot: ask first, forward only on its answer
            why = peer_caps(ssh, roster["settings"]["peer_cca"])
            if why:
                return refuse(PATH_EXITS["peer"], "cca disk: refused (peer): %s: %s; nothing sent" % (o["--host"], why))
        try:
            return subprocess.call(ssh + [" ".join([rq(roster["settings"]["peer_cca"]), "disk"] + [shlex.quote(x) for x in fw])], timeout=DISK_RELAY_TIMEOUT)
        except subprocess.TimeoutExpired:
            return refuse(PATH_EXITS["peer"], "cca disk: %s did not finish in %ds; ask it again (the peer may still be working: its own sweep lock serialises)" % (o["--host"], DISK_RELAY_TIMEOUT))
    if "--path" in o:
        if not ("--clean" in args or "--dry" in args):
            return refuse(2, "cca disk: --path takes a folder and goes with --clean or --dry")
        rc, line = path_clean(o["--path"], dry="--dry" in args, shared="--shared" in args, lock_fn=wait_sweep_lock,
                      caller=o["--from"] if o.get("--from") in (roster.get("hosts") or {}) else this_host(roster))
        if "--json" in args:
            print(json.dumps({"host": this_host(roster), "path": o["--path"], "exit": rc, "line": line}))
        else:
            print(line, file=sys.stderr if rc else sys.stdout)
        return rc
    roots = reading_roots(roster)
    scan = disk_scan(roots)
    if "--json" in args:
        scan["host"] = this_host(roster)
        scan["summary"] = [{"what": w, "count": c, "kib": k} for w, c, k in disk_summary(scan)]
        print(json.dumps(scan, indent=1))
        return 0
    print(disk_page(scan, this_host(roster)))
    if "--clean" in args or "--dry" in args:
        dry = "--dry" in args
        gone = disk_clean(scan, roots, dry=dry, guard=None if dry else move_guard())
        moved = [x for x in gone if x[0] not in ("emptied", "pressure")]
        emptied = [x for x in gone if x[0] in ("emptied", "pressure")]
        for what, p, k in gone:
            print("%-9s %s  %s" % (what, fmt_gb(k), p))
        if any(x[0].endswith("SKIPPED (busy)") for x in gone):
            print("cca disk: refused (busy): a sweep held the lock for %ds; what is listed as SKIPPED (busy) did not move" % SWEEP_WAIT, file=sys.stderr)
            rc_busy = PATH_EXITS["busy"]
        else:
            rc_busy = 0
        print(("would move %s in %d folders to %s, would empty %s in %d day-folders" if dry else "moved %s in %d folders to %s, emptied %s in %d day-folders") %
              (fmt_gb(sum(x[2] for x in moved)), len(moved), trash_dir(), fmt_gb(sum(x[2] for x in emptied)), len(emptied)) +
              "; free now: " + ", ".join("%s %.1f GB" % (m, f) for m, f, _ in disk_free()))
        return rc_busy
    return 0


def cmd_reading(args):
    """cca reading [--host H] [--out PATH] [--no-jscpd]: the fleet reading, a page of counts and paths under ~/.cca/readings/.
    No clock: it runs when someone types it. --host runs it there."""
    o = flags(args, ["--host", "--out"])
    roster = load_roster()
    if o.get("--host") and o["--host"] != this_host(roster):
        h = (roster.get("hosts") or {}).get(o["--host"])
        if not h or not h.get("ssh"):
            print("cca reading: no host %s" % o["--host"], file=sys.stderr)
            return 2
        return subprocess.call(["ssh"] + RELAY_SSH + [h["ssh"], rq(roster["settings"]["peer_cca"]) + " reading" + (" --no-jscpd" if o.get("--no-jscpd") else "")])
    roots = reading_roots(roster)
    scan = reading_scan(roots, jscpd=not o.get("--no-jscpd"))
    scan["disk"] = disk_scan(roots)
    page = reading_page(scan, this_host(roster))
    out = expand(o.get("--out") or os.path.join(CCA, "readings", "fleet-%s.md" % datetime.date.today().isoformat()))
    os.makedirs(os.path.dirname(out), exist_ok=True)
    open(out, "w", encoding="utf-8").write(page)
    print("\n".join(page.split("\n")[4:13]))
    print("\n" + out)
    return 0


# ----------------------------------------------------------------------------- disk: the sweep at a lane's end, the floor before a launch (rule 24)

def free_gb(path=None):
    """Free GB on the volume that holds `path` (default HOME: the internal disk); None when it cannot be read."""
    try:
        st = os.statvfs(path or HOME)
        return st.f_bavail * st.f_frsize / 2.0 ** 30
    except Exception:
        return None


def machine_disk(roster):
    """This machine's line for the board: internal free GB and lane volume free GB (None without the volume)."""
    return {"host": this_host(roster), "internal_gb": free_gb(HOME), "lanes_gb": free_gb(SCRATCH_VOLUME) if os.path.isdir(SCRATCH_VOLUME) else None, "at": now()}


def fmt_disk(d):
    gb = lambda x: ("%.0f GB" % x) if x is not None else "?"
    return "%-10s internal %s free · Lanes %s" % (d.get("host") or "?", gb(d.get("internal_gb")), (gb(d["lanes_gb"]) + " free") if d.get("lanes_gb") is not None else "none")


def sweep_lock(wait=False, timeout=None):
    """One sweep at a time on this machine: the open lock file (hold it, close it to let go), else None when another
    sweep holds it, or, with wait, still holds it after `timeout` seconds (SWEEP_WAIT): a wedged sweep is a refusal, not a hang."""
    import fcntl
    os.makedirs(CCA, exist_ok=True)
    f = open(os.path.join(CCA, "sweep.lock"), "a")
    end = time.time() + (SWEEP_WAIT if timeout is None else timeout)
    while True:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return f
        except OSError:
            if not wait or time.time() >= end:
                f.close()
                return None
            time.sleep(0.2)


MOVED = ("worktree", "scratch", "chrome", "target")


def disk_sweep(roster, project, root=None, scratch=False, volume=None):
    """`cca disk --clean` limited to the worktrees of root's repo (by git's common dir, so a captain's worktree means its main
    repo), in this process; [(what, path, KiB)] moved. The scan and the sizes run without the sweep lock; each move takes it
    (move_guard), so a lane start never waits across a scan. Best effort: it never raises. `scratch` (the floor, which needs the room) takes the scratch folders and Chrome's clones too; orphan
    targets never (named for nothing is a fleet-wide judgment)."""
    try:
        root = root or project_root(roster, project)
        common = git_common(root) if root and os.path.isdir(root) else None
        if not common:
            return []
        roots = {os.path.realpath(root): project or os.path.basename(root)}
        if os.path.basename(common) == ".git":
            roots.setdefault(os.path.dirname(common), project or os.path.basename(os.path.dirname(common)))
        scan = disk_scan(roots, volume=volume, repos={common}, also=("tmp", "chrome") if scratch else ())
        return [x for x in disk_clean(scan, roots, volume=volume, guard=move_guard(volume)) if x[0] in MOVED]
    except Exception:
        return []


def lane_servers_end(run_id, listeners=None, environ_of=None, grace=5.0):
    """Ends the servers a lane left listening: every process with a TCP port in LISTEN whose environment carries
    CCA_RUN=<run_id> (set on every lane; children inherit it, nohup and & included) gets TERM, then KILL after `grace`.
    Nothing else is touched: a captain's or another lane's process never carries this id. [(pid, command)] ended.
    2026-10-25 02:40: two workerd and a wrangler dev a lane left behind held ~29,000 loopback connections and the
    Studio ran out of ephemeral ports; git push, gh and cargo fetch failed for every captain until they were killed."""
    if not run_id:
        return []
    try:
        if listeners is None:
            r = subprocess.run(["lsof", "-w", "-nP", "-iTCP", "-sTCP:LISTEN", "-t"], capture_output=True, text=True, timeout=60)
            listeners = sorted({int(x) for x in r.stdout.split() if x.isdigit()})
        listeners = [p for p in listeners if p != os.getpid()]
        if not listeners:
            return []
        if environ_of is None:
            r = subprocess.run(["ps", "-E", "-o", "pid=,command=", "-p", ",".join(str(p) for p in listeners)], capture_output=True, text=True, timeout=60)
            rows = {}
            for line in r.stdout.splitlines():
                parts = line.strip().split(None, 1)
                if parts and parts[0].isdigit():
                    rows[int(parts[0])] = parts[1] if len(parts) > 1 else ""
            environ_of = lambda p: rows.get(p, "")
    except Exception:
        return []
    mark = "CCA_RUN=" + run_id
    mine = []
    for p in listeners:
        line = environ_of(p)
        if (" " + mark + " ") in (" " + line + " "):
            mine.append((p, line.split(" " + "CCA_", 1)[0].split(" TERM_PROGRAM=", 1)[0].split(" SHELL=", 1)[0][:120]))
    for sig, secs in ((signal.SIGTERM, grace), (signal.SIGKILL, 2.0)):
        for p, _ in mine:
            try:
                os.kill(p, sig)
            except Exception:
                pass
        end = now() + secs
        while now() < end and any(pid_alive(p) for p, _ in mine):
            time.sleep(0.2)
        if not any(pid_alive(p) for p, _ in mine):
            break
    return mine


def lane_end_sweep(roster, meta, root=None):
    """At a lane's end, after its report is printed and its record written: the servers it left listening ended
    (lane_servers_end), then its repo swept (rule 24), a summary only when something moved. The sweep reports kept
    roots too. A record still running is left alone."""
    try:
        if meta.get("status") in (None, "running") or os.environ.get("CCA_NO_SWEEP"):
            return
        sys.stdout.flush()
        ended = lane_servers_end(meta.get("id"))
        if ended:
            print("lane: ended %d listener%s the lane left running: %s" % (len(ended), "" if len(ended) == 1 else "s", "; ".join("%d %s" % (p, c) for p, c in ended)))
        moved = disk_sweep(roster, meta.get("project"), root)
        if moved:
            print("disk: the sweep at this lane's end moved %d folders (%s) to the trash" % (len(moved), fmt_gb(sum(x[2] for x in moved))))
    except Exception:
        pass


def disk_floor(roster, project, root=None, launch=True):
    """None when the internal disk is over the floor (roster setting disk_floor_gb) or cannot be read; else the one line to
    print. Before a launch the project is swept first and the disk read again; before a captain it only warns."""
    floor = float(roster["settings"].get("disk_floor_gb") or 0)
    f = free_gb(HOME)
    if f is None or f >= floor:
        return None
    if not launch:
        return "warning: the internal disk has %.1f GB free, under the floor of %.0f GB (disk_floor_gb); `cca disk` shows what holds it" % (f, floor)
    disk_sweep(roster, project, root, scratch=True)
    f = free_gb(HOME)
    if f is None or f >= floor:
        return None
    return ("cca run: not launched: the internal disk has %.1f GB free after a sweep of %s, under the floor of %.0f GB (disk_floor_gb); "
            "`cca disk` shows what holds it" % (f, project, floor))


LANE_SERVERS_NOTE = ("Any server or watcher you start (a dev server, wrangler dev, workerd, anything on a port) you stop before your REPORT: "
                     "a port left open is the fleet's, and the tool ends what a lane leaves listening (rule 24).")


def lane_scratch_note(project):
    """The sentence every lane and captain gets about where its files go (rules 23, 24)."""
    return ("Scratch and build output go under $TMPDIR or the shared target dir (CARGO_TARGET_DIR, under %s), never a literal /tmp "
            "or /private/tmp path (the internal disk) nor inside the checkout, and anything a lane keeps for the project (evidence, runs, "
            "fixtures) goes under %s/out/%s/ when that volume exists." % (os.path.join(WORKSPACE, "targets"), SCRATCH_VOLUME, project or "<project>"))


def cmd_selftest(args):
    """The picker and the arithmetic on fixtures, in a scratch state dir. What a check makes unremovable (a folder chmod'ed
    unlistable) is put back in the finally, so a failing or raising check never leaves it behind."""
    cleanup = []
    try:
        return selftest_body(args, cleanup)
    finally:
        for fn in reversed(cleanup):
            try:
                fn()
            except Exception:
                pass


