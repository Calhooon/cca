    scp_d = deploy(scp_fail=2)
    fail_rules = lambda c: c.replace('place() { mv -f', 'place() { case "$2" in *RULES.md) return 1;; esac; mv -f', 1)       # the second rename fails, after the first has landed
    mv_d = deploy(patch_cmd=fail_rules)
