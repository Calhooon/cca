    OLD_CCA = "#!/bin/sh\necho old-install-ran >> %s/installed\n" % dep       # an old cca that still runs after a rollback

    def seed(fresh=False):
        for f in glob.glob(os.path.join(dep, "installed")) + glob.glob(os.path.join(dep, "install-fail")) + glob.glob(os.path.join(dep, "install-slow")):
            os.remove(f)
        shutil.rmtree(os.path.join(dhome, ".cca", "deploy.lock"), ignore_errors=True)
        for f in (d_cca, d_rules, d_acct):
            if os.path.lexists(f):
                os.remove(f)
        open(d_cca, "w").write(OLD_CCA)
        os.chmod(d_cca, 0o755)
        if not fresh:        # a fresh peer has only a cca: no RULES.md and no roster of its own yet
            open(d_rules, "w").write("old rules")
            open(d_acct, "w").write("old roster")
        for d in (os.path.join(ddest, "bin"), ddest, os.path.join(dhome, ".cca")):
            for x in os.listdir(d):
                if ".new." in x or ".bak." in x or ".kept." in x:
                    os.remove(os.path.join(d, x))

    real_call, real_run_d = subprocess.call, subprocess.run
    lockdir = os.path.join(dhome, ".cca", "deploy.lock")

    def deploy(scp_fail=None, patch_cmd=None, fresh=False, litter=(), install_fail=False, cp_fail=False, hang=False, login="sh", slow=0, undo_wait=None, lock_wait=None, held=None, over_extra=None):
        seed(fresh)
        for rel in litter:
            open(os.path.join(dhome, rel), "w").write("litter " + rel)
        if install_fail:
            open(os.path.join(dep, "install-fail"), "w").write("")
        if slow:
            open(os.path.join(dep, "install-slow"), "w").write(str(slow))
        if held:       # another deploy's lock on the peer: (owner pid, seconds old)
            os.makedirs(lockdir)
            open(os.path.join(lockdir, "owner"), "w").write(str(held[0]))
            open(os.path.join(lockdir, "since"), "w").write(str(int(time.time()) - held[1]))
        n, bg = [0], []

        def fake_run(argv, input=None, text=None, timeout=None, **k):
            env = dict(os.environ, HOME=dhome)
            if argv[0] == "scp":
                n[0] += 1
                if scp_fail == n[0]:
                    return subprocess.CompletedProcess(argv, 1)
                return subprocess.CompletedProcess(argv, real_call(["cp", argv[-2], os.path.join(dhome, argv[-1].split(":", 1)[1])]))
            script = patch_cmd(input) if patch_cmd else input
            if slow and "place()" in script:       # the step goes on running on the peer while the ssh line gives up
                pr = subprocess.Popen([login, "-c", argv[-1]], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env, text=True)
                pr.stdin.write(script); pr.stdin.flush()       # communicate() below closes it (3.9 flushes a stdin closed here and raises)
                for _ in range(100):
                    if glob.glob(os.path.join(lockdir, "running.*")):
                        break
                    time.sleep(0.1)
                bg.append(pr)
                raise subprocess.TimeoutExpired(argv, 1)
            r = real_run_d([login, "-c", argv[-1]], input=script, env=env, capture_output=True, text=True)
            said[0] += r.stdout
            said[1] += r.stderr
            if hang and "place()" in script:       # the line went quiet after the step ran: ssh gives up, the step's exit is never seen
                raise subprocess.TimeoutExpired(argv, 1)
            return subprocess.CompletedProcess(argv, r.returncode)
        out, err, said = io.StringIO(), io.StringIO(), ["", ""]
        over = {"load_roster": lambda: droster, "this_host": lambda r=None: "me", "HERE": os.path.join(dsrc, "bin"), "REPO": dsrc, "ROSTER": os.path.join(dep, "roster.json")}
        if undo_wait is not None:
            over["DEPLOY_UNDO_WAIT"] = undo_wait
        if lock_wait is not None:
            over["DEPLOY_LOCK_WAIT"] = lock_wait
        over.update(over_extra or {})
        with patch.dict(globals(), over), patch.object(subprocess, "run", fake_run), contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            rc = cmd_deploy([])
        for pr in bg:
            o_, e_ = pr.communicate(timeout=60)
            said[0] += o_
            said[1] += e_
        state = [open(f).read() if os.path.exists(f) else None for f in (d_cca, d_rules, d_acct)]
        left = sorted(x for d in (os.path.join(ddest, "bin"), ddest, os.path.join(dhome, ".cca")) for x in os.listdir(d)
                      if ".new." in x or ".bak." in x)
        inst = open(os.path.join(dep, "installed")).read() if os.path.exists(os.path.join(dep, "installed")) else ""
        return rc, state, left, inst, said[0] + out.getvalue(), said[1] + err.getvalue(), os.path.isdir(lockdir)
    NEW_CCA = open(os.path.join(dsrc, "bin", "cca")).read()
    old_state = [OLD_CCA, "old rules", "old roster"]
    ok_d = deploy(litter=(".cca/accounts.json.bak.77", "peer dir/RULES.md.bak.77", "peer dir/bin/.cca.new.77", ".cca/.accounts.json.new.77"))
