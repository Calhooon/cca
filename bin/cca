    ls = os.path.join(tmp, "Local State")
    write_json(ls, {"profile": {"info_cache": {"Profile 7": {"name": "Dev", "user_name": "dev@x"}, "Profile 3": {"name": "ops@y", "user_name": ""}}}})
    check(chrome_profile_for("DEV@x", ls) == ("Profile 7", "Dev"), "a Chrome profile is found by its Google account")
