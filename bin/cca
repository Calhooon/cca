          "deploy prep: three deployers started together on a stale lock end with exactly one holder, the taken-over folder removed; with the takeover planted back to rm then mkdir two or more hold it (%r, %r)" % (tk_ok, tk_plant))
    # a taker that read the lock as stale and renames a fresh one (another taker finished first): the fresh lock goes back, the taker waits and refuses
    def fresh_taken(plant=False, busy=False, third=False):
        seed()
        os.makedirs(lockdir)
        open(os.path.join(lockdir, "owner"), "w").write("fresh:9")
        open(os.path.join(lockdir, "since"), "w").write(str(int(time.time())))
        with patch.dict(globals(), {"DEPLOY_LOCK_WAIT": 2}):
            c_ = deploy_prep_cmd("~/peer dir", [], "peer-d", "hostA:1")
        c_ = c_.replace('s=$(cat "$LK/since" 2>/dev/null);', 's=$(cat "$LK/since" 2>/dev/null); [ $w = 0 ] && s=1;', 1)       # the first look saw the old, stale lock
        if plant:
            c_ = c_.replace('if [ "$o2" = "$o" ] && [ "$s2" = "$s" ] && { [ -n "$o" ] && [ -n "$s" ] || [ -n "$old" ]; }; then', "if true; then", 1)       # the compare planted out
        if third:       # a third deployer makes the lock in the instant after the rename; plant=="gone" puts the fate back to leaving the displaced folder, unsaid
            c_ = c_.replace('then o2=$(cat', 'then mkdir "$LK"; echo third:7 > "$LK/owner"; date +%s > "$LK/since"; o2=$(cat', 1)
            if busy:
                c_ = c_.replace('drop "takeover: the lock was remade meanwhile; the folder this taker moved ($X) is removed";', ":;", 1)
        r_ = real_run_d(["sh", "-s"], input=c_, text=True, env=dict(os.environ, HOME=dhome), capture_output=True, timeout=60)
        if third:
            return r_.returncode, rd(os.path.join(lockdir, "owner")), [x for x in os.listdir(os.path.join(dhome, ".cca")) if x.startswith("deploy.lock.stale")], "the folder this taker moved" in r_.stderr
        return r_.returncode, rd(os.path.join(lockdir, "owner")), [x for x in os.listdir(os.path.join(dhome, ".cca")) if x.startswith("deploy.lock.stale")]
    fr_ok = fresh_taken()
    fr_plant = fresh_taken(plant=True)
    for x_ in glob.glob(os.path.join(dhome, ".cca", "deploy.lock.stale*")):
        shutil.rmtree(x_, ignore_errors=True)
    check(fr_ok == (75, "fresh:9", []) and fr_plant[0] == 0 and fr_plant[1] == "hostA:1\n",
          "deploy prep: a taker that renames a fresh lock (not the stale one it read) puts it back and refuses; with the compare planted out it removes the fresh lock and takes it (%r, %r)" % (fr_ok, fr_plant))
    # the displaced fresh folder when a third deployer made the lock meanwhile: this taker's own copy is removed and says so (never left as LK.stale.*)
    th_ok = fresh_taken(third=True)
    th_plant = fresh_taken(third=True, busy=True)
    for x_ in glob.glob(os.path.join(dhome, ".cca", "deploy.lock.stale*")):
        shutil.rmtree(x_, ignore_errors=True)
    check(th_ok == (75, "third:7\n", [], True) and th_plant[2] != [] and th_plant[3] is False and th_plant[1] == "third:7\n",
          "deploy prep: when a third deployer made the lock after this taker's rename, the folder this taker moved is removed with a line saying so and the third's lock stands; with the removal planted out the LK.stale folder stays, unsaid (%r, %r)" % (th_ok, th_plant))
    # the put-back when a deployer mkdir'd the lock between the test and the put-back: nothing nests, the live owner stands; and a lock that vanishes before the owner write stops the prep
    def putback(plant=False):
        seed()
        os.makedirs(lockdir)
        open(os.path.join(lockdir, "owner"), "w").write("fresh:9")
        open(os.path.join(lockdir, "since"), "w").write(str(int(time.time())))
        with patch.dict(globals(), {"DEPLOY_LOCK_WAIT": 2}):
            c_ = deploy_prep_cmd("~/peer dir", [], "peer-d", "hostA:1")
        c_ = c_.replace('s=$(cat "$LK/since" 2>/dev/null);', 's=$(cat "$LK/since" 2>/dev/null); [ $w = 0 ] && s=1;', 1)
        c_ = c_.replace('elif [ -e "$LK" ];', 'elif { mkdir "$LK"; echo third:7 > "$LK/owner"; date +%s > "$LK/since"; false; };', 1)       # a deployer remakes the lock after the test
        if plant:
            c_ = c_.replace('if mkdir "$LK" 2>/dev/null; then for f in "$X"/*; do [ -e "$f" ] && mv "$f" "$LK"/; done; rm -rf "$X"; else', 'if mv "$X" "$LK" 2>/dev/null; then :; else', 1)       # the old put-back
        r_ = real_run_d(["sh", "-s"], input=c_, text=True, env=dict(os.environ, HOME=dhome), capture_output=True, timeout=60)
        return r_.returncode, rd(os.path.join(lockdir, "owner")), glob.glob(os.path.join(lockdir, "deploy.lock.stale.*")) != [], "was retaken" in r_.stderr
    pb_ok, pb_plant = putback(), putback(plant=True)
    for x_ in glob.glob(os.path.join(dhome, ".cca", "deploy.lock.stale*")):
        shutil.rmtree(x_, ignore_errors=True)
    check(pb_ok == (75, "third:7\n", False, True) and pb_plant[2] is True,
          "deploy prep: a lock remade between the test and the put-back is never nested into: the taker's copy is removed with a line and the live owner stands; with the old mv put-back the folder nests inside it (%r, %r)" % (pb_ok, pb_plant))
    def vanish(plant=False):
        seed()
        with patch.dict(globals(), {"DEPLOY_LOCK_WAIT": 2}):
            c_ = deploy_prep_cmd("~/peer dir", [], "peer-d", "hostA:1")
        c_ = c_.replace('{ echo ', 'rm -rf "$LK"; { echo ', 1)       # the lock vanishes between the mkdir and the owner write
        if plant:
            c_ = c_.replace('|| { echo', '|| : || { echo', 1)       # the guard planted out
        c_ += "echo PAST\n"
        r_ = real_run_d(["sh", "-s"], input=c_, text=True, env=dict(os.environ, HOME=dhome), capture_output=True, timeout=60)
        return r_.returncode, "PAST" in r_.stdout
    vn_ok, vn_plant = vanish(), vanish(plant=True)
    check(vn_ok == (1, False) and vn_plant == (0, True),
          "deploy prep: a lock that vanishes before the owner write ends the prep with exit 1 before it goes on; with the guard planted out the prep runs past it (%r, %r)" % (vn_ok, vn_plant))
    # a lock folder with no since file: a young one (its holder is between mkdir and the write of since) is never taken; one past the grace is
    def sinceless(age, plant=None):
        seed()
        os.makedirs(lockdir)
        t_ = time.time() - age
        os.utime(lockdir, (t_, t_))
        with patch.dict(globals(), {"DEPLOY_LOCK_WAIT": 8}):
            c_ = deploy_prep_cmd("~/peer dir", [], "peer-d", "hostA:1")
        if plant == "grace":
            c_ = c_.replace(' && [ -n "$(find "$LK" -maxdepth 0 -mmin +%d 2>/dev/null)" ]' % DEPLOY_LOCK_GRACE, "", 1)       # the grace planted out, with the compare as it was
            c_ = c_.replace('{ [ -n "$o" ] && [ -n "$s" ] || [ -n "$old" ]; }', "true", 1)
        if plant == "empty":
            c_ = c_.replace('{ [ -z "$s" ] && [ $w -gt 5 ]', '{ false && [ $w -gt 5 ]', 1)
        r_ = real_run_d(["sh", "-s"], input=c_, text=True, env=dict(os.environ, HOME=dhome), capture_output=True, timeout=90)
        return r_.returncode, rd(os.path.join(lockdir, "owner")), [x for x in os.listdir(os.path.join(dhome, ".cca")) if x.startswith("deploy.lock.stale")]
    sl_young, sl_young_plant = sinceless(5), sinceless(5, "grace")
    sl_old, sl_old_plant = sinceless(DEPLOY_LOCK_GRACE * 60 + 600), sinceless(DEPLOY_LOCK_GRACE * 60 + 600, "empty")
    shutil.rmtree(lockdir, ignore_errors=True)
    check(sl_young[0] == 75 and sl_young[1] is None and sl_young_plant[0] == 0 and sl_young_plant[1] == "hostA:1\n",
          "deploy prep: a lock folder with no since file younger than the grace is never taken over (the holder is between mkdir and its write); with the grace planted out it is displaced (%r, %r)" % (sl_young, sl_young_plant))
    check(sl_old == (0, "hostA:1\n", []) and sl_old_plant[0] == 75,
          "deploy prep: a lock folder with no since file older than the grace is a dead deploy's and is taken over after the fifth look; with that branch planted out the deployer waits and refuses (%r, %r)" % (sl_old, sl_old_plant))
    # (1) a dead empty lock read by a taker, a live deployer's brand-new lock (no owner yet) takes the name before the rename: the compare must not match two empties
    MATCH = '[ "$o2" = "$o" ] && [ "$s2" = "$s" ] && { [ -n "$o" ] && [ -n "$s" ] || [ -n "$old" ]; }'
    def empty_live(plant=False):
        seed()
        os.makedirs(lockdir)
        t_ = time.time() - DEPLOY_LOCK_GRACE * 60 - 600
        os.utime(lockdir, (t_, t_))       # the dead empty folder the taker reads
        with patch.dict(globals(), {"DEPLOY_LOCK_WAIT": 8}):
            c_ = deploy_prep_cmd("~/peer dir", [], "peer-d", "hostA:1")
        c_ = c_.replace('if mv "$LK" "$X"', 'rm -rf "$LK"; mkdir "$LK"; if mv "$LK" "$X"', 1)       # the live deployer's mkdir, its owner not yet written
        if plant:
            c_ = c_.replace(MATCH, '[ "$o2" = "$o" ] && [ "$s2" = "$s" ]', 1)       # the old compare: two empties match
        r_ = real_run_d(["sh", "-s"], input=c_, text=True, env=dict(os.environ, HOME=dhome), capture_output=True, timeout=90)
        return r_.returncode, rd(os.path.join(lockdir, "owner")), [x for x in os.listdir(os.path.join(dhome, ".cca")) if x.startswith("deploy.lock.stale")]
    el_ok, el_plant = empty_live(), empty_live(plant=True)
    shutil.rmtree(lockdir, ignore_errors=True)
    check(el_ok == (75, None, []) and el_plant[0] == 0 and el_plant[1] == "hostA:1\n",
          "deploy prep: a taker whose dead empty lock was replaced by a live deployer's brand-new one (no owner yet) puts it back and refuses; with the compare as it was (two empties match) it removes the live lock and takes it (%r, %r)" % (el_ok, el_plant))
    # (2) a live lock renamed away while a third deployer makes the lock path: the live folder is kept, never removed
    def live_kept(plant=False):
        seed()
        os.makedirs(lockdir)
        open(os.path.join(lockdir, "owner"), "w").write("live:5")
        open(os.path.join(lockdir, "since"), "w").write(str(int(time.time())))
        with patch.dict(globals(), {"DEPLOY_LOCK_WAIT": 2}):
            c_ = deploy_prep_cmd("~/peer dir", [], "peer-d", "hostA:1")
        c_ = c_.replace('s=$(cat "$LK/since" 2>/dev/null);', 's=$(cat "$LK/since" 2>/dev/null); [ $w = 0 ] && o=dead:1 && s=1;', 1)       # the first look saw a dead lock
        c_ = c_.replace('then o2=$(cat', 'then mkdir "$LK"; echo third:7 > "$LK/owner"; date +%s > "$LK/since"; o2=$(cat', 1)
        if plant:
            c_ = c_.replace('if [ -n "$o2" ] && [ "$o2" != "$o" ]; then', "if false; then", 1)       # the guard planted out
        r_ = real_run_d(["sh", "-s"], input=c_, text=True, env=dict(os.environ, HOME=dhome), capture_output=True, timeout=60)
        kept_ = [rd(os.path.join(dhome, ".cca", x, "owner")) for x in os.listdir(os.path.join(dhome, ".cca")) if x.startswith("deploy.lock.stale")]
        return r_.returncode, rd(os.path.join(lockdir, "owner")), kept_
    lk_ok = live_kept()
    for x_ in glob.glob(os.path.join(dhome, ".cca", "deploy.lock.stale*")):
        shutil.rmtree(x_, ignore_errors=True)
    lk_plant = live_kept(plant=True)
    for x_ in glob.glob(os.path.join(dhome, ".cca", "deploy.lock.stale*")):
        shutil.rmtree(x_, ignore_errors=True)
    check(lk_ok == (75, "third:7\n", ["live:5"]) and lk_plant[2] == [],
          "deploy prep: a live lock moved away while a third deployer makes the lock path is kept (named in a line), never removed; with the guard planted out it is removed (%r, %r)" % (lk_ok, lk_plant))
    # (2b) the put-back fails for a brand-new empty-owner lock (a third deployer takes the name): the young folder is kept at its moved name, only one past the grace is removed
    def young_kept(plant=False):
        seed()
        os.makedirs(lockdir)
        t_ = time.time() - DEPLOY_LOCK_GRACE * 60 - 600
        os.utime(lockdir, (t_, t_))
        with patch.dict(globals(), {"DEPLOY_LOCK_WAIT": 8}):
            c_ = deploy_prep_cmd("~/peer dir", [], "peer-d", "hostA:1")
        c_ = c_.replace('if mv "$LK" "$X"', 'rm -rf "$LK"; mkdir "$LK"; if mv "$LK" "$X"', 1)       # the live deployer's mkdir, its owner not yet written
        c_ = c_.replace('then o2=$(cat', 'then mkdir "$LK"; echo third:7 > "$LK/owner"; date +%s > "$LK/since"; o2=$(cat', 1)       # another deployer takes the name before the put-back
        if plant:
            c_ = c_.replace('elif [ -z "$o2" ] && [ -z "$old" ]; then', "elif false; then", 1)       # the old drop: removed
        r_ = real_run_d(["sh", "-s"], input=c_, text=True, env=dict(os.environ, HOME=dhome), capture_output=True, timeout=60)
        return r_.returncode, rd(os.path.join(lockdir, "owner")), len([x for x in os.listdir(os.path.join(dhome, ".cca")) if x.startswith("deploy.lock.stale")]), "kept at" in r_.stderr
    yk_ok = young_kept()
    for x_ in glob.glob(os.path.join(dhome, ".cca", "deploy.lock.stale*")):
        shutil.rmtree(x_, ignore_errors=True)
    yk_plant = young_kept(plant=True)
    for x_ in glob.glob(os.path.join(dhome, ".cca", "deploy.lock.stale*")):
        shutil.rmtree(x_, ignore_errors=True)
    shutil.rmtree(lockdir, ignore_errors=True)
    check(yk_ok == (75, "third:7\n", 1, True) and yk_plant[2] == 0,
          "deploy prep: a taker that cannot put back a brand-new empty-owner lock keeps it at its moved name (said) while it is younger than the grace; with the old drop it is removed (%r, %r)" % (yk_ok, yk_plant))
    # (3) a garbage since is read as empty: no arithmetic on it, the lock is taken over past the grace
    def garbage_since(plant=False):
        seed()
        os.makedirs(lockdir)
        open(os.path.join(lockdir, "owner"), "w").write("dead:1")
        open(os.path.join(lockdir, "since"), "w").write("1x2 3")
        t_ = time.time() - DEPLOY_LOCK_GRACE * 60 - 600
        os.utime(lockdir, (t_, t_))
        with patch.dict(globals(), {"DEPLOY_LOCK_WAIT": 8}):
            c_ = deploy_prep_cmd("~/peer dir", [], "peer-d", "hostA:1")
        if plant:
            c_ = c_.replace('case "$s" in ""|*[!0-9]*) s=;; esac; now=', 'now=', 1)       # no validation
        r_ = real_run_d(["sh", "-s"], input=c_, text=True, env=dict(os.environ, HOME=dhome), capture_output=True, timeout=90)
        return r_.returncode, rd(os.path.join(lockdir, "owner"))
    gs_ok, gs_plant = garbage_since(), garbage_since(plant=True)
    shutil.rmtree(lockdir, ignore_errors=True)
    check(gs_ok == (0, "hostA:1\n") and gs_plant[0] != 0 and gs_plant[1] != "hostA:1\n",
          "deploy prep: a garbage since is read as empty and the lock is taken over past the grace; with the digits check planted out the arithmetic aborts the prep (%r, %r)" % (gs_ok, gs_plant))
    # deploy_who() with no argument names the host, so two machines sharing a pid are two owners
    who_now = deploy_who()
    check(who_now == "%s:%d" % (re.sub(r"[^A-Za-z0-9_-]", "-", platform.node().split(".")[0]) or "host", os.getpid()) and ":" in who_now and who_now.split(":")[0] != "",
          "deploy_who() with no argument is host:pid, the host part the machine's name (%r)" % (who_now,))
    with patch.object(platform, "node", lambda: "mybox.local"):
        who_named = deploy_who()
    check(who_named == "mybox:%d" % os.getpid(), "deploy_who() carries the hostname up to the first dot (%r)" % (who_named,))
    # a final in a folder with .bak. in its name: the kept copy lands beside the file
    shutil.rmtree(lockdir, ignore_errors=True)
    bk_dir = os.path.join(dhome, "x.bak.y")
    os.makedirs(bk_dir, exist_ok=True)
    open(os.path.join(bk_dir, "f"), "w").write("final")
    open(os.path.join(bk_dir, "f.bak.77"), "w").write("old copy")
    real_run_d(["sh", "-s"], input=deploy_prep_cmd("~/x.bak.y", ["~/x.bak.y/f"], "peer-d", 4244), text=True, env=dict(os.environ, HOME=dhome), capture_output=True)
