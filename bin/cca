        late_metas = [dict(lane_m[0])]
        real_du = du_many

        def du_then_lane_starts(paths):     # a lane starts between the first look and the move
            late_metas.append({"id": "r2", "status": "running", "cwd": os.path.join(tmp, "lanez"), "project": "pz"})
            return real_du(paths)
        with patch.dict(globals(), {"du_many": du_then_lane_starts}):
