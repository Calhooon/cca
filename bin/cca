    # a stale lock taken over by three deployers started together: one rename wins, the others find the lock held (red when it is rm then mkdir)
    def takers(plant=False):
        seed()
        os.makedirs(lockdir)
        open(os.path.join(lockdir, "owner"), "w").write("dead:1")
        open(os.path.join(lockdir, "since"), "w").write(str(int(time.time()) - 5000))
        procs_ = []
        for k_, who_ in enumerate(("hostA:1", "hostB:2", "hostC:3")):
            with patch.dict(globals(), {"DEPLOY_LOCK_WAIT": 2}):
                c_ = deploy_prep_cmd("~/peer dir", [], "peer-d", who_)
            c_ = c_.replace("takeover() { X=", "takeover() { sleep 1; " + ('rm -rf "$LK"; return; X=' if plant else "X="), 1)       # the named function: slower, or planted back to rm then mkdir
            pr_ = subprocess.Popen(["sh", "-s"], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=dict(os.environ, HOME=dhome), text=True)
            pr_.stdin.write(c_); pr_.stdin.flush()
            procs_.append(pr_)
            time.sleep(0.3)
        rcs_ = []
        for pr_ in procs_:
            pr_.communicate(timeout=60)
            rcs_.append(pr_.returncode)
        return sorted(rcs_), rd(os.path.join(lockdir, "owner")), [x for x in os.listdir(os.path.join(dhome, ".cca")) if x.startswith("deploy.lock.stale")]
    tk_ok = takers()
    tk_plant = takers(plant=True)
    for x_ in glob.glob(os.path.join(dhome, ".cca", "deploy.lock.stale*")):
