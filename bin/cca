    hang_d = deploy(patch_cmd=lambda c: c.replace("if [ $ok = 0 ]; then", "exit 9; if [ $ok = 0 ]; then", 1), hang=True)       # every final renamed and installed, then the ssh drops
    nohang_d = deploy(patch_cmd=lambda c: c.replace("if [ $ok = 0 ]; then", "exit 9; if [ $ok = 0 ]; then", 1))                  # the same step with no undo behind it (the bug)
    unq = lambda path: ('$HOME' + shlex.quote(path[1:])) if path.startswith("~/") else shlex.quote(path)       # the unquoted HOME word
    with patch.dict(globals(), {"rq": unq}):
        unq_d = deploy()
    nochmod_d = deploy(patch_cmd=lambda c: c.replace("chmod +x", "true", 1))
    after_place = lambda c: c.replace("if [ $ok = 0 ]; then", "exit 9; if [ $ok = 0 ]; then", 1)
    NEWS = [NEW_CCA, "new rules", "new roster"]
    lost_d = deploy(hang=True)                                       # the step finished and said deployed; only the line back was lost
    none_d = deploy(hang=True, patch_cmd=lambda c: c.replace("chmod +x", "exit 9; chmod +x", 1))       # the step died before it changed anything
    first_d = deploy(hang=True, fresh=True, patch_cmd=after_place)   # a first deploy: the step created two finals, then went quiet
    slow_d = deploy(slow=3)                                          # the line gives up while the step is still installing: the undo waits for it
    busy_d = deploy(slow=6, undo_wait=1)                             # ... and refuses when the step outlasts the wait
    no_keep = {}
    exec(inspect.getsource(cmd_deploy).replace("elif u == 2:", "elif False:", 1), globals(), no_keep)       # the keep_lock branch after an undo that returns 2, planted out
    nokeep_d = deploy(slow=4, undo_wait=1, over_extra={"cmd_deploy": no_keep["cmd_deploy"]})
    csh_d = deploy(login="csh")                                      # a peer whose login shell is csh
    dcalls = []
    real_dc = deploy_call

    def rec_dc(argv, what, script=None):
        dcalls.append((what, script))
        return real_dc(argv, what, script)
    held_d = deploy(held=(999, 5), lock_wait=2, over_extra={"deploy_call": rec_dc})                      # another deploy holds the peer
