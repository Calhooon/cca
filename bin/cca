    check(wait_calls == [False, True] and wait_json and wait_json["exit"] == 0 and "waiting" in wait_err.getvalue(),
          "the wait for a lane's end is said on stderr, so --clean --path --json keeps one JSON line on stdout (%r, %r)" % (wait_out.getvalue(), wait_err.getvalue()))
    ok_rc, _, _, ok_c = peer_try(lambda argv, **k: subprocess.CompletedProcess(argv, 0, stdout="DISK_CAPS_VERSION = %d\n" % DISK_CAPS_VERSION, stderr=""))
    check(ok_rc == 0 and ok_c == ["FORWARDED"], "a peer that answers the capability line gets the request (%r, %r)" % (ok_rc, ok_c))
    check(bad_rcs == [2, 2, 2] and caps_text.strip() == DISK_CAPS,
          "an empty or missing --path is refused before any host is tried, --caps names the capability (%r)" % (bad_rcs,))
    check(run_rc[0] == PATH_EXITS["running"] and "running lane" in run_rc[1], "--clean --path refuses a running lane's target (%r)" % (run_rc,))
