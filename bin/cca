    clog = open(os.path.join(RUNS, "disk-clean.log")).read() if os.path.exists(os.path.join(RUNS, "disk-clean.log")) else ""
    check(out_rc[0] == dot_rc[0] == root_rc[0] == PATH_EXITS["outside"] and "refused (outside)" in out_rc[1], "--clean --path refuses a folder outside the targets roots, a `..`, the root itself (%r)" % ((out_rc, dot_rc, root_rc),))
    check(kept_rc[0] == PATH_EXITS["kept"] and kept_rc[1].endswith("kept carries .cca-keep") and os.path.isdir(os.path.join(ctd, "kept")), "--clean --path refuses a folder under a .cca-keep (%r)" % (kept_rc,))
    check(dotin_rc[0] == PATH_EXITS["outside"] and os.path.isdir(os.path.join(ctd, "orph")), "--clean --path refuses a `..` even where the path resolves inside the roots (%r)" % (dotin_rc,))
    check(nofolder_rc[0] == PATH_EXITS["missing"] and "not a folder" in nofolder_rc[1], "--clean --path refuses a path that is not a folder with exit 7 (%r)" % (nofolder_rc,))
    check(not os.path.exists(os.path.join(ctd, "LANEX-LANES")) or case_rc[0] == PATH_EXITS["running"],
