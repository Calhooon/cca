          "a lane whose lease is gone but whose wrapper pid lives (gate, wall retry) is running; a dead pid is not (%r, %r)" % (gate_rc, deadpid_rc))
    check(runnamed_rc[0] == PATH_EXITS["running"], "--clean --path refuses a running lane's target whose name does not end in -lanes, exit 4 (%r)" % (runnamed_rc,))
    check(capin_rc[0] == PATH_EXITS["running"] and capout_rc[0] == 0 and capdead_rc[0] == 0,
          "--clean --path refuses a path inside a live captain's <project>-lanes folder, even with --shared; with no captain, or a dead one, it is free (%r, %r, %r)" % (capin_rc, capout_rc, capdead_rc))
    check(inlanes_rc[0] == PATH_EXITS["shared"], "--clean --path refuses anything inside a <project>-lanes folder without --shared, not only the folder itself (%r)" % (inlanes_rc,))
    check(late_rc[0] == PATH_EXITS["running"] and "running lane" in late_rc[1], "--clean --path looks for a running lane again right before the move (%r)" % (late_rc,))
    check(nolsof_rc[0] == PATH_EXITS["held"], "--clean --path asks lsof +D directly, so a short union read does not let a held folder go (%r)" % (nolsof_rc,))
    caps_buf, bad_rcs = io.StringIO(), []
    with contextlib.redirect_stdout(caps_buf), contextlib.redirect_stderr(io.StringIO()):
        bad_rcs = [cmd_disk(["--clean", "--host", "no-such-host", "--path", ""]), cmd_disk(["--clean", "--path="]), cmd_disk(["--clean", "--path"])]
        cmd_disk(["--caps"])
    caps_text = caps_buf.getvalue()
    err_buf, ts_rcs, scans = io.StringIO(), [], []

    def no_scan(*a, **k):
        scans.append(1)
        raise AssertionError("the sweep ran")
    with patch.dict(globals(), {"disk_scan": no_scan}), contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(err_buf):
        ts_rcs = [cmd_disk(["--clean", "--Path", os.path.join(ctd, "orph")]), cmd_disk(["--clean", "--pth", os.path.join(ctd, "orph")]),
