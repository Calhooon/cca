    sample_update("openai-1", {"week": {"used": 99.5, "resets_at": t + 86400}}, "test")
    fails = []
    counted = [0]

    def check(cond, msg):
        counted[0] += 1
        if not cond:
            fails.append(msg)
    La, Lb = left_of(account(r, "a@x"), r), left_of(account(r, "b@x"), r)
    check(abs(La["fable_pts"] - 10) < 0.01 and abs(La["nonfable_pts"] - 50) < 0.01, "a@x: Fable 10 pts, 50 after the half (got %s, %s)" % (La["fable_pts"], La["nonfable_pts"]))
    check(abs(Lb["fable_pts"] - 45) < 0.01 and abs(Lb["nonfable_pts"] - 45) < 0.01, "b@x: Fable 45, 45 after (got %s, %s)" % (Lb["fable_pts"], Lb["nonfable_pts"]))
    p = pick(r, job_class="review")
    check(p.get("account") == "a@x" and p["model"] == OPUS, "a review lane with no named model goes to Opus on the week that expires soonest, a@x (rule 26; got %s)" % p)
    p = pick(r, job_class="review", model="fable")
    check(p.get("account") == "b@x" and p["model"] == FABLE, "a review lane named Fable goes to b@x, the most Fable per hour to its reset (got %s)" % p)
