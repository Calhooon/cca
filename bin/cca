# ----------------------------------------------------------------------------- analytics: tokens, one count per API response

USAGE_KEYS = ("input_tokens", "output_tokens", "cache_read_input_tokens", "cache_creation_input_tokens")
ANALYTICS_CACHE = os.path.join(CCA, "analytics.json")
PRETTY = {"claude-fable-5-2": "Fable 5.2", "claude-fable-5-1": "Fable 5.1", "claude-fable-5": "Fable 5", "claude-opus-5-5": "Opus 5.5", "claude-opus-4-8": "Opus 4.8",
          "claude-sonnet-5-5": "Sonnet 5.5", "claude-sonnet-5": "Sonnet 5", "claude-haiku-4-5-20251001": "Haiku 4.5"}


def pretty_model(m):
    m = (m or "unknown").replace("[1m]", "").strip()
    return PRETTY.get(m) or (m.replace("claude-", "").replace("-", " ").title() if m.startswith("claude-") else m)


def local_date(ts_iso):
    t = parse_iso(ts_iso)
    return time.strftime("%Y-%m-%d", time.localtime(t)) if t else None


def scan_transcript(path, fs):
    """Fold the bytes appended since the last scan into fs["rows"] {date: {model: [in, out, cache_read, cache_create, n]}}.
    Claude Code writes one line per content block, each repeating the response's id and usage: the first line counts."""
    try:
        size, mtime = os.path.getsize(path), os.path.getmtime(path)
    except OSError:
        return 0
    offset = fs.get("offset", 0)
    if size < offset:
        offset, fs["last_id"], fs["rows"] = 0, None, {}
    if size == offset:
        fs["size"], fs["mtime"] = size, mtime
        return 0
    rows, last_id = fs.setdefault("rows", {}), fs.get("last_id")
    with open(path, "rb") as f:
        f.seek(offset)
        buf = f.read(size - offset)
    end = buf.rfind(b"\n")
    if end < 0:
        return 0
    for raw in buf[:end].split(b"\n"):
        if b'"type":"assistant"' not in raw or b'"usage"' not in raw:
            continue
        try:
            o = json.loads(raw)
        except Exception:
            continue
        m = o.get("message") or {}
        u = m.get("usage")
        if o.get("type") != "assistant" or not isinstance(u, dict):
            continue
        mid = m.get("id") or o.get("uuid")
        if mid and mid == last_id:
            continue
        last_id = mid
        model = m.get("model") or "unknown"
        if model == "<synthetic>":
            continue
        date = local_date(o.get("timestamp"))
        if not date:
            continue
        row = rows.setdefault(date, {}).setdefault(model, [0, 0, 0, 0, 0])
        for i, k in enumerate(USAGE_KEYS):
            v = u.get(k) or 0
            if isinstance(v, (int, float)):
                row[i] += int(v)
        row[4] += 1
    fs.update(offset=offset + end + 1, last_id=last_id, size=size, mtime=mtime)
    return end + 1


def scan_codex_rollout(path, fs):
    """A Codex rollout's last token_count carries the session's cumulative usage: that total, on the rollout's date."""
    try:
        size, mtime = os.path.getsize(path), os.path.getmtime(path)
    except OSError:
        return
    if fs.get("size") == size and fs.get("mtime") == mtime:
        return
    tot, date = None, None
    try:
        with open(path, "rb") as f:
            head = f.readline()
            f.seek(0, 2)
            f.seek(max(0, f.tell() - (1 << 20)))
            for line in f.read().decode("utf-8", "replace").split("\n"):
                if '"token_count"' in line:
                    try:
                        e = json.loads(line)
                        info = ((e.get("payload") or {}).get("info") or {})
                        if info.get("total_token_usage"):
                            tot, date = info["total_token_usage"], local_date(e.get("timestamp"))
                    except Exception:
                        pass
    except Exception:
        return
    fs.update(size=size, mtime=mtime, rows={})
    if tot and date:
        inp, cached, out = int(tot.get("input_tokens") or 0), int(tot.get("cached_input_tokens") or 0), int(tot.get("output_tokens") or 0)
        fs["rows"] = {date: {"codex": [max(0, inp - cached), out, cached, 0, 1]}}


def analytics_build(budget=300 << 20, rebuild=False):
    """Bring the cache up to date, scanning at most `budget` new bytes (the rest next time). Returns the cache."""
    cache = (read_json(ANALYTICS_CACHE) or {}) if not rebuild else {}
    lock = ANALYTICS_CACHE + ".lock"
    other = read_json(lock) or {}
    if other.get("pid") and pid_alive(other["pid"]) and other["pid"] != os.getpid():
        return cache
    write_json(lock, {"pid": os.getpid(), "at": now()})
    try:
        files = cache.setdefault("files", {})
        scanned, seen = 0, set()
        for path in glob.glob(os.path.join(PRIMARY, "projects", "*", "*.jsonl")) + glob.glob(os.path.join(PRIMARY, "projects", "*", "*", "subagents", "*.jsonl")):
            key = os.path.relpath(path, os.path.join(PRIMARY, "projects"))
            seen.add(key)
            fs = files.setdefault(key, {})
            if not fs.get("sid"):
                parts = key.split(os.sep)
                fs["sid"] = parts[1] if len(parts) > 2 else os.path.basename(key)[:-6]
                fs["sub"] = "subagents" in parts
            try:
                if fs.get("size") == os.path.getsize(path) and fs.get("mtime") == os.path.getmtime(path):
                    continue
            except OSError:
                continue
            if scanned >= budget:
                cache["partial"] = True
                break
            scanned += scan_transcript(path, fs)
        else:
            cache["partial"] = False
        roster = load_roster()
        for a in roster["accounts"]:
            if a.get("provider") != "codex" or not on_host(a, this_host(roster)):
                continue
            for path in glob.glob(os.path.join(codex_home(a), "sessions", "*", "*", "*", "rollout-*.jsonl")):
                key = "codex:" + a["id"] + ":" + os.path.basename(path)
                seen.add(key)
                fs = files.setdefault(key, {"sid": None, "account": a["id"], "codex": True})
                scan_codex_rollout(path, fs)
        for key in [k for k in files if k not in seen]:
            files[key]["gone"] = True
        cache["built_at"] = now()
        write_json(ANALYTICS_CACHE, cache)
    finally:
        try:
            os.remove(lock)
        except Exception:
            pass
    return cache


def analytics_summary(cache):
    """The numbers the board and `cca analytics` show, from the cache."""
    t = now()
    by_sid = session_accounts()
    today = time.strftime("%Y-%m-%d", time.localtime(t))
    week7 = set(time.strftime("%Y-%m-%d", time.localtime(t - d * 86400)) for d in range(7))
    days, months, models, accounts, split = {}, {}, {}, {}, [0, 0, 0, 0]
    responses, sessions, fable, total, since = 0, set(), 0, 0, None
    for key, fs in (cache.get("files") or {}).items():
        acct = fs.get("account") or by_sid.get(fs.get("sid")) or "unattributed"
        for date, per_model in (fs.get("rows") or {}).items():
            for model, row in per_model.items():
                tot = row[0] + row[1] + row[2] + row[3]
                if not tot:
                    continue
                total += tot
                responses += row[4]
                sessions.add(fs.get("sid") or key)
                since = date if since is None or date < since else since
                for i in range(4):
                    split[i] += row[i]
                d = days.setdefault(date, {"date": date, "total": 0, "fable": 0})
                d["total"] += tot
                if is_fable(model):
                    d["fable"] += tot
                    fable += tot
                months[date[:7]] = months.get(date[:7], 0) + tot
                pm = ("Codex " + acct) if model == "codex" else pretty_model(model)
                models[pm] = models.get(pm, 0) + tot
                ac = accounts.setdefault(acct, {"email": acct, "week7": 0, "today": 0, "total": 0})
                ac["total"] += tot
                if date in week7:
                    ac["week7"] += tot
                if date == today:
                    ac["today"] += tot
    day_list = [days[d] for d in sorted(days)]
    return {"as_of": cache.get("built_at"), "since": since, "total": total, "responses": responses, "sessions": len(sessions),
            "split": {"input": split[0], "output": split[1], "cache_read": split[2], "cache_create": split[3]},
            "models": sorted(models.items(), key=lambda kv: -kv[1]), "fable": fable, "fable_share": (fable / total) if total else 0,
            "today": days.get(today, {}).get("total", 0), "week7": sum(d["total"] for d in day_list if d["date"] in week7),
            "days": day_list[-30:], "months": [[m, months[m], "so far" if m == today[:7] else ""] for m in sorted(months, reverse=True)],
            "accounts": sorted(accounts.values(), key=lambda a: -a["week7"]), "files": len(cache.get("files") or {}), "partial": bool(cache.get("partial"))}


def human_tokens(n):
    for unit, div in (("T", 1e12), ("B", 1e9), ("M", 1e6), ("K", 1e3)):
        if abs(n) >= div:
            return "%.1f%s" % (n / div, unit)
    return str(int(n))


def cmd_analytics(args):
    """cca analytics [--rebuild] [--json]: tokens from this machine's transcripts and Codex rollouts, one count per API response."""
    t0 = now()
    budget = None if ("--rebuild" in args or "--full" in args) else (300 << 20)
    cache = analytics_build(budget=budget if budget else (1 << 62), rebuild="--rebuild" in args)
    a = analytics_summary(cache)
    if "--json" in args:
        print(json.dumps(a, indent=1, default=str))
        return 0
    sp = a["split"]
    print("Tokens since %s (one count per API response%s): %s" % (a["since"] or "?", ", sub-agents and Codex included", human_tokens(a["total"])))
    print("  in %s · out %s · cache read %s · cache write %s" % (human_tokens(sp["input"]), human_tokens(sp["output"]), human_tokens(sp["cache_read"]), human_tokens(sp["cache_create"])))
    print("  %s responses · %d sessions · Fable %s (%d%%) · today %s · last 7 days %s" % (human_tokens(a["responses"]), a["sessions"], human_tokens(a["fable"]),
          round(100 * a["fable_share"]), human_tokens(a["today"]), human_tokens(a["week7"])))
    print("  %d transcripts · scan %.1fs%s" % (a["files"], now() - t0, " · PARTIAL: more to scan next call (or --full)" if a["partial"] else ""))
    print("\nBy model:")
    for pm, tot in a["models"][:10]:
        print("  %-18s %8s" % (pm, human_tokens(tot)))
    print("\nLast 10 days:")
    for d in a["days"][-10:]:
        print("  %s  %8s   Fable %8s" % (d["date"], human_tokens(d["total"]), human_tokens(d["fable"])))
    print("\nBy month:")
    for mo, tot, note in a["months"]:
        print("  %s  %8s   %s" % (mo, human_tokens(tot), note))
    print("\nBy account (sessions before this tool and the old registry are unattributed):")
    for ac in a["accounts"][:16]:
        print("  %-28s last 7d %8s   today %8s   all %8s" % (ac["email"], human_tokens(ac["week7"]), human_tokens(ac["today"]), human_tokens(ac["total"])))
    return 0


# ----------------------------------------------------------------------------- bills (arithmetic on what Claude Code recorded)

TIER_PRICE = {"default_claude_max_20x": 200.0, "default_claude_max_5x": 100.0, "default_claude_pro": 20.0}
TIER_NAME = {"default_claude_max_20x": "Max 20x", "default_claude_max_5x": "Max 5x", "default_claude_pro": "Pro"}


def next_monthly(day, hour, minute, t):
    import calendar
    d = datetime.datetime.fromtimestamp(t, datetime.timezone.utc)
    def at(y, m):
        return datetime.datetime(y, m, min(day, calendar.monthrange(y, m)[1]), hour, minute, tzinfo=datetime.timezone.utc)
    cand = at(d.year, d.month)
    if cand <= d:
        y, m = (d.year + 1, 1) if d.month == 12 else (d.year, d.month + 1)
        cand = at(y, m)
    return cand.timestamp()


def bill_of(a, t):
    """Next bill: the subscription's start day each month at the tier's list price; both from the profile Claude Code keeps."""
    oa = (read_json(claude_json_path(profile_dir(a))) or {}).get("oauthAccount") or {}
    tier = oa.get("userRateLimitTier") or oa.get("organizationRateLimitTier")
    start = parse_iso(oa.get("subscriptionCreatedAt"))
    nxt = None
    if start:
        d = datetime.datetime.fromtimestamp(start, datetime.timezone.utc)
        nxt = next_monthly(d.day, d.hour, d.minute, t)
    return {"next": (nxt - t) if nxt else None, "amount": TIER_PRICE.get(tier), "currency": "USD", "source": "estimate" if start else "unknown",
            "tier": TIER_NAME.get(tier, tier), "since": start}

# ----------------------------------------------------------------------------- the menu bar app's feed

def cmd_panel(args):
    """One JSON blob for the Swift app (window.CCA), in the shape app/web/panel.html reads. Fast: analytics come from the
    cache, brought up to date (within a byte budget) only when it is older than ten minutes."""
    roster = load_roster()
    t = now()
    if "--read" in args:                       # the app passes --read while the board is open: read what is older than ten minutes, never on its 12s timer alone
        refresh_stale(roster, this_host(roster), roster["settings"].get("read_age_board", 3600), t)      # the board: an hour, not a launch's ten minutes
    rows = status_rows(roster, t)
    cache = read_json(ANALYTICS_CACHE) or {}
    if t - (cache.get("built_at") or 0) > 600 or cache.get("partial"):
        cache = analytics_build(budget=150 << 20)
    an = analytics_summary(cache)
    tok = {x["email"]: x for x in an["accounts"]}
    accounts, codex, sessions_out, bills = [], [], [], 0.0
    for r in rows:
        live = r["leases"]
        if r["provider"] == "codex":
            codex.append({"provider": "codex", "email": r["id"], "home": r["id"], "host": ",".join(r["hosts"]), "stale": r["stale"], "age": r["age"], "live": len(live),
                          "scopes": [{"normal_model_slug": "", "windows": [{"name": k, "left_percent": r[k]["left"], "resets_in": r[k]["resets_in"]} for k in ("five", "week") if r.get(k)]}]})
            continue
        a = account(roster, r["id"])
        bill = bill_of(a, t)
        bills += bill["amount"] or 0
        working = sum(1 for l in live if t - (l.get("at") or 0) < 90)
        cap = r["role"][len("captain:"):] if r["role"].startswith("captain:") else None
        expiring = (r["fable_pts"] or 0) >= 10 and r["week"] and r["week"]["resets_in"] is not None and r["week"]["resets_in"] < 86400
        for l in live:
            sessions_out.append({"email": r["id"], "kind": l.get("kind"), "project": l.get("project"), "model": l.get("model"), "cwd": os.path.basename(l.get("cwd") or ""),
                                 "age": t - (l.get("at") or t), "host": l.get("host") or this_host(roster), "tag": l.get("project"), "context_pct": None})
        tk = tok.get(r["id"], {})
        accounts.append({"email": r["id"], "display_email": r["id"], "provider": "claude", "plan_ok": True, "host": ",".join(r["hosts"]), "role": r["role"],
                         "five_pct": (100 - r["five"]["left"]) if r["five"] else None, "five_reset": r["five"]["resets_in"] if r["five"] else None,
                         "week_pct": (100 - r["week"]["left"]) if r["week"] else None, "week_reset": r["week"]["resets_in"] if r["week"] else None,
                         "fable_pct": (100 - r["fable_week"]["left"]) if r["fable_week"] else None, "fable_reset": r["fable_week"]["resets_in"] if r["fable_week"] else None,
                         "fable_src": ("assumed" if r["fable_week"].get("assumed") else "reading") if r["fable_week"] else None, "fable_age": r["fable_week"]["age"] if r["fable_week"] else None,
                         "fable_rolled": bool(r["fable_week"] and r["fable_week"].get("assumed")), "week_rolled": bool(r["week"] and r["week"].get("assumed")),
                         "five_rolled": bool(r["five"] and r["five"].get("assumed")), "fable_pts": r["fable_pts"], "nonfable_pts": r["nonfable_pts"],
                         "age": r["age"], "stale": r["stale"], "source": (r["raw"] or {}).get("source"), "live": len(live), "working": working,
                         "live_remote": sum(1 for l in live if l.get("host") not in (None, this_host(roster))), "remote_hosts": sorted(set(l["host"] for l in live if l.get("host") not in (None, this_host(roster)))),
                         "holder": ", ".join(sorted(set((l.get("kind") or "") + ("@" + l["project"] if l.get("project") else "") for l in live))),
                         "login_ok": not login_dead(account(roster, r["id"]) or {}), "login_state": "missing" if login_dead(account(roster, r["id"]) or {}) else "ok", "login_good_to": None, "bill": bill, "binding": "fable" if cap else None,
                         "sessions": [x for x in sessions_out if x["email"] == r["id"]],
                         "keep": {"kind": "captain" if cap else None, "text": ("captain of " + cap) if cap else "", "lapsed": False, "room": r["fable_pts"]},
                         "loss": {"stranded": 0, "expiring": r["fable_pts"] if expiring else 0, "carried": bool(r["assumed"]), "expiring_in": r["week"]["resets_in"] if r["week"] else None, "free": True, "capable": True},
                         "expiring": bool(expiring), "reset": None, "runway": None, "scopes": [],
                         "today": tk.get("today", 0), "week7": tk.get("week7", 0), "total": tk.get("total", 0)})
    pts = [a for a in accounts if a["fable_pts"] is not None]
    wk = [a for a in accounts if a["week_pct"] is not None]
    fv = [a for a in accounts if a["five_pct"] is not None]
    resets = [a["week_reset"] for a in accounts if a.get("week_reset") is not None]
    fleet = {"logged_in": len(accounts), "kind": "pool", "source_host": this_host(roster),
             "week": {"remaining": sum(100 - a["week_pct"] for a in wk), "of": 100.0 * len(wk), "runway_hours": None},
             "fable": {"remaining": sum(a["fable_pts"] for a in pts), "of": 50.0 * len(pts)},
             "five": {"remaining": sum(100 - a["five_pct"] for a in fv), "of": 100.0 * len(fv)},
             "points": {"remaining": sum(100 - a["week_pct"] for a in wk), "of": 100.0 * len(wk), "stranded": 0},
             "loss": {"expiring": sum(a["loss"]["expiring"] or 0 for a in accounts), "expiring_unknown": 0},
             "next_reset": min(resets) if resets else None, "monthly_cost": bills, "bills": [{"email": a["email"], "next": a["bill"]["next"], "amount": a["bill"]["amount"]} for a in accounts]}
    def route(cls, model=None):
        p = pick(roster, job_class=cls, model=model, read_age=roster["settings"].get("read_age_board", 3600))
        if "account" not in p:
            return {"provider": "codex" if cls == "code" else "claude", "account": None, "home": None, "reason": p["error"][:160], "available": False}
        return {"provider": p["provider"], "account": p["account"] if p["provider"] == "claude" else None, "home": p["account"] if p["provider"] == "codex" else None,
                "model": p["model"], "reason": p["why"][:160], "available": True, "week_left": next((x["left"] for x in p["ranked"] if x["id"] == p["account"]), None),
                "floor": roster["settings"]["codex_week_floor"]}
    routes = {"fable": route("review"), "opus": route("opus"), "codex": route("code")}
    runs = []
    for p in sorted(glob.glob(os.path.join(RUNS, "*.json")), key=os.path.getmtime, reverse=True)[:20]:
        m = read_json(p) or {}
        runs.append({"id": m.get("id"), "provider": m.get("provider") or "claude", "status": m.get("status"), "state": m.get("status"), "email": m.get("account"), "home": m.get("account") if m.get("provider") == "codex" else None,
                     "host": m.get("host"), "model": m.get("model"), "task": (m.get("task") or "")[:90], "started_age": t - (m.get("started") or t), "duration": (m.get("ended") or t) - (m.get("started") or t),
                     "alive": m.get("status") == "running", "tag": m.get("class"), "effort": None, "moved": len(m.get("moves") or []), "result": (m.get("result") or "")[-120:],
                     "stalled": False, "unpushed": False, "parked_min": 0, "parked_reason": None, "thread_id": m.get("session_id")})
    captains = [c for c in (read_json(p) for p in glob.glob(os.path.join(CAPTAINS, "*.json"))) if c and c.get("project")]
    peers = [{"host": h, "ok": True, "live": 0, "no_claude": bool(x.get("no_claude")), "accounts": [a["id"].split("@")[0] for a in roster["accounts"] if on_host(a, h) and a.get("provider") == "claude"],
              "synced_age": None, "stale": False, "email": None} for h, x in roster["hosts"].items() if h != this_host(roster)]
    best = routes["opus"]
    out = {"generated_at": t, "host": this_host(roster), "accounts": accounts, "fleet": fleet, "fleet_mode": "pool", "runs": runs, "sessions": sessions_out,
           "providers": {"codex": {"accounts": codex, "reading_max_age": 3600}}, "captains": [c for c in captains if c], "peers": peers,
           "pick": {"email": best.get("account"), "reason": best.get("reason"), "viable": best.get("available")}, "picks": [], "routes": routes, "alerts": [],
           "moves": [], "parked": [], "folders": [], "analytics": an, "disks": [machine_disk(roster)] + fleet_disks(roster), "default_model": OPUS, "total": len(accounts), "live_turns": [], "code": None, "plan": None}
    print(json.dumps(out, default=str))
    return 0


# ----------------------------------------------------------------------------- main

HELP = """cca: many Claude and Codex subscriptions, one pool. RULES.md is the design.

  status [--fleet] [--json]            every account: what's left, its age, who's on it
  refresh [--host H | --all] [--account A] [--no-renew]   every login's usage page, now (the GET Claude Code and the Codex CLI make
                                       themselves: no token spent); an expired Claude access token is renewed by a one-line session
  pick --class C [--model M] [--json]  the account a launch would get, and why (read-only)
  captain [project|path|email] [--account A] [--force] [--fresh] [--dry]   the folder's Fable captain, in a loop that brings it back; --force takes over a live one
  captain list | captain stop <project>
  run --class code|review|design|proof [--worktree NAME] [--model sol|astra|opus|fable|opus48|abl] [--tier ultrafast|flex|priority] [--hazard] [--host H] "task"
                                       a lane on the best pool account, on the machine with the least load that has the
                                       project (rule 20; --host names one); prints its REPORT (run it in the background)
  runs [--project P] [--open] [--fleet] [--sweep] | --show <name|id> | --resume <name|id>   the lanes' records (they outlive the captain);
                                       a running row whose process is gone shows as lost, --sweep writes it so; --resume picks a lost lane up
  reading [--host H] [--out PATH] [--no-jscpd]   the fleet reading: crate names in two repos, vendored crates, path deps leaving a repo,
                                       the pins of the stack crates, hand-rolled primitives outside bsv-rs, lint files per repo,
                                       jscpd when installed; a page under ~/.cca/readings/; no clock (rule 22)
  disk [--clean|--dry] [--path P [--shared]] [--host H] [--json]   what the lanes left on the disk: target folders inside a checkout, lane
                                       worktrees by state, scratch older than a day, targets named for nothing; --clean removes the
                                       safe classes; --path one folder under a targets root, or a refusal: exit 3 outside, 4 a running
                                       lane's, 5 held open, 6 .cca-keep on it, above it or anywhere below it, 7 not a folder, 8 the --host peer's cca
                                       is too old for --path (probed first, nothing sent), 9 a <project>-lanes folder without --shared;
                                       --json alone only scans and is refused with --clean (rule 23)
  claude [--class C] [--model M] [--name N] [claude args]   an interactive session on the picker's account
  add <id> [--provider codex] [--host H] | login <id> [--host H] [--browser 'Profile N'] | role <id> pool|captain:<p> | project add <name> <root>
                                       a login is signed in on each machine that needs it, never copied
  analytics [--rebuild] [--json]       tokens from the transcripts and Codex rollouts, one count per API response
  install | deploy | doctor | selftest | panel
"""


def main(argv):
    cmds = {"statusline": cmd_statusline, "status": cmd_status, "pick": cmd_pick, "run": cmd_run, "runs": cmd_runs, "captain": cmd_captain,
            "hook": cmd_hook, "claude": cmd_claude, "add": cmd_add, "login": cmd_login, "role": cmd_role, "project": cmd_project,
            "install": cmd_install, "deploy": cmd_deploy, "doctor": cmd_doctor, "selftest": cmd_selftest, "panel": cmd_panel, "analytics": cmd_analytics,
            "refresh": cmd_refresh, "samples-merge": cmd_samples_merge, "reading": cmd_reading, "disk": cmd_disk}
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(HELP)
        return 0
    fn = cmds.get(argv[0])
    if not fn:
        print("cca: unknown command %s\n%s" % (argv[0], HELP), file=sys.stderr)
        return 2
    return fn(argv[1:]) or 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
