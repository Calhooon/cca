        shared_ok = pc(os.path.join(ctd, "py-lanes"), dry=True, shared=True)
        up_rc = pc(os.path.join(ctd, "UP-LANES"), dry=True)             # a shared folder spelled in capitals
        pyvar_rc = pc(os.path.join(ctd, "PY-LANES"), dry=True)          # a case variant of the shared folder (the same folder where the volume ignores case)
        keepvar_rc = pc(os.path.join(ctd, "par2"), dry=True)            # a .CCA-KEEP below the path
        longs_rc = pc(os.path.join(ctd, "py-lane\u017f"), dry=True)       # LATIN SMALL LETTER LONG S folds to s: the same folder on a case-insensitive volume
