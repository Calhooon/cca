          and os.path.isdir(os.path.join(ptr, days_[4])) and os.path.isdir(os.path.join(ptr, "notaday")) and "emptied 1 trash day-folders" in buf.getvalue(),
          "--clean under lanes_floor_gb empties the 2-day-old folders, then the oldest left until over the floor, and says so (%r)" % pg)
    cv, chm = os.path.join(tmp, "cvol"), os.path.join(tmp, "chome")     # cca disk --clean --path: the refusals, the dry run, the move
