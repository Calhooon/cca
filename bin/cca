    calls, fake_roster = [], {"hosts": {"peer-x": {"ssh": "peer-x"}, "me": {}}, "settings": {"peer_cca": "cca"}}

    def fake_run(argv, **k):       # the probe: an old peer answers --caps with the scan page, a new one with the capability line
        calls.append(argv[-1])
        return subprocess.CompletedProcess(argv, 0, stdout="the disk page\n", stderr="")
    with patch.dict(globals(), {"load_roster": lambda: fake_roster, "this_host": lambda r=None: "me"}), patch.object(subprocess, "run", fake_run), \
            patch.object(subprocess, "call", lambda *a, **k: calls.append("FORWARDED") or 0), contextlib.redirect_stderr(io.StringIO()):
        peer_old = cmd_disk(["--clean", "--host", "peer-x", "--path", "/x/targets/a"])
    check(peer_old == PATH_EXITS["peer"] and "FORWARDED" not in calls, "--clean --path to a peer whose cca does not answer --caps is refused with exit 8 and nothing is forwarded (%r, %r)" % (peer_old, calls))

    def peer_try(fake, extra=()):
        errb, outb, c2 = io.StringIO(), io.StringIO(), []
        with patch.dict(globals(), {"load_roster": lambda: fake_roster, "this_host": lambda r=None: "me"}), patch.object(subprocess, "run", fake), \
                patch.object(subprocess, "call", lambda *a, **k: c2.append("FORWARDED") or 0), contextlib.redirect_stderr(errb), contextlib.redirect_stdout(outb):
            rc = cmd_disk(["--clean", "--host", "peer-x", "--path", "/x/targets/a"] + list(extra))
        return rc, errb.getvalue(), outb.getvalue(), c2

    def hang(argv, **k):
        assert k.get("timeout"), "the probe has no timeout"
        raise subprocess.TimeoutExpired(argv, k["timeout"])
    to_rc, to_err, _, to_c = peer_try(hang)
    check(to_rc == PATH_EXITS["peer"] and "timeout" in to_err and not to_c, "a peer that hangs on --caps is refused with exit 8, saying timeout, nothing forwarded (%r, %r)" % (to_rc, to_err))
    un_rc, un_err, _, un_c = peer_try(lambda argv, **k: subprocess.CompletedProcess(argv, 255, stdout="", stderr="no route"))
    check(un_rc == PATH_EXITS["peer"] and "unreachable" in un_err and not un_c, "an unreachable peer is refused with exit 8, saying unreachable (%r, %r)" % (un_rc, un_err))
    gb_rc, gb_err, _, gb_c = peer_try(lambda argv, **k: subprocess.CompletedProcess(argv, 0, stdout="\x00garbage", stderr=""))
    check(gb_rc == PATH_EXITS["peer"] and "no caps line" in gb_err and not gb_c, "a peer that answers garbage is refused with exit 8, saying no caps line (%r, %r)" % (gb_rc, gb_err))
    pj_rc, _, pj_out, _ = peer_try(hang, ["--json"])
    try:
        pj = json.loads(pj_out)
    except ValueError:
        pj = {}
    check(pj_rc == PATH_EXITS["peer"] and pj.get("exit") == PATH_EXITS["peer"] and sorted(pj) == ["exit", "host", "line", "path"], "a peer refusal under --json prints the same JSON object (%r)" % (pj_out,))
    v1_rc, v1_err, _, v1_c = peer_try(lambda argv, **k: subprocess.CompletedProcess(argv, 0, stdout="DISK_CAPS_VERSION = 1\n", stderr=""))
    v3_rc, _, _, v3_c = peer_try(lambda argv, **k: subprocess.CompletedProcess(argv, 0, stdout="DISK_CAPS_VERSION = %d\n" % (DISK_CAPS_VERSION + 1), stderr=""))
    check(v1_rc == PATH_EXITS["peer"] and "caps version 1" in v1_err and not v1_c and v3_rc == 0 and v3_c == ["FORWARDED"],
          "a peer whose caps number is lower than this cca's is refused by number, a higher one is sent the request (%r, %r, %r)" % (v1_rc, v1_err, v3_rc))
    rel_roster = {"hosts": {"peer-x": {"ssh": "peer-x"}, "me": {}}, "settings": {"peer_cca": "~/peer dir/bin/cca"}}
    rel_argv = []
    with patch.dict(globals(), {"load_roster": lambda: rel_roster, "this_host": lambda r=None: "me"}), \
            patch.object(subprocess, "run", lambda argv, **k: rel_argv.append(argv) or subprocess.CompletedProcess(argv, 0, stdout="DISK_CAPS_VERSION = %d\n" % DISK_CAPS_VERSION, stderr="")), \
            patch.object(subprocess, "call", lambda argv, **k: rel_argv.append(argv) or rel_argv.append(k) or 0), contextlib.redirect_stderr(io.StringIO()):
        cmd_disk(["--clean", "--host", "peer-x", "--path", "/x/targets/a"])
    rel_cmds = [a[-1] for a in rel_argv if isinstance(a, list)]
    check(len(rel_cmds) == 2 and all('"$HOME"' in c and expand("~") + "/" not in c for c in rel_cmds) and all("ServerAliveInterval=5" in " ".join(a) for a in rel_argv if isinstance(a, list))
          and any(isinstance(a, dict) and a.get("timeout") == DISK_RELAY_TIMEOUT for a in rel_argv),
          "the relay names the peer's cca by the peer's own HOME (not this Mac's), its ssh carries ServerAliveInterval, and the forwarded call has a timeout (%r)" % (rel_cmds,))
    seen_from, wait_calls = [], []
    with patch.dict(globals(), {"load_roster": lambda: fake_roster, "this_host": lambda r=None: "me",
                                "path_clean": lambda q, **k: seen_from.append(k.get("caller")) or (0, "would move")}), contextlib.redirect_stdout(io.StringIO()):
        cmd_disk(["--dry", "--path", "/x", "--from", "peer-x"]); cmd_disk(["--dry", "--path", "/x", "--from", "evil"]); cmd_disk(["--dry", "--path", "/x"])
    check(seen_from == ["peer-x", "me", "me"], "--from names the caller only when it is a roster host (%r)" % (seen_from,))
    wait_out, wait_err = io.StringIO(), io.StringIO()
    with patch.dict(globals(), {"load_roster": lambda: fake_roster, "this_host": lambda r=None: "me", "path_clean": lambda q, **k: k["lock_fn"]() and (0, "moved"),
                                "sweep_lock": lambda wait=False: wait_calls.append(wait) or (wait or None)}), contextlib.redirect_stdout(wait_out), contextlib.redirect_stderr(wait_err):
        cmd_disk(["--clean", "--path", "/x", "--json"])
    try:
        wait_json = json.loads(wait_out.getvalue())
    except ValueError:
