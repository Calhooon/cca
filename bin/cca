    exec(inspect.getsource(cmd_deploy).replace("rc in (1, 75)", "False", 1), globals(), no_refuse)       # the refused prep's skipped release, planted out
    del dcalls[:]
    deploy(held=(999, 5), lock_wait=2, over_extra={"deploy_call": rec_dc, "cmd_deploy": no_refuse["cmd_deploy"]})
