    open(os.path.join(bk_dir, "f.bak.77"), "w").write("old copy")
    shutil.rmtree(lockdir, ignore_errors=True)
    c_ = deploy_prep_cmd("~/x.bak.y", ["~/x.bak.y/f"], "peer-d", 4245).replace('k0=%s.kept.' % rq("~/x.bak.y/f"), 'k0="${b%%.bak.*}".kept.', 1)       # the kept name built from the backup's own path, cut at the first .bak.
