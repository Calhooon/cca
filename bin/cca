    for d in ("realx/debug", "mvfail/debug", "xdev/debug"):
        os.makedirs(os.path.join(ctd, d)); open(os.path.join(ctd, d, "f"), "w").write("x")
    os.symlink("realx", os.path.join(ctd, "aaa-alias"))
    rctd = os.path.realpath(ctd)
    check(on_disk(os.path.join(rctd, "realx"), rctd) == os.path.join(rctd, "realx") and path_clean(os.path.join(ctd, "aaa-alias"), dry=True, volume=cv, home=chm, metas=[])[1].endswith(os.path.join(rctd, "realx")),
          "a symlink beside the real folder is never taken as its name on disk (lstat identity)")

    def mv_boom(p, trash, day=None):
        raise OSError(16, "Resource busy")
    with patch.dict(globals(), {"quarantine": mv_boom}):
        mvf = path_clean(os.path.join(ctd, "mvfail"), volume=cv, home=chm, metas=[])
    clog2 = open(os.path.join(RUNS, "disk-clean.log")).read()
    check(mvf[0] == PATH_EXITS["move"] and "refused (move)" in mvf[1] and os.path.isdir(os.path.join(ctd, "mvfail")) and "REFUSED move" in clog2,
          "a move that fails with an OSError is a named refusal (exit 10), logged, never a traceback (%r)" % (mvf,))
