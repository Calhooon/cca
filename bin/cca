    # deploy: all or nothing on a peer (ssh and scp played by local sh and cp in a scratch home; the destination holds a space)
    dep = os.path.join(tmp, "deploy")
    dhome, ddest = os.path.join(dep, "home dir"), os.path.join(dep, "home dir", "peer dir")       # the peer's HOME holds a space too
    dsrc = os.path.join(dep, "src")
