    check("only when the owner says so" in captain_opening("p", tmp, "", ""), "the captain is told an account is named only on the owner's word")
    check(captain_cmd("m", "p", "xhigh")[-2:] == ["--effort", "xhigh"] and "captain-p" in captain_cmd("m", "p", "xhigh") and DEFAULT_SETTINGS["captain_effort"] == "xhigh",
          "a captain launches named and at the owner's effort, xhigh by default")
    import contextlib, io
