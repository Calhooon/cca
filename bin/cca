        write_json(cap_f, {"project": "cap", "owner_pid": os.getpid(), "root": os.path.join(tmp, "caproot")})        # a captain whose window lives
        capin_rc = pc(os.path.join(ctd, "cap-lanes", "a"), dry=True, shared=True)       # inside its project's lanes folder, even with --shared
